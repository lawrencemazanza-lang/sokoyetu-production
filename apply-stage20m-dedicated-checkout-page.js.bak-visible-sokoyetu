const fs = require("fs");
const path = require("path");

const root = process.cwd();
const appPath = path.join(root, "app.js");
const checkoutPath = path.join(root, "checkout.html");

if (!fs.existsSync(appPath)) {
  console.error("ERROR: app.js was not found. Run this inside your SokoYetu project folder.");
  process.exit(1);
}

let app = fs.readFileSync(appPath, "utf8");

if (!fs.existsSync(checkoutPath) || !fs.readFileSync(checkoutPath, "utf8").includes("SokoYetu Stage 20M Dedicated Checkout")) {
  fs.writeFileSync(checkoutPath, `<!doctype html>

<body>
  <!-- SokoYetu Stage 20M Dedicated Checkout -->
  <header>
    <div class="wrap">
      <h1>SokoYetu Secure Checkout</h1>
      <p>Green M-PESA checkout · Real Daraja STK Push · Verified order creation</p>
    </div>
  </header>

  <main>
    <a class="back" href="/">← Back to shop</a>

    <section class="card">
      <div class="card-head">Your cart</div>
      <div class="card-body" id="cartBody">
        <div class="empty">Loading cart...</div>
      </div>
    </section>

    <section class="card">
      <div class="card-head">M-PESA payment details</div>
      <div class="card-body">
        <form id="checkoutForm">
          <label for="phone">M-PESA phone number</label>
          <input id="phone" name="phone" placeholder="0714565555 or 254714565555" autocomplete="tel" required />

          <label for="deliveryAddress">Delivery address</label>
          <textarea id="deliveryAddress" name="deliveryAddress" placeholder="Example: Nairobi CBD, Moi Avenue, building name" required></textarea>

          <button id="payBtn" type="submit">Send M-PESA STK Push</button>
          <div id="message"></div>
        </form>
      </div>
    </section>
  </main>

  <script>
    const cartBody = document.getElementById("cartBody");
    const form = document.getElementById("checkoutForm");
    const message = document.getElementById("message");
    const payBtn = document.getElementById("payBtn");

    let latestCart = [];

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function money(value) {
      return "KES " + Number(value || 0).toLocaleString("en-KE");
    }

    function productOf(item) {
      return item.product || item.Product || item;
    }

    function quantityOf(item) {
      return Number(item.quantity || item.qty || item.count || 1) || 1;
    }

    function normalizeCart(data) {
      const raw =
        (Array.isArray(data) && data) ||
        data.cart ||
        data.items ||
        data.cartItems ||
        data.data ||
        [];

      if (!Array.isArray(raw)) return [];

      return raw.map((item) => {
        const product = productOf(item);
        const productId = Number(item.productId || product.id || item.id);
        const quantity = quantityOf(item);
        const price = Number(product.price || item.price || 0);

        return {
          productId,
          name: product.name || item.name || "Product",
          price,
          quantity,
          imageUrl: product.imageUrl || item.imageUrl || "",
          category: product.category || item.category || ""
        };
      }).filter((item) => item.productId > 0);
    }

    function cartTotal(items) {
      return items.reduce((sum, item) => sum + Number(item.price || 0) * Number(item.quantity || 1), 0);
    }

    async function fetchJson(url, options = {}) {
      const response = await fetch(url, {
        credentials: "include",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          ...(options.headers || {})
        },
        ...options
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.message || "Request failed.");
      }

      return data;
    }

    async function loadCart() {
      cartBody.innerHTML = "<div class='empty'>Loading cart...</div>";

      try {
        const data = await fetchJson("/api/cart");
        latestCart = normalizeCart(data);

        if (!latestCart.length) {
          cartBody.innerHTML = "<div class='empty'>Your cart is empty. Go back to the shop and add a product first.</div>";
          payBtn.disabled = true;
          return;
        }

        payBtn.disabled = false;
        const rows = latestCart.map((item) => {
          const img = item.imageUrl
            ? "<img src='" + escapeHtml(item.imageUrl) + "' alt=''>"
            : "<img alt=''>";

          return (
            "<article class='row'>" +
              img +
              "<div>" +
                "<div class='title'>" + escapeHtml(item.name) + "</div>" +
                "<div class='meta'>Quantity: " + item.quantity + " · Product ID: " + item.productId + "</div>" +
              "</div>" +
              "<div class='price'>" + money(item.price * item.quantity) + "</div>" +
            "</article>"
          );
        }).join("");

        const total = cartTotal(latestCart);

        cartBody.innerHTML =
          rows +
          "<div class='summary'>" +
            "<div class='line'><span>Subtotal</span><b>" + money(total) + "</b></div>" +
            "<div class='line'><span>Delivery</span><b>" + (total >= 10000 ? "Free" : "To be confirmed") + "</b></div>" +
            "<div class='line'><span>Total</span><b>" + money(total) + "</b></div>" +
          "</div>";
      } catch (error) {
        cartBody.innerHTML = "<div class='msg err'>" + escapeHtml(error.message || "Could not load cart.") + "</div>";
        payBtn.disabled = true;
      }
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const phone = document.getElementById("phone").value.trim();
      const deliveryAddress = document.getElementById("deliveryAddress").value.trim();

      if (!phone) {
        message.innerHTML = "<div class='msg err'>M-PESA phone number is required.</div>";
        return;
      }

      if (!deliveryAddress) {
        message.innerHTML = "<div class='msg err'>Delivery address is required.</div>";
        return;
      }

      if (!latestCart.length) {
        message.innerHTML = "<div class='msg err'>Your cart is empty. Add a product first.</div>";
        return;
      }

      try {
        payBtn.disabled = true;
        message.innerHTML = "<div class='msg ok'>Creating order and sending M-PESA STK Push...</div>";

        const orderData = await fetchJson("/api/orders", {
          method: "POST",
          body: JSON.stringify({ phone, deliveryAddress })
        });

        const order = orderData.order || orderData;
        const orderId = order.id;

        if (!orderId) {
          throw new Error("Order was created but no order ID was returned.");
        }

        const stkData = await fetchJson("/api/payments/mpesa/stk-push", {
          method: "POST",
          body: JSON.stringify({ orderId, phone })
        });

        message.innerHTML =
          "<div class='msg ok'>" +
            "<b>M-PESA STK Push sent.</b><br>" +
            "Check the customer phone, enter the M-PESA PIN, then wait for payment confirmation." +
            (stkData.checkoutRequestId ? "<br><small>Checkout Request ID: " + escapeHtml(stkData.checkoutRequestId) + "</small>" : "") +
          "</div>";
      } catch (error) {
        message.innerHTML =
          "<div class='msg err'><b>Checkout could not continue.</b><br>" +
          escapeHtml(error.message || "Please check Daraja settings and try again.") +
          "</div>";
      } finally {
        payBtn.disabled = false;
      }
    });

    loadCart();
  </script>
</body>
</html>`, "utf8");
  console.log("Created checkout.html.");
} else {
  console.log("checkout.html already exists.");
}

if (!app.includes("SokoYetu Stage 20M Dedicated Checkout Launcher")) {
  const backupPath = appPath + ".backup-stage20m-dedicated-checkout-launcher-" + Date.now();
  fs.copyFileSync(appPath, backupPath);

  app += `

// ================================
// SokoYetu Stage 20M Dedicated Checkout Launcher
// Routes customer cart/checkout actions to checkout.html, bypassing old modal conflicts.
// ================================
(function initStage20MDedicatedCheckoutLauncher() {
  if (window.__sokoyetuStage20MCheckoutLauncherInstalled) return;
  window.__sokoyetuStage20MCheckoutLauncherInstalled = true;

  function ensureCheckoutLauncher() {
    if (document.getElementById("syDedicatedCheckoutLauncher")) return;

    var style = document.createElement("style");
    style.id = "syDedicatedCheckoutLauncherStyle";
    style.textContent =
      "#syDedicatedCheckoutLauncher{position:fixed;right:18px;bottom:22px;z-index:17000;border:none;border-radius:999px;background:linear-gradient(135deg,#16a34a,#064e3b);color:#fff;font-weight:900;padding:13px 17px;box-shadow:0 18px 45px rgba(15,23,42,.28);cursor:pointer}" +
      "@media(max-width:720px){#syDedicatedCheckoutLauncher{right:10px;bottom:14px;padding:11px 13px;font-size:13px}}";
    document.head.appendChild(style);

    var button = document.createElement("button");
    button.id = "syDedicatedCheckoutLauncher";
    button.type = "button";
    button.textContent = "✅ Secure Checkout";
    button.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();
      window.location.href = "/checkout.html";
    });
    document.body.appendChild(button);
  }

  function isCheckoutNavigation(element) {
    if (!element) return false;

    var text = String(element.textContent || "").toLowerCase();
    var id = String(element.id || "").toLowerCase();
    var className = String(element.className || "").toLowerCase();

    if (text.includes("add to cart")) return false;
    if (id === "syDirectMpesaPayBtn" || id === "syRefreshCartBtn") return false;

    return (
      id === "syCustomerCartLauncher" ||
      text.includes("cart / checkout") ||
      text === "cart" ||
      text.includes("view cart") ||
      text.includes("checkout") ||
      className.includes("checkout")
    );
  }

  document.addEventListener("click", function (event) {
    var clicked = event.target && event.target.closest ? event.target.closest("button, a, [role='button']") : null;
    if (!clicked || !isCheckoutNavigation(clicked)) return;

    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();
    window.location.href = "/checkout.html";
  }, true);

  document.addEventListener("DOMContentLoaded", ensureCheckoutLauncher);
  if (document.readyState !== "loading") ensureCheckoutLauncher();
})();
`;
  fs.writeFileSync(appPath, app, "utf8");
  console.log("Added dedicated checkout launcher to app.js.");
} else {
  console.log("Dedicated checkout launcher already exists in app.js.");
}


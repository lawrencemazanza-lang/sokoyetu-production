<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Mtaani Buyer Journey Smoke Test</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#111827,#16a34a);color:white;padding:24px}
    header div,main{width:min(1180px,94vw);margin:0 auto}
    main{display:grid;gap:16px;padding:20px 0 36px}
    h1{margin:0;font-size:28px} header p{color:#dcfce7}
    .card{background:white;border:1px solid #e5e7eb;border-radius:20px;box-shadow:0 14px 34px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:14px 16px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:16px;display:grid;gap:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
    label{font-weight:900;color:#064e3b}
    input,select,textarea{width:100%;border:1px solid #bbf7d0;border-radius:14px;padding:11px;font:inherit}
    textarea{min-height:88px}
    button,.linkbtn{border:0;border-radius:14px;background:#16a34a;color:white;padding:11px 14px;font-weight:900;text-decoration:none;cursor:pointer;width:fit-content}
    .secondary{background:#111827}.danger{background:#991b1b}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px}
    .warn{background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:16px;padding:12px}
    .bad{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px}
    .ok{background:#ecfdf5;border:1px solid #86efac;color:#047857;border-radius:16px;padding:12px}
    .metric{border:1px solid #e5e7eb;border-radius:16px;padding:14px;background:#f8fafc}.metric b{display:block;font-size:22px;color:#064e3b}
    table{width:100%;border-collapse:collapse;font-size:13px}th,td{border-bottom:1px solid #e5e7eb;padding:8px;text-align:left;vertical-align:top}th{background:#f1f5f9}
    .pill{display:inline-flex;border-radius:999px;padding:4px 8px;font-size:12px;font-weight:900;background:#dcfce7;color:#166534}.pill.bad{background:#fee2e2;color:#991b1b}.pill.warn{background:#fef3c7;color:#92400e}
    .checkitem{border:1px solid #e5e7eb;background:#f8fafc;border-radius:14px;padding:10px;display:flex;gap:10px}.checkitem input{width:auto}
  </style>
  <link rel="stylesheet" href="/sokoyetu-final-brand.css">
</head>
<body>
<header><div><h1>SokoYetu Mtaani Buyer Journey Smoke Test</h1><p>Controlled test for homepage, categories, product detail, cart, checkout, tracking, admin order visibility and payment-status review.</p></div></header>
<main>
  <div class="actions">
    <a class="linkbtn" href="/admin-control.html">Back to admin control</a>
    <a class="linkbtn secondary" href="/">Homepage</a>
    <a class="linkbtn secondary" href="/categories.html">Categories</a>
    <a class="linkbtn secondary" href="/checkout.html">Checkout</a>
    <a class="linkbtn secondary" href="/track-order.html">Track order</a>
    <a class="linkbtn secondary" href="/admin-orders.html">Admin orders</a>
  </div>

  <section class="card"><div class="head">Read-only checks</div><div class="body">
    <div><label>Admin order token</label><input id="token" type="password" placeholder="Paste ADMIN_ORDER_TOKEN"></div>
    <div class="actions"><button onclick="runApi()">Run API smoke check</button><button class="secondary" onclick="runBrowser()">Run browser page checks</button></div>
    <div class="warn">This page does not automatically create orders or trigger M-PESA. The final order test is manual.</div>
    <div id="message"></div>
  </div></section>

  <section class="card" id="summaryCard" style="display:none"><div class="head">Summary</div><div class="body"><div id="decision"></div><div id="summary" class="grid"></div></div></section>
  <section class="card" id="detailsCard" style="display:none"><div class="head">Details</div><div class="body" id="details"></div></section>

  <section class="card"><div class="head">Manual buyer journey checklist</div><div class="body">
    <div id="checklist"></div>
    <div class="actions"><button onclick="saveChecklist()">Save checklist</button><button class="danger" onclick="clearChecklist()">Clear checklist</button></div>
    <div id="checkMsg"></div>
  </div></section>

  <section class="card"><div class="head">Manual test log</div><div class="body">
    <div class="grid">
      <div><label>Tester</label><input id="tester"></div>
      <div><label>Result</label><select id="result"><option>pass</option><option>review</option><option>fail</option></select></div>
      <div><label>Order ID</label><input id="orderId"></div>
      <div><label>Checkout phone</label><input id="phone"></div>
      <div><label>Product ID</label><input id="productId"></div>
      <div><label>Payment status</label><input id="paymentStatus"></div>
    </div>
    <label>Notes</label><textarea id="notes"></textarea>
    <div class="actions"><button onclick="addLog()">Add log</button><button class="secondary" onclick="exportLogs('csv')">Export CSV</button><button class="secondary" onclick="exportLogs('json')">Export JSON</button><button class="danger" onclick="clearLogs()">Clear logs</button></div>
    <div id="logMsg"></div>
  </div></section>

  <section class="card"><div class="head">Saved logs</div><div class="body"><div id="logSummary" class="grid"></div><table><thead><tr><th>Date</th><th>Tester</th><th>Result</th><th>Order</th><th>Phone</th><th>Product</th><th>Payment</th><th>Notes</th></tr></thead><tbody id="logs"></tbody></table></div></section>
</main>

<script>
const CHECK_KEY = "sokoyetu_stage35c_checks";
const LOG_KEY = "sokoyetu_stage35c_logs";
const checklistItems = [
  "Homepage opens.",
  "Categories page opens.",
  "Products load on categories page.",
  "Product detail opens from a product card.",
  "Product can be added to cart.",
  "Cart total looks correct.",
  "Checkout opens.",
  "Checkout accepts controlled test details.",
  "Order can be submitted through normal buyer flow.",
  "Order ID is recorded.",
  "Track Order finds the order.",
  "Admin Orders shows the order.",
  "Payment status is visible and consistent.",
  "M-PESA sandbox/live behaviour matches current mode.",
  "Evidence or screenshots are saved if issue appears."
];

function esc(v){return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[m]));}
function pill(kind,text){return '<span class="pill '+(kind||"")+'">'+esc(text)+'</span>';}
function msg(html){document.getElementById("message").innerHTML=html;}
function table(headers,rows){return '<table><thead><tr>'+headers.map(h=>'<th>'+esc(h)+'</th>').join("")+'</tr></thead><tbody>'+rows.map(r=>'<tr>'+r.map(c=>'<td>'+c+'</td>').join("")+'</tr>').join("")+'</tbody></table>';}
async function runApi(){
  const token=document.getElementById("token").value.trim();
  if(!token){msg('<div class="bad">Admin token is required.</div>');return;}
  msg('<div class="note">Running smoke check...</div>');
  try{
    const res=await fetch("/api/admin/buyer-journey-smoke",{headers:{"x-admin-order-token":token},cache:"no-store"});
    const data=await res.json();
    if(!res.ok)throw new Error(data.message||"Smoke check failed.");
    renderApi(data);
    msg('<div class="ok">Smoke check completed.</div>');
  }catch(e){msg('<div class="bad">'+esc(e.message)+'</div>');}
}
function renderApi(data){
  const blockers=data.blockers||[], warnings=data.warnings||[], files=data.fileChecks||[], routes=data.routeChecks||[], counts=data.counts||[];
  document.getElementById("decision").innerHTML=blockers.length?'<div class="bad"><b>Decision: HOLD</b></div>':warnings.length?'<div class="warn"><b>Decision: REVIEW</b></div>':'<div class="ok"><b>Decision: READY FOR CONTROLLED MANUAL BUYER TEST</b></div>';
  const prod=(counts.find(c=>c.model==="product")||{}).count ?? "-";
  document.getElementById("summary").innerHTML='<div class="metric">Blockers<b>'+blockers.length+'</b></div><div class="metric">Warnings<b>'+warnings.length+'</b></div><div class="metric">Products<b>'+esc(prod)+'</b></div><div class="metric">Sample product<b>'+(data.sampleProduct?("#"+esc(data.sampleProduct.id)):"-")+'</b></div>';
  const sample=data.sampleProduct?'<div class="note">Sample product: #'+esc(data.sampleProduct.id)+' '+esc(data.sampleProduct.name||data.sampleProduct.title||"")+'<br><a target="_blank" href="/product-detail.html?id='+esc(data.sampleProduct.id)+'">Open sample product</a></div>':'<div class="warn">No sample product returned.</div>';
  document.getElementById("details").innerHTML=sample+
    '<h3>Blockers</h3><div>'+(blockers.length?blockers.map(esc).join("<br>"):"None")+'</div>'+
    '<h3>Warnings</h3><div>'+(warnings.length?warnings.map(esc).join("<br>"):"None")+'</div>'+
    '<h3>Files</h3>'+table(["File","Status","Note"],files.map(f=>[esc(f.file),f.exists?pill("", "EXISTS"):pill(f.critical?"bad":"warn","MISSING"),esc(f.note||"")]))+
    '<h3>Routes</h3>'+table(["Pattern","Status","Note"],routes.map(r=>[esc(r.pattern),r.found?pill("","FOUND"):pill(r.critical?"bad":"warn","MISSING"),esc(r.note||"")]))+
    '<h3>Counts</h3>'+table(["Model","Status","Count"],counts.map(c=>[esc(c.model),c.available?pill("","AVAILABLE"):pill("warn","NOT FOUND"),esc(c.count??"-")]));
  document.getElementById("summaryCard").style.display="block";document.getElementById("detailsCard").style.display="block";
}
async function runBrowser(){
  const checks=[["Homepage","/"],["Categories","/categories.html"],["Checkout","/checkout.html"],["Track order","/track-order.html"],["Products API","/api/products"],["Health API","/api/health"]];
  const rows=[];
  for(const [name,url] of checks){
    try{const r=await fetch(url,{cache:"no-store"});rows.push([esc(name),'<a target="_blank" href="'+esc(url)+'">'+esc(url)+'</a>',r.ok?pill("","OK"):pill("bad","FAIL"),"HTTP "+r.status]);}
    catch(e){rows.push([esc(name),esc(url),pill("bad","FAIL"),esc(e.message)]);}
  }
  document.getElementById("decision").innerHTML='<div class="note">Browser checks completed.</div>';
  document.getElementById("summary").innerHTML='<div class="metric">Checks<b>'+rows.length+'</b></div>';
  document.getElementById("details").innerHTML=table(["Area","URL","Status","Note"],rows);
  document.getElementById("summaryCard").style.display="block";document.getElementById("detailsCard").style.display="block";
}
function getChecks(){try{return JSON.parse(localStorage.getItem(CHECK_KEY)||"{}")}catch{return {}}}
function renderChecklist(){const c=getChecks();document.getElementById("checklist").innerHTML=checklistItems.map((t,i)=>'<label class="checkitem"><input type="checkbox" id="c'+i+'" '+(c[i]?"checked":"")+'> <span>'+esc(t)+'</span></label>').join("");}
function saveChecklist(){const c={};checklistItems.forEach((_,i)=>c[i]=document.getElementById("c"+i).checked);localStorage.setItem(CHECK_KEY,JSON.stringify(c));document.getElementById("checkMsg").innerHTML='<div class="ok">Checklist saved.</div>';}
function clearChecklist(){localStorage.removeItem(CHECK_KEY);renderChecklist();}
function getLogs(){try{return JSON.parse(localStorage.getItem(LOG_KEY)||"[]")}catch{return []}}
function saveLogs(l){localStorage.setItem(LOG_KEY,JSON.stringify(l))}
function addLog(){const logs=getLogs();const row={createdAt:new Date().toISOString(),tester:tester.value.trim(),result:result.value,orderId:orderId.value.trim(),phone:phone.value.trim(),productId:productId.value.trim(),paymentStatus:paymentStatus.value.trim(),notes:notes.value.trim()};if(!row.tester||!row.notes){logMsg.innerHTML='<div class="bad">Tester and notes are required.</div>';return;}logs.unshift(row);saveLogs(logs);renderLogs();logMsg.innerHTML='<div class="ok">Log saved.</div>';}
function renderLogs(){const logs=getLogs();logSummary.innerHTML='<div class="metric">Logs<b>'+logs.length+'</b></div>';document.getElementById("logs").innerHTML=logs.length?logs.map(l=>'<tr><td>'+esc(new Date(l.createdAt).toLocaleString())+'</td><td>'+esc(l.tester)+'</td><td>'+esc(l.result)+'</td><td>'+esc(l.orderId||"-")+'</td><td>'+esc(l.phone||"-")+'</td><td>'+esc(l.productId||"-")+'</td><td>'+esc(l.paymentStatus||"-")+'</td><td>'+esc(l.notes||"-")+'</td></tr>').join(""):'<tr><td colspan="8">No logs saved.</td></tr>';}
function exportLogs(format){const logs=getLogs();if(!logs.length)return;let data, type, filename;if(format==="json"){data=JSON.stringify({generatedAt:new Date().toISOString(),logs},null,2);type="application/json";filename="sokoyetu-stage35c-smoke-log.json";}else{const h=Object.keys(logs[0]);data=h.join(",")+"\n"+logs.map(r=>h.map(k=>String(r[k]??"").replace(/"/g,'""')).join(",")).join("\n");type="text/csv";filename="sokoyetu-stage35c-smoke-log.csv";}const blob=new Blob([data],{type});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=filename;a.click();}
function clearLogs(){localStorage.removeItem(LOG_KEY);renderLogs();}
renderChecklist();renderLogs();
</script>
  <script src="/sokoyetu-final-seo.js" defer></script>
</body>
</html>





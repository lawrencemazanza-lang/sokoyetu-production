function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
function pillClass(status){
  const s = String(status || "").toUpperCase();
  if (s.includes("FAILED") || s.includes("CANCELLED") || s.includes("REJECT")) return "pill bad";
  if (s.includes("REFUND") || s.includes("REQUEST") || s.includes("PENDING")) return "pill warn";
  return "pill";
}
async function api(url, options={}){
  const response = await fetch(url, {
    credentials: "include",
    headers: {"Content-Type":"application/json","x-admin-order-token": token(), ...(options.headers || {})},
    ...options
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.message || "Request failed.");
  return data;
}
function buildUrl(){
  const params = new URLSearchParams();
  const filter = document.getElementById("filter").value;
  const q = document.getElementById("searchBox").value.trim();
  if (filter) params.set("filter", filter);
  if (q) params.set("q", q);
  return "/api/admin/support-queue" + (params.toString() ? "?" + params.toString() : "");

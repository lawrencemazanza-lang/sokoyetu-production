console.log("Created robots.txt and sitemap.xml starter files.");

// 4. Add safe meta tags to index.html if available.
if (fs.existsSync(indexPath)) {
  backup(indexPath, "index");
  let index = fs.readFileSync(indexPath, "utf8");
  let changed = false;

  if (!index.includes('name="description"')) {
    index = index.replace(
      /<head[^>]*>/i,
      (match) => `${match}
  <meta name="description" content="SokoYetu is a Kenyan e-commerce marketplace for products, sellers, live shopping and M-PESA checkout.">`
    );
    changed = true;
  }

  if (!index.includes('property="og:title"')) {
    index = index.replace(
      /<head[^>]*>/i,
      (match) => `${match}
  <meta property="og:title" content="SokoYetu - Kenyan Online Marketplace">
  <meta property="og:description" content="Shop products, discover sellers and checkout securely with M-PESA.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="${defaultSiteUrl}/">`
    );
    changed = true;
  }

  if (!index.includes('name="theme-color"')) {
    index = index.replace(
      /<head[^>]*>/i,
      (match) => `${match}
  <meta name="theme-color" content="#16a34a">`
    );
    changed = true;
  }

  if (changed) {
    fs.writeFileSync(indexPath, index, "utf8");
    console.log("Added basic SEO/social meta tags to index.html.");
  } else {
    console.log("index.html already has basic meta tags.");
  }
} else {
  console.log("index.html not found, skipped meta tags.");
}


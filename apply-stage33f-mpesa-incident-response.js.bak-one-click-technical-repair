<script>
const INCIDENT_KEY = "SokoYetu Mtaani_stage33f_mpesa_incidents";
const ROLLBACK_KEY = "SokoYetu Mtaani_stage33f_mpesa_rollback_checks";

const rollbackItems = [
  "Pause public promotion or buyer testing while the issue is investigated.",
  "Do not ask affected customers to repeat payment if they have a receipt.",
  "Capture order ID, payment ID, phone, amount, receipt and checkout request ID.",
  "Open M-PESA reconciliation and check whether receipt, amount and order status match.",
  "Export issue evidence from M-PESA evidence export page.",
  "Check admin orders page for order status and payment status.",
  "Check Render logs for callback or payment errors.",
  "Record customer communication in support queue/manual notes.",
  "If production credentials were just changed, revert only after preserving evidence.",
  "If required, set M-PESA environment back to sandbox/test in Render and redeploy.",
  "Confirm checkout is not accepting new live payments until the incident is understood.",
  "Prepare Safaricom/Daraja follow-up note with receipt and checkout request ID."
];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function msg(id, html){ document.getElementById(id).innerHTML = html; }
function getIncidents(){
  try { return JSON.parse(localStorage.getItem(INCIDENT_KEY) || "[]"); }
  catch { return []; }
}
function saveIncidents(items){ localStorage.setItem(INCIDENT_KEY, JSON.stringify(items)); }
function getRollback(){
  try { return JSON.parse(localStorage.getItem(ROLLBACK_KEY) || "{}"); }
  catch { return {}; }
}
function saveRollback(items){ localStorage.setItem(ROLLBACK_KEY, JSON.stringify(items)); }
function renderRollback(){
  const checks = getRollback();
  document.getElementById("rollbackChecklist").innerHTML = rollbackItems.map((text, i) => {
    const id = "rollback-" + i;
    return '<label class="checkitem" for="' + id + '"><input type="checkbox" id="' + id + '" ' + (checks[i] ? "checked" : "") + '><span>' + esc(text) + '</span></label>';
  }).join("");
}
function collectRollback(){
  const checks = {};
  rollbackItems.forEach((_, i) => checks[i] = document.getElementById("rollback-" + i).checked);
  return checks;
}
function addIncident(){
  const items = getIncidents();
  const entry = {
    createdAt: new Date().toISOString(),
    incidentType: document.getElementById("incidentType").value,
    severity: document.getElementById("severity").value,
    orderId: document.getElementById("orderId").value.trim(),
    paymentId: document.getElementById("paymentId").value.trim(),
    phone: document.getElementById("phone").value.trim(),
    mpesaReceipt: document.getElementById("mpesaReceipt").value.trim(),
    checkoutRequestId: document.getElementById("checkoutRequestId").value.trim(),
    status: document.getElementById("status").value,
    notes: document.getElementById("notes").value.trim()
  };

  if (!entry.orderId && !entry.paymentId && !entry.mpesaReceipt) {
    msg("incidentMessage", '<div class="err">Add at least an order ID, payment ID or M-PESA receipt.</div>');
    return;
  }

  items.unshift(entry);
  saveIncidents(items);
  renderIncidents();
  msg("incidentMessage", '<div class="ok">Incident log saved in this browser.</div>');
}
function renderIncidents(){
  const items = getIncidents();
  const p1 = items.filter(x => x.severity === "P1").length;
  const open = items.filter(x => x.status !== "resolved").length;
  const resolved = items.filter(x => x.status === "resolved").length;

  document.getElementById("summary").innerHTML =
    '<div class="metric">Incidents saved<b>' + items.length + '</b></div>' +
    '<div class="metric">P1 incidents<b>' + p1 + '</b></div>' +
    '<div class="metric">Open / active<b>' + open + '</b></div>' +
    '<div class="metric">Resolved<b>' + resolved + '</b></div>';

  document.getElementById("incidents").innerHTML = items.length ? items.map(item => {
    const sevClass = item.severity === "P1" ? "pill bad" : item.severity === "P2" ? "pill warn" : "pill info";
    const statusClass = item.status === "resolved" ? "pill" : "pill warn";
    return '<tr>' +
      '<td>' + esc(new Date(item.createdAt).toLocaleString()) + '</td>' +
      '<td>' + esc(item.incidentType) + '</td>' +
      '<td><span class="' + sevClass + '">' + esc(item.severity) + '</span></td>' +
      '<td>Order: #' + esc(item.orderId || "-") + '<br>Payment: #' + esc(item.paymentId || "-") + '</td>' +
      '<td>' + esc(item.phone || "-") + '</td>' +
      '<td>Receipt: <code>' + esc(item.mpesaReceipt || "-") + '</code><br>Checkout: <code>' + esc(item.checkoutRequestId || "-") + '</code></td>' +
      '<td><span class="' + statusClass + '">' + esc(item.status) + '</span></td>' +
      '<td>' + esc(item.notes || "-") + '</td>' +
    '</tr>';
  }).join("") : '<tr><td colspan="8">No incident logs saved yet.</td></tr>';
}
function csvEscape(value){
  const text = String(value ?? "");
  if (/[",\\r\\n]/.test(text)) return '"' + text.replace(/"/g, '""') + '"';
  return text;
}
function exportFile(format){
  const items = getIncidents();
  if (!items.length) {
    msg("incidentMessage", '<div class="err">No incident logs to export.</div>');
    return;
  }
  const stamp = new Date().toISOString().slice(0,10);
  let blob;
  let filename;
  if (format === "json") {
    blob = new Blob([JSON.stringify({ generatedAt:new Date().toISOString(), incidents: items }, null, 2)], { type:"application/json" });
    filename = "SokoYetu Mtaani-mpesa-incident-log-" + stamp + ".json";
  } else {
    const headers = Object.keys(items[0]);
    const csv = headers.join(",") + "\\n" + items.map(row => headers.map(h => csvEscape(row[h])).join(",")).join("\\n");
    blob = new Blob([csv], { type:"text/csv" });
    filename = "SokoYetu Mtaani-mpesa-incident-log-" + stamp + ".csv";
  }
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
  msg("incidentMessage", '<div class="ok">Export started: ' + esc(filename) + '</div>');
}
function buildTemplate(){
  const recipient = document.getElementById("recipient").value;
  const ref = document.getElementById("templateRef").value.trim() || "[reference]";
  let text = "";

  if (recipient === "safaricom") {
    text = "Hello Safaricom/Daraja Support,\\n\\nWe are reviewing an M-PESA transaction issue for SokoYetu Mtaani. Reference: " + ref + ".\\n\\nPlease help verify the transaction status using the available evidence below:\\n- Order ID:\\n- Payment ID:\\n- Customer phone:\\n- M-PESA receipt:\\n- CheckoutRequestID:\\n- Expected amount:\\n- Actual amount:\\n- Callback time, if available:\\n\\nIssue observed:\\n\\nAction requested: Please confirm whether the transaction was successful and whether callback delivery was completed.\\n\\nRegards,\\nSokoYetu Mtaani Operations";
  } else if (recipient === "customer") {
    text = "Hello,\\n\\nThank you for contacting SokoYetu Mtaani. We are reviewing your M-PESA payment/order issue. Reference: " + ref + ".\\n\\nPlease do not make another payment while we verify the transaction. If you have an M-PESA confirmation message, keep it safely. We will check the payment receipt, order status and reconciliation record, then update you.\\n\\nRegards,\\nSokoYetu Mtaani Support";
  } else {
    text = "Internal M-PESA incident note\\n\\nReference: " + ref + "\\nPriority:\\nIncident type:\\nOrder ID:\\nPayment ID:\\nCustomer phone:\\nM-PESA receipt:\\nCheckoutRequestID:\\nExpected amount:\\nActual amount:\\nObserved issue:\\nEvidence checked:\\nCustomer communication:\\nNext action:\\nOwner:\\nDeadline:";
  }

  document.getElementById("templateOutput").value = text;
}
async function copyTemplate(){
  const text = document.getElementById("templateOutput").value;
  if (!text) {
    msg("templateMessage", '<div class="err">Build a template first.</div>');
    return;
  }
  try {
    await navigator.clipboard.writeText(text);
    msg("templateMessage", '<div class="ok">Escalation note copied.</div>');
  } catch {
    msg("templateMessage", '<div class="warnBox">Could not copy automatically. Select and copy the text manually.</div>');
  }
}
document.getElementById("saveRollbackBtn").onclick = () => {
  saveRollback(collectRollback());
  msg("rollbackMessage", '<div class="ok">Rollback checklist saved in this browser.</div>');
};
document.getElementById("clearRollbackBtn").onclick = () => {
  if (!confirm("Clear rollback checklist?")) return;
  localStorage.removeItem(ROLLBACK_KEY);
  renderRollback();
  msg("rollbackMessage", '<div class="ok">Rollback checklist cleared.</div>');
};
document.getElementById("addIncidentBtn").onclick = addIncident;
document.getElementById("exportCsvBtn").onclick = () => exportFile("csv");
document.getElementById("exportJsonBtn").onclick = () => exportFile("json");
document.getElementById("clearIncidentsBtn").onclick = () => {
  if (!confirm("Clear all incident logs from this browser?")) return;
  localStorage.removeItem(INCIDENT_KEY);
  renderIncidents();
  msg("incidentMessage", '<div class="ok">Incident logs cleared from this browser.</div>');
};
document.getElementById("buildTemplateBtn").onclick = buildTemplate;
document.getElementById("copyTemplateBtn").onclick = copyTemplate;
renderRollback();
renderIncidents();
</script>
</body>
</html>`, "utf8");

// Add admin-control link.
if (fs.existsSync(adminControlPath)) {
  let control = fs.readFileSync(adminControlPath, "utf8");
  if (!control.includes("/admin-mpesa-incident.html")) {
    const section = `
  <section class="card">
    <div class="head">M-PESA incident response</div>
    <div class="body grid">
      <a class="tile" href="/admin-mpesa-incident.html">
        <b>M-PESA Incident Response</b>
        <span>Use rollback checklist, incident log, evidence capture and escalation templates for payment issues.</span>
        <em class="pill">Local log only</em>
      </a>
    </div>
  </section>
`;
    if (control.includes("</main>")) control = control.replace("</main>", section + "\n</main>");
    else control += section;
    fs.writeFileSync(adminControlPath, control, "utf8");
    console.log("Added M-PESA incident response link to admin-control.html.");
  } else {
    console.log("admin-control.html already links to admin-mpesa-incident.html.");
  }
}

// Update robots.txt.
let robots = fs.existsSync(robotsPath) ? fs.readFileSync(robotsPath, "utf8") : "User-agent: *\nAllow: /\n";
if (!robots.includes("Disallow: /admin-mpesa-incident.html")) {

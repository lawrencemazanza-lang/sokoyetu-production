// Patch server.js with final 404 and error handlers before listen.
let server = fs.readFileSync(serverPath, "utf8");

if (!server.includes("SokoYetu Stage 32E: Friendly Error Pages")) {
  const endpoint = `

// ================================
// SokoYetu Stage 32E: Friendly Error Pages and Public Recovery Flow
// Final fallback only. Does not affect existing defined routes.
// ================================
app.use((req, res, next) => {
  if (res.headersSent) return next();

  if (req.path && req.path.startsWith("/api/")) {
    return res.status(404).json({
      message: "API endpoint not found.",
      path: req.path,
    });
  }

  if (req.method !== "GET" && req.method !== "HEAD") {
    return res.status(404).send("Not found");
  }

  return res.status(404).sendFile(path.join(__dirname, "404.html"));
});

app.use((err, req, res, next) => {
  console.error("Unhandled server error:", err);

  if (res.headersSent) return next(err);

  if (req.path && req.path.startsWith("/api/")) {
    return res.status(500).json({
      message: "Internal server error.",
    });
  }

  return res.status(500).sendFile(path.join(__dirname, "500.html"));
});
`;

  const insertIndex = Math.max(server.lastIndexOf("app.listen"), server.lastIndexOf("server.listen"));
  if (insertIndex !== -1) {
    server = server.slice(0, insertIndex) + endpoint + "\n" + server.slice(insertIndex);
  } else {
    server += endpoint;
  }

  fs.writeFileSync(serverPath, server, "utf8");
  console.log("Added Stage 32E friendly error fallback to server.js.");
} else {
  console.log("Stage 32E error fallback already exists in server.js.");
}

// Ensure sitemap does not add 404/500; these are noindex and should not be indexed.
let sitemap = fs.existsSync(sitemapPath) ? fs.readFileSync(sitemapPath, "utf8") : "";
if (sitemap.includes("/404.html") || sitemap.includes("/500.html")) {
  sitemap = sitemap.replace(/\\s*<url>\\s*<loc>https:\\/\\/www\\.mysokoyetu\\.co\\.ke\\/(404|500)\\.html<\\/loc>\\s*<\\/url>/g, "");
  fs.writeFileSync(sitemapPath, sitemap, "utf8");
  console.log("Removed error pages from sitemap.xml.");
}

fs.writeFileSync(path.join(scriptsDir, "check-stage32e-error-pages.js"), `const fs = require("fs");
const path = require("path");

const root = process.cwd();

console.log("SokoYetu Stage 32E Friendly Error Pages Check");
console.log("--------------------------------------------");

let warnings = 0;

const requiredFiles = ["404.html", "500.html"];

for (const file of requiredFiles) {
  const filePath = path.join(root, file);
  if (!fs.existsSync(filePath)) {
    console.log("WARN:", file, "is missing.");
    warnings += 1;
    continue;
  }

  const html = fs.readFileSync(filePath, "utf8");
  const required = [
    "SokoYetu",
    "/help-center.html",
    "/track-order.html",
    "/support-request.html",
    "noindex",
    "/public-nav.js",
    "/public-a11y.js"
  ];

  for (const item of required) {
    if (!html.includes(item)) {
      console.log("WARN:", file, "missing:", item);
      warnings += 1;
    }
  }

  if (required.every((item) => html.includes(item))) {
    console.log("OK:", file, "has recovery links and noindex.");
  }
}

const serverPath = path.join(root, "server.js");
if (!fs.existsSync(serverPath)) {
  console.log("WARN: server.js is missing.");
  warnings += 1;
} else {
  const server = fs.readFileSync(serverPath, "utf8");
  const requiredServer = [
    "SokoYetu Stage 32E: Friendly Error Pages",
    "API endpoint not found",
    "404.html",
    "500.html"
  ];

  for (const item of requiredServer) {
    if (!server.includes(item)) {
      console.log("WARN: server.js missing:", item);
      warnings += 1;
    } else {
      console.log("OK: server.js includes", item);
    }
  }
}

const sitemapPath = path.join(root, "sitemap.xml");
if (fs.existsSync(sitemapPath)) {
  const sitemap = fs.readFileSync(sitemapPath, "utf8");
  if (sitemap.includes("/404.html") || sitemap.includes("/500.html")) {
    console.log("WARN: sitemap.xml should not include 404.html or 500.html.");
    warnings += 1;
  } else {
    console.log("OK: sitemap.xml does not include error pages.");
  }
}

console.log("");
console.log("Warnings:", warnings);
if (warnings === 0) console.log("Stage 32E friendly error pages check passed.");
`, "utf8");

fs.writeFileSync(path.join(root, "STAGE32E_FRIENDLY_ERROR_PAGES_GUIDE.md"), `# SokoYetu Stage 32E: Friendly Error Pages and Public Recovery Flow

Stage 32E adds friendly recovery pages for broken or unavailable routes.

## New pages

\`\`\`text
/404.html
/500.html
\`\`\`

## Server fallback

The final fallback in \`server.js\` now does the following:

\`\`\`text
Missing /api/* route → JSON 404 response
Missing public GET route → 404.html
Unhandled public error → 500.html
Unhandled API error → JSON 500 response
\`\`\`

## Why this matters

Buyers should not land on a blank or confusing error page. They should be able to return to:

\`\`\`text
Homepage
Categories
Seller stores
Help Center
Track Order
Support Request
\`\`\`

## Search indexing

The error pages use:

\`\`\`text
noindex
\`\`\`

They are not added to the sitemap.

## What this stage does not touch

\`\`\`text
checkout logic
M-PESA STK Push
DNS
email forwarding
database schema
admin tokens
product editor logic
seller verification logic
support queue logic
LiveKit
payment logic
\`\`\`


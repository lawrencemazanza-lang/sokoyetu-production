# SokoYetu Stage 19 security settings

# Use development locally and production only after deployment.
NODE_ENV="development"

# Production should use a long random JWT secret of at least 32 characters.
# Example: generate your own, do not copy this.
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_characters"

# Keep admin self-registration disabled except during a short controlled setup.
ADMIN_REGISTRATION_ENABLED="false"

# Optional production notes:
# NODE_ENV="production"
# ADMIN_REGISTRATION_ENABLED="false"

<script>
function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
function type(){ return document.getElementById("type").value; }
function format(){ return document.getElementById("format").value; }

async function fetchExport(){
  if (!token()) throw new Error("Admin order token is required.");
  const url = "/api/admin/export/" + encodeURIComponent(type()) + "?format=" + encodeURIComponent(format());
  const response = await fetch(url, {
    credentials: "include",
    headers: {"x-admin-order-token": token()}
  });
  if (!response.ok) {
    const data = await response.json().catch(() => ({}));
    throw new Error(data.message || "Export failed.");
  }
  return response;
}

async function previewExport(){
  msg('<div class="note">Loading export preview...</div>');
  document.getElementById("preview").innerHTML = "";
  try {
    const currentFormat = format();
    const response = await fetchExport();
    const text = await response.text();
    const rows = currentFormat === "json" ? JSON.parse(text) : parseCsv(text);
    renderPreview(rows, currentFormat);
    msg('<div class="ok">Preview loaded.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not preview export.") + '</div>');
  }
}

function parseCsv(text){
  const lines = String(text || "").split(/\\r?\\n/).filter(Boolean);
  if (!lines.length) return [];
  const headers = splitCsvLine(lines[0]);
  return lines.slice(1, 26).map(line => {
    const values = splitCsvLine(line);
    const row = {};
    headers.forEach((h, i) => row[h] = values[i] || "");
    return row;
  });
}

function splitCsvLine(line){
  const out = [];
  let cur = "";
  let quote = false;
  for (let i = 0; i < line.length; i++) {
    const c = line[i];
    const n = line[i + 1];
    if (c === '"' && quote && n === '"') { cur += '"'; i++; continue; }
    if (c === '"') { quote = !quote; continue; }
    if (c === "," && !quote) { out.push(cur); cur = ""; continue; }
    cur += c;
  }
  out.push(cur);
  return out;
}

function renderPreview(rows, currentFormat){
  const summary = document.getElementById("summary");
  const preview = document.getElementById("preview");
  const list = Array.isArray(rows) ? rows : (rows.data || []);
  summary.innerHTML = '<b>' + list.length + '</b> preview row(s) loaded. CSV preview is limited to the first 25 rows.';

  if (!list.length) {
    preview.innerHTML = '<div class="note">No rows found.</div>';
    return;
  }

  const keys = Object.keys(list[0]).slice(0, 8);
  preview.innerHTML = '<table><thead><tr>' + keys.map(k => '<th>' + esc(k) + '</th>').join("") + '</tr></thead><tbody>' +
    list.slice(0, 25).map(row => '<tr>' + keys.map(k => '<td>' + esc(row[k]) + '</td>').join("") + '</tr>').join("") +
    '</tbody></table>';
}

async function downloadExport(){
  msg('<div class="note">Preparing download...</div>');
  try {
    const response = await fetchExport();
    const blob = await response.blob();
    const contentDisposition = response.headers.get("Content-Disposition") || "";
    const fallback = "sokoyetu-" + type() + "-export." + format();
    const match = contentDisposition.match(/filename="?([^"]+)"?/i);
    const filename = match ? match[1] : fallback;
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
    msg('<div class="ok">Download started: ' + esc(filename) + '</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not download export.") + '</div>');
  }
}

document.getElementById("previewBtn").onclick = previewExport;
document.getElementById("downloadBtn").onclick = downloadExport;

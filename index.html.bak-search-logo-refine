<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="description" content="Shop online at SokoYetu Mtaani, Kenya's local online marketplace for trusted sellers, M-PESA payments, quality products, pickup, delivery, and customer support.">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Mtaani | Online Shopping & Marketplace in Kenya</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    :root{
      --orange:#f68b1e;
      --orange-dark:#c76100;
      --green:#16a34a;
      --green-dark:#064e3b;
      --red:#e61601;
      --bg:#f1f3f6;
      --card:#ffffff;
      --ink:#111827;
      --muted:#64748b;
      --line:#e5e7eb;
      --shadow:0 8px 20px rgba(15,23,42,.08);
      --radius:8px;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
    a{text-decoration:none;color:inherit}
    button,input{font:inherit}
    .soko37e-page{min-height:100vh}
    .soko37e-wrap{width:min(1240px,96vw);margin:0 auto}
    .soko37e-top{background:#fff3e5;color:#7c2d12;font-size:13px;border-bottom:1px solid #fed7aa}
    .soko37e-top-inner{height:32px;display:flex;align-items:center;justify-content:space-between;gap:14px}
    .soko37e-top a{font-weight:900;color:#9a3412}
    .soko37e-header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:80}
    .soko37e-header-row{height:70px;display:grid;grid-template-columns:180px minmax(260px,1fr) auto;gap:14px;align-items:center}
    .soko37e-logo{display:flex;align-items:center;gap:9px;font-size:25px;font-weight:950;color:var(--green-dark)}
    .soko37e-logo-mark{width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--orange),var(--green));color:#fff;display:grid;place-items:center}
    .soko37e-search{display:grid;grid-template-columns:1fr auto;border:2px solid var(--orange);border-radius:6px;overflow:hidden;background:#fff}
    .soko37e-search input{border:0;outline:0;padding:12px 13px}
    .soko37e-search button{border:0;background:var(--orange);color:#fff;font-weight:950;padding:0 24px;cursor:pointer}
    .soko37e-actions{display:flex;gap:8px;white-space:nowrap;align-items:center}
    .soko37e-action{padding:9px 8px;border-radius:6px;font-weight:850;color:#334155}
    .soko37e-action:hover{background:#f8fafc;color:var(--orange-dark)}
    .soko37e-page-links{background:#fff;border-bottom:1px solid var(--line)}
    .soko37e-page-links-inner{height:42px;display:flex;gap:9px;align-items:center;overflow:auto}
    .soko37e-page-links a{white-space:nowrap;border:1px solid var(--line);background:#f8fafc;border-radius:999px;padding:7px 11px;font-weight:850;font-size:13px;color:#334155}
    .soko37e-page-links a:hover{background:#fff7ed;color:var(--orange-dark)}
    .soko37e-main{width:min(1240px,96vw);margin:12px auto 42px;display:grid;grid-template-columns:210px minmax(0,1fr) 270px;gap:12px}
    .soko37e-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
    .soko37e-category-rail{padding:7px;height:max-content}
    .soko37e-cat{display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:6px;font-size:14px;color:#334155;font-weight:750}
    .soko37e-cat:hover{background:#fff7ed;color:var(--orange-dark)}
    .soko37e-cat span{width:22px;text-align:center}
    .soko37e-center{display:grid;gap:12px;min-width:0}
    .soko37e-flash-hero{background:#fff;border:2px solid var(--red);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
    .soko37e-flash-head{background:var(--red);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 14px}
    .soko37e-flash-head h1{font-size:24px;margin:0;display:flex;align-items:center;gap:8px}
    .soko37e-timer{background:rgba(255,255,255,.2);border-radius:999px;padding:6px 10px;font-weight:950}
    .soko37e-flash-body{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:12px;padding:12px}
    .soko37e-live-product{border:1px solid #fecaca;background:linear-gradient(135deg,#fff,#fff7ed);border-radius:10px;padding:14px;display:grid;grid-template-columns:210px minmax(0,1fr);gap:14px;align-items:center;min-height:270px}
    .soko37e-live-img{height:220px;background:#f8fafc;border-radius:10px;display:grid;place-items:center;overflow:hidden}
    .soko37e-live-img img{width:100%;height:100%;object-fit:cover}
    .soko37e-live-img span{font-size:70px}
    .soko37e-live-details{display:grid;gap:9px}
    .soko37e-live-label{display:inline-flex;width:fit-content;background:#fee2e2;color:#991b1b;border-radius:999px;padding:5px 9px;font-size:12px;font-weight:950}
    .soko37e-live-details h2{font-size:28px;margin:0;line-height:1.08;color:#111827}
    .soko37e-live-details p{margin:0;color:#475569;line-height:1.45}
    .soko37e-live-price{font-size:28px;font-weight:950;color:var(--red)}
    .soko37e-live-old{text-decoration:line-through;color:#94a3b8;margin-left:8px;font-size:14px}
    .soko37e-btn{border:0;border-radius:6px;padding:11px 13px;font-weight:950;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px}
    .soko37e-btn.orange{background:var(--orange);color:#fff}
    .soko37e-btn.dark{background:#111827;color:#fff}
    .soko37e-btn.green{background:#128c7e;color:#fff}
    .soko37e-mini-flash{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
    .soko37e-product-mini{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px;display:grid;grid-template-columns:70px 1fr;gap:9px;align-items:center}
    .soko37e-product-mini-img{height:70px;background:#f8fafc;border-radius:7px;display:grid;place-items:center;overflow:hidden}
    .soko37e-product-mini-img img{width:100%;height:100%;object-fit:cover}
    .soko37e-product-mini-img span{font-size:28px}
    .soko37e-product-mini b{font-size:13px;line-height:1.25;display:block}
    .soko37e-product-mini strong{color:var(--red);font-size:14px}
    .soko37e-side-ads{display:grid;gap:12px;height:max-content}
    .soko37e-side-card{padding:13px;display:grid;gap:8px}
    .soko37e-side-card h3{margin:0;color:var(--green-dark);font-size:18px}
    .soko37e-side-card p{margin:0;color:#475569;line-height:1.4;font-size:14px}
    .soko37e-whatsapp-card{background:linear-gradient(135deg,#128c7e,#075e54);border:0;color:#fff}
    .soko37e-whatsapp-card h3,.soko37e-whatsapp-card p{color:#fff}
    .soko37e-ad-card{background:linear-gradient(135deg,#fff7ed,#fff);border-color:#fed7aa}
    .soko37e-ad-pill{display:inline-flex;width:fit-content;border-radius:999px;background:#ffedd5;color:#9a3412;padding:5px 9px;font-size:12px;font-weight:950}
    .soko37e-banner-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
    .soko37e-banner-strip a{background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);padding:11px;display:flex;gap:9px;align-items:center}
    .soko37e-banner-strip span{font-size:24px}.soko37e-banner-strip b{display:block;font-size:13px}.soko37e-banner-strip small{color:var(--muted)}
    .soko37e-section{display:grid;gap:9px}
    .soko37e-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:11px 13px}
    .soko37e-section-head h2{font-size:20px;margin:0}
    .soko37e-section-head a{font-weight:900;color:var(--orange-dark)}
    .soko37e-live-strip .soko37e-section-head{background:#111827;color:#fff}
    .soko37e-live-strip .soko37e-section-head a{color:#fff}
    .soko37e-live-row{display:grid;grid-template-columns:1.2fr repeat(3,1fr);gap:9px}
    .soko37e-live-main{min-height:190px;background:radial-gradient(circle at 30% 10%,#f97316,#111827 58%);color:#fff;border-radius:8px;padding:18px;display:grid;align-content:center}
    .soko37e-live-main b{font-size:24px;display:block;margin-bottom:8px}
    .soko37e-live-tile{background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);padding:12px;display:grid;gap:8px}
    .soko37e-live-dot{display:inline-flex;width:fit-content;background:#fee2e2;color:#991b1b;border-radius:999px;padding:4px 8px;font-size:12px;font-weight:950}
    .soko37e-category-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}
    .soko37e-category-tile{background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);padding:14px 8px;text-align:center}
    .soko37e-category-tile span{font-size:29px;display:block;margin-bottom:7px}
    .soko37e-category-tile b{font-size:13px;color:#334155}
    .soko37e-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
    .soko37e-product{background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);overflow:hidden;display:grid}
    .soko37e-product:hover{transform:translateY(-2px);transition:.18s ease;box-shadow:0 15px 30px rgba(15,23,42,.13)}
    .soko37e-img{height:145px;background:#f8fafc;display:grid;place-items:center;overflow:hidden}
    .soko37e-img img{width:100%;height:100%;object-fit:cover}
    .soko37e-img span{font-size:44px}
    .soko37e-prod-body{padding:10px;display:grid;gap:6px}
    .soko37e-prod-name{font-size:14px;line-height:1.28;min-height:36px}
    .soko37e-price{font-weight:950;color:#111827;font-size:17px}
    .soko37e-old{text-decoration:line-through;color:#94a3b8;font-size:12px}
    .soko37e-disc{display:inline-flex;width:fit-content;border-radius:4px;background:#ffedd5;color:#c2410c;padding:3px 6px;font-size:11px;font-weight:950}
    .soko37e-cart{background:var(--orange);color:#fff;border:0;border-radius:6px;padding:9px;font-weight:950;cursor:pointer}
    .soko37e-sponsored .soko37e-section-head{background:#fff7ed}
    .soko37e-footer{background:#111827;color:#cbd5e1;padding:30px 0;margin-top:42px}
    .soko37e-footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:18px}
    .soko37e-footer h3{margin:0 0 9px;color:#fff}
    .soko37e-footer a,.soko37e-footer p{color:#cbd5e1;line-height:1.55;margin:0}
    .soko37e-whatsapp{position:fixed;right:18px;bottom:22px;z-index:95;background:#128c7e;color:#fff;border-radius:999px;padding:13px 16px;font-weight:950;box-shadow:0 14px 35px rgba(15,23,42,.26)}
    .soko37e-mobile-nav{display:none}
    @media(max-width:1180px){
      .soko37e-main{grid-template-columns:200px minmax(0,1fr)}
      .soko37e-side-ads{grid-column:1/-1;grid-template-columns:repeat(3,1fr)}
      .soko37e-product-grid{grid-template-columns:repeat(3,1fr)}
    }
    @media(max-width:930px){
      .soko37e-top-inner{height:auto;padding:7px 0;flex-direction:column;align-items:flex-start}
      .soko37e-header-row{height:auto;grid-template-columns:1fr;padding:12px 0}
      .soko37e-actions,.soko37e-page-links-inner{overflow:auto}
      .soko37e-main{display:block;margin-top:10px}
      .soko37e-category-rail{display:flex;gap:8px;overflow:auto;margin-bottom:10px}
      .soko37e-cat{white-space:nowrap;border:1px solid var(--line)}
      .soko37e-flash-body,.soko37e-live-product,.soko37e-live-row{grid-template-columns:1fr}
      .soko37e-side-ads{grid-template-columns:1fr;margin:10px 0}
      .soko37e-banner-strip{grid-template-columns:repeat(2,1fr);margin:10px 0}
      .soko37e-product-grid{grid-template-columns:repeat(2,1fr)}
      .soko37e-category-grid{grid-template-columns:repeat(3,1fr)}
      .soko37e-footer-grid{grid-template-columns:1fr}
      .soko37e-whatsapp{right:10px;bottom:70px;padding:11px 13px;font-size:13px}
      .soko37e-mobile-nav{display:grid;grid-template-columns:repeat(4,1fr);position:fixed;bottom:0;left:0;right:0;z-index:85;background:#fff;border-top:1px solid var(--line)}
      .soko37e-mobile-nav a{text-align:center;font-size:12px;font-weight:850;padding:9px 4px;color:#334155}
    }
    @media(max-width:520px){
      .soko37e-wrap,.soko37e-main{width:min(100% - 14px,1240px)}
      .soko37e-flash-head{align-items:flex-start;flex-direction:column}
      .soko37e-flash-head h1{font-size:21px}
      .soko37e-live-img{height:170px}
      .soko37e-live-details h2{font-size:23px}
      .soko37e-mini-flash{grid-template-columns:1fr}
      .soko37e-banner-strip{grid-template-columns:1fr}
      .soko37e-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
      .soko37e-img{height:116px}
      .soko37e-prod-name{font-size:13px}
      .soko37e-price{font-size:15px}
      .soko37e-category-grid{grid-template-columns:repeat(2,1fr)}
      .soko37e-section-head{align-items:flex-start;flex-direction:column}
    }
  
    /* SokoYetu Mtaani Stage 37F: themed flash sale and shopping cart logo */
    .soko37f-cart-logo{
      width:44px;
      height:44px;
      border-radius:14px;
      background:linear-gradient(135deg,#f68b1e 0%,#16a34a 100%);
      color:#fff;
      display:grid;
      place-items:center;
      box-shadow:0 12px 28px rgba(15,23,42,.22), inset 0 1px 0 rgba(255,255,255,.28);
      position:relative;
      overflow:hidden;
    }
    .soko37f-cart-logo::after{
      content:"";
      position:absolute;
      width:58px;
      height:58px;
      right:-28px;
      top:-28px;
      background:rgba(255,255,255,.20);
      border-radius:999px;
    }
    .soko37f-cart-logo svg{
      width:28px;
      height:28px;
      position:relative;
      z-index:1;
      filter:drop-shadow(0 3px 5px rgba(0,0,0,.25));
    }
    .soko37f-theme-card{
      position:relative;
      overflow:hidden;
      border:0!important;
      color:#fff;
      min-height:88px;
    }
    .soko37f-theme-card::before{
      content:"";
      position:absolute;
      inset:0;
      background:radial-gradient(circle at top right,rgba(255,255,255,.30),transparent 42%);
      pointer-events:none;
    }
    .soko37f-theme-card .soko37e-product-mini-img{
      background:rgba(255,255,255,.20);
      border:1px solid rgba(255,255,255,.20);
      position:relative;
      z-index:1;
    }
    .soko37f-theme-card b,
    .soko37f-theme-card strong,
    .soko37f-theme-card small{
      color:#fff!important;
      position:relative;
      z-index:1;
    }
    .soko37f-theme-card strong{
      font-size:15px!important;
      text-shadow:0 2px 6px rgba(0,0,0,.18);
    }
    .soko37f-theme-live{
      border:0!important;
      color:#fff;
      box-shadow:0 18px 38px rgba(15,23,42,.16);
      position:relative;
      overflow:hidden;
      transition:background .45s ease, transform .25s ease;
    }
    .soko37f-theme-live::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        radial-gradient(circle at 80% 12%,rgba(255,255,255,.30),transparent 25%),
        radial-gradient(circle at 10% 90%,rgba(255,255,255,.17),transparent 35%);
      pointer-events:none;
    }
    .soko37f-theme-live .soko37e-live-img,
    .soko37f-theme-live .soko37e-live-details{
      position:relative;
      z-index:1;
    }
    .soko37f-theme-live .soko37e-live-img{
      background:rgba(255,255,255,.16)!important;
      border:1px solid rgba(255,255,255,.22);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.22);
    }
    .soko37f-theme-live .soko37e-live-label{
      background:rgba(255,255,255,.18)!important;
      color:#fff!important;
      border:1px solid rgba(255,255,255,.24);
    }
    .soko37f-theme-live .soko37e-live-details h2,
    .soko37f-theme-live .soko37e-live-details p,
    .soko37f-theme-live .soko37e-live-price{
      color:#fff!important;
      text-shadow:0 2px 8px rgba(0,0,0,.20);
    }
    .soko37f-theme-live .soko37e-live-old{
      color:rgba(255,255,255,.70)!important;
    }
    @media(max-width:520px){
      .soko37f-theme-card{min-height:96px}
      .soko37f-cart-logo{width:40px;height:40px}
      .soko37f-cart-logo svg{width:25px;height:25px}
    }

  </style>

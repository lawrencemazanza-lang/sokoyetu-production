<script>
const WHATSAPP_NUMBER = "254714565555";
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE", { maximumFractionDigits: 0 }); }
function esc(value){ return String(value ?? "").replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[m])); }
function normalizeProducts(data){
  const raw = Array.isArray(data) ? data : Array.isArray(data.products) ? data.products : Array.isArray(data.items) ? data.items : [];
  return raw.map((p, index) => ({
    id: p.id || p.productId || index + 1,
    name: p.name || p.title || p.productName || "SokoYetu Mtaani Product",
    price: Number(p.price || p.amount || p.sellingPrice || 0),
    oldPrice: Number(p.oldPrice || p.compareAtPrice || p.priceBefore || 0),
    imageUrl: p.imageUrl || p.image || p.photoUrl || p.thumbnail || "",
    category: p.category || p.categoryName || "Deal",
    stock: p.stock ?? p.quantity ?? ""
  }));
}
function fallbackProducts(){
  return [
    {id:1,name:"HP Pavilion 15 Laptop",price:45000,oldPrice:52000,category:"Computing",imageUrl:"",stock:6},
    {id:2,name:"Samsung Galaxy Smartphone",price:18500,oldPrice:22000,category:"Phones",imageUrl:"",stock:12},
    {id:3,name:"Wireless Bluetooth Earbuds",price:1800,oldPrice:2500,category:"Electronics",imageUrl:"",stock:20},
    {id:4,name:"Kenyan Coffee Blend 500g",price:1200,oldPrice:1500,category:"Groceries",imageUrl:"",stock:50},
    {id:5,name:"Fashion Sneakers",price:3200,oldPrice:4000,category:"Fashion",imageUrl:"",stock:15},
    {id:6,name:"Kitchen Blender",price:4200,oldPrice:5200,category:"Home",imageUrl:"",stock:8},
    {id:7,name:"Smart Watch",price:3500,oldPrice:4500,category:"Electronics",imageUrl:"",stock:10},
    {id:8,name:"Home Storage Rack",price:2500,oldPrice:3200,category:"Home",imageUrl:"",stock:7},
    {id:9,name:"Beauty Care Set",price:1500,oldPrice:2200,category:"Beauty",imageUrl:"",stock:22},
    {id:10,name:"Gaming Headset",price:2800,oldPrice:3500,category:"Gaming",imageUrl:"",stock:11},
    {id:11,name:"Office Backpack",price:2100,oldPrice:2800,category:"Fashion",imageUrl:"",stock:13},
    {id:12,name:"Electric Kettle",price:1900,oldPrice:2400,category:"Appliances",imageUrl:"",stock:9}
  ];
}
function discount(p){
  return p.oldPrice && p.oldPrice > p.price ? Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100) : 0;
}
function imageHtml(p, cls){
  return p.imageUrl ? "<img src='" + esc(p.imageUrl) + "' alt='" + esc(p.name) + "'>" : "<span>🛍️</span>";
}
function miniProductCard(p){
  return "<a class='soko37e-product-mini' href='/product-detail.html?id=" + esc(p.id) + "'><div class='soko37e-product-mini-img'>" + imageHtml(p) + "</div><div><b>" + esc(p.name) + "</b><strong>" + money(p.price) + "</strong></div></a>";
}
function productCard(p){
  const d = discount(p);
  const old = d ? "<span class='soko37e-old'>" + money(p.oldPrice) + "</span>" : "";
  const disc = d ? "<span class='soko37e-disc'>-" + d + "%</span>" : "";
  return "<article class='soko37e-product'><a href='/product-detail.html?id=" + esc(p.id) + "'><div class='soko37e-img'>" + imageHtml(p) + "</div></a><div class='soko37e-prod-body'>" + disc + "<div class='soko37e-prod-name'>" + esc(p.name) + "</div><div><span class='soko37e-price'>" + money(p.price) + "</span> " + old + "</div><button class='soko37e-cart' onclick='addProductToCart(" + JSON.stringify(p.id) + ")'>Add to cart</button></div></article>";
}
async function addProductToCart(id){
  try{
    const response = await fetch("/api/cart", {method:"POST",credentials:"include",headers:{"Content-Type":"application/json"},body:JSON.stringify({productId:id,quantity:1})});
    if(!response.ok) throw new Error("Cart request failed");
    location.href = "/checkout.html";
  }catch(error){
    location.href = "/product-detail.html?id=" + encodeURIComponent(id);
  }
}
function renderLiveProduct(products){
  let index = 0;
  const liveImage = document.getElementById("soko37eLiveImage");
  const liveName = document.getElementById("soko37eLiveName");
  const liveMeta = document.getElementById("soko37eLiveMeta");
  const livePrice = document.getElementById("soko37eLivePrice");
  const liveOld = document.getElementById("soko37eLiveOld");
  const liveCart = document.getElementById("soko37eLiveCart");
  const liveWhatsApp = document.getElementById("soko37eLiveWhatsApp");

  function show(){
    const p = products[index % products.length];
    liveImage.innerHTML = imageHtml(p);
    liveName.textContent = p.name;
    liveMeta.textContent = (p.category || "Flash Sale") + " · " + (p.stock ? p.stock + " available" : "Limited stock");
    livePrice.textContent = money(p.price);
    liveOld.textContent = p.oldPrice && p.oldPrice > p.price ? money(p.oldPrice) : "";
    liveCart.onclick = function(){ addProductToCart(p.id); };
    liveWhatsApp.href = "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent("Hello SokoYetu Mtaani, I am interested in " + p.name);
    index += 1;
  }
  show();
  setInterval(show, 3200);
}
async function loadProducts(){
  let products = [];
  try{
    const response = await fetch("/api/products", {cache:"no-store", credentials:"include"});
    const data = await response.json();
    products = normalizeProducts(data);
  }catch(error){
    products = fallbackProducts();
  }
  if(!products.length) products = fallbackProducts();

  renderLiveProduct(products);
  document.getElementById("soko37eFlashGrid").innerHTML = products.slice(0,4).map(miniProductCard).join("");
  document.getElementById("soko37eSponsoredGrid").innerHTML = products.slice(2,6).map(productCard).join("");
  document.getElementById("soko37eRecommendedGrid").innerHTML = products.slice(4,12).concat(products).slice(0,8).map(productCard).join("");
}
function initTimer(){
  let seconds = 2 * 60 * 60 + 15 * 60;
  function tick(){
    const h = String(Math.floor(seconds / 3600)).padStart(2,"0");
    const m = String(Math.floor((seconds % 3600) / 60)).padStart(2,"0");
    const s = String(seconds % 60).padStart(2,"0");
    document.getElementById("soko37eTimer").textContent = "Ends in " + h + ":" + m + ":" + s;
    seconds = seconds > 0 ? seconds - 1 : 0;
  }
  tick();
  setInterval(tick, 1000);
}
function initAds(){
  const ads = [
    {pill:"Advert",title:"Promote products here",text:"Your product can appear in the right advert panel.",link:"/seller-center.html"},
    {pill:"Pickup",title:"Self-pickup available",text:"Buyers can collect and avoid delivery fee.",link:"/checkout.html"},
    {pill:"Live",title:"Join Live Shopping",text:"Feature your products in live shopping slots.",link:"https://wa.me/" + WHATSAPP_NUMBER},
    {pill:"Deals",title:"Flash Sale placement",text:"Push your product into the first homepage section.",link:"/categories.html"}
  ];
  let index = 0;
  function show(){
    const ad = ads[index % ads.length];
    document.getElementById("soko37eAdPill").textContent = ad.pill;
    document.getElementById("soko37eAdTitle").textContent = ad.title;
    document.getElementById("soko37eAdText").textContent = ad.text;
    document.getElementById("soko37eAdLink").href = ad.link;
    index += 1;
  }
  show();
  setInterval(show, 3800);
}
document.getElementById("soko37eSearch").addEventListener("submit", event => {
  event.preventDefault();
  const q = document.getElementById("soko37eSearchInput").value.trim();
  location.href = "/categories.html" + (q ? "?q=" + encodeURIComponent(q) : "");
});

/* SokoYetu Mtaani Stage 37F: themed flash sale and shopping cart logo */
const SOKO37F_THEMES = [
  {key:"electronics", match:/phone|tablet|electronic|earbud|watch|gadget|charger|audio|smart/i, bg:"linear-gradient(135deg,#0f172a 0%,#2563eb 52%,#22d3ee 100%)"},
  {key:"computing", match:/laptop|computer|hp|dell|lenovo|macbook|keyboard|mouse|printer/i, bg:"linear-gradient(135deg,#111827 0%,#7c3aed 52%,#f97316 100%)"},
  {key:"fashion", match:/fashion|shoe|sneaker|bag|dress|shirt|clothing|wear|backpack/i, bg:"linear-gradient(135deg,#831843 0%,#ec4899 50%,#f97316 100%)"},
  {key:"home", match:/home|kitchen|blender|kettle|rack|furniture|storage|office|appliance/i, bg:"linear-gradient(135deg,#14532d 0%,#16a34a 48%,#facc15 100%)"},
  {key:"beauty", match:/beauty|care|skin|hair|makeup|cream|cosmetic/i, bg:"linear-gradient(135deg,#7e22ce 0%,#ec4899 50%,#fda4af 100%)"},
  {key:"groceries", match:/coffee|grocery|groceries|food|drink|supermarket|tea|honey/i, bg:"linear-gradient(135deg,#713f12 0%,#d97706 52%,#facc15 100%)"},
  {key:"gaming", match:/game|gaming|headset|console|pad/i, bg:"linear-gradient(135deg,#020617 0%,#7c3aed 52%,#ef4444 100%)"},
  {key:"default", match:/.*/, bg:"linear-gradient(135deg,#064e3b 0%,#16a34a 50%,#f68b1e 100%)"}
];

function getSoko37FTheme(product, index){
  const hay = String((product && (product.category + " " + product.name)) || "");
  const theme = SOKO37F_THEMES.find(t => t.match.test(hay)) || SOKO37F_THEMES[SOKO37F_THEMES.length - 1];
  const rotate = [
    theme.bg,
    "linear-gradient(135deg,#1e293b 0%,#0ea5e9 52%,#22c55e 100%)",
    "linear-gradient(135deg,#7c2d12 0%,#ea580c 50%,#facc15 100%)",
    "linear-gradient(135deg,#312e81 0%,#7c3aed 50%,#f97316 100%)"
  ];
  return rotate[index % rotate.length];
}

function miniProductCard(p, index){
  const bg = getSoko37FTheme(p, index || 0);
  return "<a class='soko37e-product-mini soko37f-theme-card' style='background:" + bg + "' href='/product-detail.html?id=" + esc(p.id) + "'><div class='soko37e-product-mini-img'>" + imageHtml(p) + "</div><div><b>" + esc(p.name) + "</b><strong>" + money(p.price) + "</strong><small>Flash Sale</small></div></a>";
}

function productCard(p, index){
  const d = discount(p);
  const old = d ? "<span class='soko37e-old'>" + money(p.oldPrice) + "</span>" : "";
  const disc = d ? "<span class='soko37e-disc'>-" + d + "%</span>" : "";
  return "<article class='soko37e-product'><a href='/product-detail.html?id=" + esc(p.id) + "'><div class='soko37e-img'>" + imageHtml(p) + "</div></a><div class='soko37e-prod-body'>" + disc + "<div class='soko37e-prod-name'>" + esc(p.name) + "</div><div><span class='soko37e-price'>" + money(p.price) + "</span> " + old + "</div><button class='soko37e-cart' onclick='addProductToCart(" + JSON.stringify(p.id) + ")'>Add to cart</button></div></article>";
}

function renderLiveProduct(products){
  let index = 0;
  const liveCard = document.getElementById("soko37eLiveProduct");
  const liveImage = document.getElementById("soko37eLiveImage");
  const liveName = document.getElementById("soko37eLiveName");
  const liveMeta = document.getElementById("soko37eLiveMeta");
  const livePrice = document.getElementById("soko37eLivePrice");
  const liveOld = document.getElementById("soko37eLiveOld");
  const liveCart = document.getElementById("soko37eLiveCart");
  const liveWhatsApp = document.getElementById("soko37eLiveWhatsApp");

  function show(){
    const p = products[index % products.length];
    liveCard.classList.add("soko37f-theme-live");
    liveCard.style.background = getSoko37FTheme(p, index);
    liveImage.innerHTML = imageHtml(p);
    liveName.textContent = p.name;
    liveMeta.textContent = (p.category || "Flash Sale") + " · " + (p.stock ? p.stock + " available" : "Limited stock");
    livePrice.textContent = money(p.price);
    liveOld.textContent = p.oldPrice && p.oldPrice > p.price ? money(p.oldPrice) : "";
    liveCart.onclick = function(){ addProductToCart(p.id); };
    liveWhatsApp.href = "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent("Hello SokoYetu Mtaani, I am interested in " + p.name);
    index += 1;
  }
  show();
  setInterval(show, 3200);
}

loadProducts();
initTimer();
initAds();
</script>

<body>
<header>
  <div class="wrap">
    <h1 id="sellerTitle">Seller Store</h1>
    <p id="sellerSubtitle">Browse available products from this SokoYetu Mtaani seller.</p>
  </div>
</header>

<main>
  <div style="display:flex;gap:10px;flex-wrap:wrap">
    <a class="linkbtn" href="/seller-stores.html">← All seller stores</a>
    <a class="linkbtn secondary" href="/categories.html">Browse categories</a>
    <a class="linkbtn secondary" href="/">Back to shop</a>
  </div>

  <section class="card">
    <div class="head">Seller products</div>
    <div class="body">
      <div id="message" class="note">Loading seller products...</div>
      <div id="productList" class="grid"></div>
    </div>
  </section>
</main>

<footer>SokoYetu Mtaani · Seller storefront · SokoYetu Mtaani@gmail.com</footer>

<script>
function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function sellerId(){ return new URLSearchParams(location.search).get("sellerId") || "unknown"; }
function sellerName(id){ return id === "unknown" ? "Marketplace seller" : "Seller #" + id; }

async function loadStore(){
  const id = sellerId();
  const message = document.getElementById("message");
  document.getElementById("sellerTitle").textContent = sellerName(id);
  document.title = sellerName(id) + " · SokoYetu Mtaani Seller Store";

  try {
    const res = await fetch("/api/products", { credentials: "include" });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.message || "Could not load products.");

    const raw = Array.isArray(data) ? data : (data.products || data.data || []);
    const products = raw.map(p => ({
      id: p.id,
      name: p.name || p.title || "Unnamed product",
      description: p.description || "",
      category: p.category || "Other",
      price: p.price || 0,
      stock: p.stock ?? null,
      imageUrl: p.imageUrl || p.image || p.photoUrl || "",
      sellerId: String(p.sellerId || "unknown")
    })).filter(p => p.sellerId === String(id));

    renderProducts(products);
    message.className = "note";
    message.textContent = products.length ? products.length + " product(s) loaded for this seller." : "No products are currently listed for this seller.";
  } catch (error) {
    message.className = "err";
    message.textContent = error.message || "Could not load seller store.";
  }
}

function renderProducts(products){
  const wrap = document.getElementById("productList");

  if (!products.length) {
    wrap.innerHTML = '<div class="note">No products found for this seller.</div>';
    return;
  }

  wrap.innerHTML = products.map(p => {
    const img = p.imageUrl
      ? '<img src="' + esc(p.imageUrl) + '" alt="' + esc(p.name) + '">'
      : '<div class="noimg">No image</div>';
    const stockText = p.stock === null ? "Stock not shown" : (Number(p.stock) > 0 ? p.stock + " in stock" : "Out of stock");
    const stockClass = p.stock !== null && Number(p.stock) <= 0 ? "pill warn" : "pill";

    return '<article class="product">' +
      img +
      '<div class="pbody">' +
        '<b>' + esc(p.name) + '</b>' +
        '<span>' + esc(p.category) + '</span>' +
        '<span class="price">' + money(p.price) + '</span>' +
        '<span class="' + stockClass + '">' + esc(stockText) + '</span>' +
        '<span>' + esc((p.description || "").slice(0, 100)) + (p.description && p.description.length > 100 ? "..." : "") + '</span>' +
        '<a class="linkbtn" href="/product-detail.html?id=' + encodeURIComponent(p.id) + '">Product details</a>' +
      '</div>' +
    '</article>';
  }).join("");
}

loadStore();
</script>

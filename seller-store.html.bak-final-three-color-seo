  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#064e3b,#16a34a);color:#fff;padding:28px}
    header .wrap,main{width:min(1220px,94vw);margin:0 auto}
    h1{margin:0;font-size:32px}
    header p{margin:8px 0 0;color:#dcfce7;line-height:1.5;max-width:820px}
    main{display:grid;gap:16px;padding:22px 0 42px}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:22px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:15px 18px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:16px;display:grid;gap:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
    .seller,.product{border:1px solid #bbf7d0;background:#f0fdf4;border-radius:18px;padding:14px;display:grid;gap:9px;text-decoration:none;color:#111827}
    .seller:hover,.product:hover{outline:3px solid #86efac}
    .seller b,.product b{color:#064e3b;font-size:18px}
    .seller span,.product span{color:#475569;line-height:1.45}
    .product{background:#fff;border-color:#e5e7eb;overflow:hidden;padding:0}
    .product img,.noimg{width:100%;height:170px;object-fit:cover;background:#e5e7eb}
    .noimg{display:grid;place-items:center;color:#64748b;font-weight:900}
    .pbody{padding:12px;display:grid;gap:7px}
    .price{font-weight:900;color:#064e3b}
    .pill{display:inline-flex;width:fit-content;border-radius:999px;padding:5px 9px;font-weight:900;font-size:12px;background:#dcfce7;color:#166534}
    .warn{background:#fef3c7;color:#92400e}
    .linkbtn,button{border:none;border-radius:14px;background:#064e3b;color:#fff;padding:11px 14px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:fit-content}
    button{background:#16a34a}
    .secondary{background:#111827}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px;line-height:1.5}
    .err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    input{width:100%;border:1px solid #bbf7d0;border-radius:14px;padding:11px;font:inherit}
    footer{padding:20px;text-align:center;color:#64748b}
    @media(max-width:760px){.grid{grid-template-columns:1fr}h1{font-size:27px}}
</style>

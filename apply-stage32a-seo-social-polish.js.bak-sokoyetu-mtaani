function esc(value) {
  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/"/g, "&quot;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function seoBlock(meta) {
  return `
  <!-- SokoYetu Stage 32A SEO start -->
  <title>${esc(meta.title)}</title>
  <meta name="description" content="${esc(meta.description)}">
  <link rel="canonical" href="${esc(meta.url)}">
  <meta property="og:site_name" content="SokoYetu">
  <meta property="og:title" content="${esc(meta.title)}">
  <meta property="og:description" content="${esc(meta.description)}">
  <meta property="og:type" content="${esc(meta.type)}">
  <meta property="og:url" content="${esc(meta.url)}">
  <meta property="og:image" content="${esc(defaultImage)}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="${esc(meta.title)}">
  <meta name="twitter:description" content="${esc(meta.description)}">
  <meta name="theme-color" content="#16a34a">
  <!-- SokoYetu Stage 32A SEO end -->`;
}

function applySeo(fileName, meta) {
  const filePath = path.join(root, fileName);
  if (!fs.existsSync(filePath)) {
    console.log("Skipped missing public page:", fileName);
    return false;
  }

  backup(filePath, fileName.replace(/[^a-z0-9]/gi, "-"));

  let html = fs.readFileSync(filePath, "utf8");
  const before = html;
  const block = seoBlock(meta);

  html = html.replace(/<!-- SokoYetu Stage 32A SEO start -->[\s\S]*?<!-- SokoYetu Stage 32A SEO end -->/g, "");

  // Remove only the first simple static title/meta description/canonical to avoid duplicate basics.
  html = html.replace(/<title>[\s\S]*?<\/title>/i, "");
  html = html.replace(/<meta\s+name=["']description["'][^>]*>/i, "");
  html = html.replace(/<link\s+rel=["']canonical["'][^>]*>/i, "");

  if (html.includes("<head>")) {
    html = html.replace("<head>", "<head>" + block);
  } else {
    html = block + "\n" + html;
  }

  if (html !== before) {
    fs.writeFileSync(filePath, html, "utf8");
    console.log("SEO metadata applied:", fileName);
    return true;
  }

  console.log("SEO metadata already current:", fileName);
  return false;
}


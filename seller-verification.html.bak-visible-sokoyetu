<!doctype html>
<html lang="en">
<head>
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="googlebot" content="noindex,nofollow,noarchive">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Seller Verification Dashboard</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#111827,#16a34a);color:white;padding:24px}
    header .wrap,main{width:min(1220px,94vw);margin:0 auto}
    h1{margin:0;font-size:28px}
    header p{margin:7px 0 0;color:#dcfce7}
    main{display:grid;gap:16px;padding:20px 0 36px}
    .card{background:white;border:1px solid #e5e7eb;border-radius:22px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:15px 18px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:16px;display:grid;gap:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
    label{font-weight:900;color:#064e3b}
    input,select,textarea{width:100%;border:1px solid #bbf7d0;border-radius:14px;padding:11px;font:inherit}
    textarea{min-height:75px;resize:vertical}
    button,.linkbtn{border:none;border-radius:14px;background:#16a34a;color:white;padding:11px 14px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:fit-content}
    button.secondary{background:#111827}
    .linkbtn{background:#064e3b}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px;line-height:1.5}
    .err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    .ok{background:#ecfdf5;border:1px solid #86efac;color:#047857;border-radius:16px;padding:12px;line-height:1.5}
    .sellers{display:grid;gap:14px}
    .seller{border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;background:#fff}
    .sellerTop{display:grid;grid-template-columns:1fr auto;gap:12px;padding:14px;background:#f8fafc;border-bottom:1px solid #e5e7eb}
    .sellerBody{padding:14px;display:grid;gap:12px}
    .title{font-weight:900}
    .muted{color:#64748b;font-size:13px}
    .pill{display:inline-flex;border-radius:999px;padding:5px 9px;font-weight:900;font-size:12px;margin:2px;background:#dcfce7;color:#166534}
    .warn{background:#fef3c7;color:#92400e}
    .bad{background:#fee2e2;color:#991b1b}
    table{width:100%;border-collapse:collapse;font-size:13px}
    th,td{border-bottom:1px solid #e5e7eb;padding:8px;text-align:left;vertical-align:top}
    th{background:#f1f5f9}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    @media(max-width:800px){.sellerTop{grid-template-columns:1fr}table{font-size:12px}}
  </style>
</head>
<body>
<header>
  <div class="wrap">
    <h1>SokoYetu Seller Verification Dashboard</h1>
    <p>Review sellers, product activity and soft-launch verification risk before approving sellers operationally.</p>
  </div>
</header>

<main>
  <a class="linkbtn" href="/">← Back to shop</a>

  <section class="card">
    <div class="head">Admin access and filters</div>
    <div class="body">
      <div class="grid">
        <div>
          <label>Seller verification token</label>
          <input id="token" type="password" placeholder="Paste SELLER_VERIFICATION_TOKEN">
        </div>
        <div>
          <label>Seller filter</label>
          <select id="filter">
            <option value="">All sellers</option>
            <option value="with-products">Sellers with products</option>
            <option value="without-products">Sellers without products</option>
            <option value="risk-review">Needs risk review</option>
          </select>
        </div>
        <div>
          <label>Search</label>
          <input id="searchBox" placeholder="Name, email, phone">
        </div>
      </div>
      <div class="actions">
        <button id="loadBtn" type="button">Load sellers</button>
        <button id="refreshBtn" class="secondary" type="button">Refresh</button>
      </div>
      <div class="note">This dashboard is a soft-launch verification tool. It does not yet block seller login automatically; admin still controls approval operationally.</div>
      <div id="message"></div>
    </div>
  </section>

  <section class="card">
    <div class="head">Sellers</div>
    <div class="body">
      <div id="summary" class="note">No sellers loaded yet.</div>
      <div id="sellers" class="sellers"></div>
    </div>
  </section>
</main>

<script>
let sellerList = [];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }

function riskClass(level){
  if (level === "HIGH") return "pill bad";
  if (level === "MEDIUM") return "pill warn";
  return "pill";
}

async function api(url, options={}){
  const response = await fetch(url, {
    credentials: "include",
    headers: {"Content-Type": "application/json", "x-seller-verification-token": token(), ...(options.headers || {})},
    ...options
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.message || "Request failed.");
  return data;
}

function buildUrl(){
  const params = new URLSearchParams();
  const filter = document.getElementById("filter").value;
  const q = document.getElementById("searchBox").value.trim();
  if (filter) params.set("filter", filter);
  if (q) params.set("q", q);
  return "/api/admin/sellers/verification" + (params.toString() ? "?" + params.toString() : "");
}

async function loadSellers(){
  if (!token()) {
    msg('<div class="err">Seller verification token is required.</div>');
    return;
  }

  msg('<div class="note">Loading sellers...</div>');

  try {
    const data = await api(buildUrl());
    sellerList = data.sellers || [];
    renderSellers();
    msg('<div class="ok">Sellers loaded successfully.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not load sellers.") + '</div>');
  }
}

function renderSellers(){
  const wrap = document.getElementById("sellers");
  const summary = document.getElementById("summary");

  if (!sellerList.length) {
    summary.textContent = "No sellers found for this filter.";
    wrap.innerHTML = "";
    return;
  }

  const withProducts = sellerList.filter(s => Number(s.productCount || 0) > 0).length;
  const riskReview = sellerList.filter(s => s.riskLevel !== "LOW").length;

  summary.innerHTML = '<b>' + sellerList.length + '</b> sellers loaded. <b>' + withProducts + '</b> have products. <b>' + riskReview + '</b> need review.';

  wrap.innerHTML = sellerList.map(seller => {
    const products = (seller.products || []).map(product => {
      return '<tr><td>' + esc(product.name) + '</td><td>' + esc(product.category || "-") + '</td><td>KES ' + Number(product.price || 0).toLocaleString("en-KE") + '</td><td>' + esc(product.stock ?? "-") + '</td><td>' + (product.imageUrl ? "Yes" : "No") + '</td></tr>';
    }).join("") || '<tr><td colspan="5">No products found for this seller.</td></tr>';

    const issues = (seller.issues || []).map(issue => '<span class="pill warn">' + esc(issue) + '</span>').join("") || '<span class="pill">No immediate risk flags</span>';

    return '<article class="seller">' +
      '<div class="sellerTop">' +
        '<div>' +
          '<div class="title">' + esc(seller.name || "Unnamed seller") + ' · Seller #' + seller.id + '</div>' +
          '<div class="muted">' + esc(seller.email || "-") + ' · ' + esc(seller.phone || "-") + '</div>' +
        '</div>' +
        '<div>' +
          '<span class="' + riskClass(seller.riskLevel) + '">' + esc(seller.riskLevel) + ' RISK</span>' +
          '<span class="pill">' + esc(seller.productCount) + ' products</span>' +
        '</div>' +
      '</div>' +
      '<div class="sellerBody">' +
        '<div><b>Review flags</b><br>' + issues + '</div>' +
        '<div><b>Products</b><table><thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Image</th></tr></thead><tbody>' + products + '</tbody></table></div>' +
        '<div class="grid">' +
          '<div><label>Operational decision</label><select id="decision-' + seller.id + '">' +
            '<option value="APPROVED">Approve for soft launch</option>' +
            '<option value="MORE_INFO">Request more information</option>' +
            '<option value="HOLD">Hold for review</option>' +
            '<option value="SUSPEND">Suspend operationally</option>' +
            '<option value="REJECT">Reject</option>' +
          '</select></div>' +
          '<div><label>Admin note</label><textarea id="note-' + seller.id + '" placeholder="Example: Contact details confirmed. Seller needs clearer product photos."></textarea></div>' +
        '</div>' +
        '<div class="actions"><button type="button" onclick="saveSellerDecision(' + seller.id + ')">Save decision note</button></div>' +
        '<div class="muted">Note: In this safe version, decisions are recorded in server logs only. Full persistent seller verification requires a later database migration.</div>' +
      '</div>' +
    '</article>';
  }).join("");
}

async function saveSellerDecision(sellerId){
  const decision = document.getElementById("decision-" + sellerId).value;
  const note = document.getElementById("note-" + sellerId).value.trim();

  try {
    msg('<div class="note">Saving seller decision note...</div>');
    await api("/api/admin/sellers/" + sellerId + "/verification-note", {
      method: "POST",
      body: JSON.stringify({ decision, note })
    });
    msg('<div class="ok">Seller decision note recorded in server logs. Persistent approval will be added in the next database-backed seller verification stage.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not save seller decision.") + '</div>');
  }
}

document.getElementById("loadBtn").onclick = loadSellers;
document.getElementById("refreshBtn").onclick = loadSellers;
window.saveSellerDecision = saveSellerDecision;
</script>

<!-- SokoYetu internal operations page: noindex/nofollow enabled in Stage 30C -->
</body>
</html>
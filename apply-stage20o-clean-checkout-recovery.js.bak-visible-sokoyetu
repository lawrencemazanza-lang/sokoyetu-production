if (app.includes("SokoYetu Stage 20O: Clean Checkout Recovery")) {
  console.log("No change needed. Stage 20O clean checkout recovery is already installed.");
  process.exit(0);
}

const backupPath = appPath + ".backup-stage20o-clean-checkout-recovery-" + Date.now();
fs.copyFileSync(appPath, backupPath);

function removeBlockByMarker(source, marker) {
  let removed = 0;

  while (source.includes(marker)) {
    const markerIndex = source.indexOf(marker);
    let blockStart = source.lastIndexOf("// ================================", markerIndex);
    if (blockStart === -1) blockStart = markerIndex;

    let nextBlock = source.indexOf("\n// ================================", markerIndex + marker.length);
    if (nextBlock === -1) nextBlock = source.length;

    source = source.slice(0, blockStart).trimEnd() + "\n\n" + source.slice(nextBlock).trimStart();
    removed += 1;
  }

  return { source, removed };
}

const markersToRemove = [
  "SokoYetu Stage 20F: Render Cart Sync Fix",
  "SokoYetu Stage 20G: Cart Modal Stability Fix",
  "SokoYetu Stage 20I: Customer Cart and Checkout Panel",
  "SokoYetu Stage 20J: Green Checkout and Robust Product ID Fix",
  "SokoYetu Stage 20K: Stop Payment Button Product ID Error",
  "SokoYetu Stage 20L: Payment Button Isolation Fix",
  "SokoYetu Stage 20M Dedicated Checkout Launcher",
  "SokoYetu Stage 20N: Force Dedicated Checkout Page"
];

let totalRemoved = 0;
for (const marker of markersToRemove) {
  const result = removeBlockByMarker(app, marker);
  app = result.source;
  totalRemoved += result.removed;
}

// Add a light, non-looping checkout launcher that will not freeze the page.
app += `


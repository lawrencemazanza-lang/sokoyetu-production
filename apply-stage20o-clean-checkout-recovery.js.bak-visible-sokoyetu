// Removes heavy modal-sync behaviour and uses a simple dedicated checkout link.
// ================================
(function initStage20OCleanCheckoutRecovery() {
  if (window.__sokoyetuStage20OInstalled) return;
  window.__sokoyetuStage20OInstalled = true;

  function goToCheckout() {
    window.location.href = "/checkout.html";
  }

  function ensureCheckoutButton() {
    if (!document.getElementById("syStage20OCheckoutStyle")) {
      var style = document.createElement("style");
      style.id = "syStage20OCheckoutStyle";
      style.textContent =
        "#syStage20OCheckoutBtn{position:fixed;right:18px;bottom:22px;z-index:19000;border:none;border-radius:999px;background:linear-gradient(135deg,#16a34a,#064e3b);color:#fff;font-weight:900;padding:13px 17px;box-shadow:0 18px 45px rgba(15,23,42,.28);cursor:pointer}" +
        "#syCustomerCartBackdrop,.sy-customer-cart-backdrop{display:none!important;visibility:hidden!important;pointer-events:none!important}" +
        "#syCustomerCartLauncher{display:none!important;visibility:hidden!important;pointer-events:none!important}" +
        "@media(max-width:720px){#syStage20OCheckoutBtn{right:10px;bottom:14px;padding:11px 13px;font-size:13px}}";
      document.head.appendChild(style);
    }

    var oldBackdrop = document.getElementById("syCustomerCartBackdrop");
    if (oldBackdrop) oldBackdrop.remove();

    var oldLauncher = document.getElementById("syCustomerCartLauncher");
    if (oldLauncher) oldLauncher.remove();

    var button = document.getElementById("syStage20OCheckoutBtn");
    if (!button) {
      button = document.createElement("button");
      button.id = "syStage20OCheckoutBtn";
      button.type = "button";
      button.textContent = "✅ Secure Checkout";
      button.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();
        goToCheckout();
      });
      document.body.appendChild(button);
    }
  }

  function isCheckoutNavigation(element) {
    if (!element) return false;

    var text = String(element.textContent || "").toLowerCase().trim();
    var id = String(element.id || "").toLowerCase();
    var className = String(element.className || "").toLowerCase();

    if (text.includes("add to cart")) return false;
    if (text.includes("send m-pesa")) return false;
    if (text.includes("stk push")) return false;

    return (
      id === "systage20ocheckoutbtn" ||
      text === "cart" ||
      text.includes("cart / checkout") ||
      text.includes("secure checkout") ||
      text.includes("view cart") ||
      text === "checkout" ||
      className.includes("checkout")
    );
  }

  document.addEventListener("click", function (event) {
    var clicked = event.target && event.target.closest ? event.target.closest("button, a, [role='button']") : null;
    if (!clicked || !isCheckoutNavigation(clicked)) return;

    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();
    goToCheckout();
  }, true);

  document.addEventListener("DOMContentLoaded", ensureCheckoutButton);
  if (document.readyState !== "loading") {
    ensureCheckoutButton();
  }

  window.sokoyetuGoToCheckout = goToCheckout;
})();
`;


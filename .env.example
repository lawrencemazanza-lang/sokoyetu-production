# SokoYetu environment example
# Copy this file to .env and fill real values before running.

# Server
PORT=5173
JWT_SECRET="change_this_to_a_long_random_secret_before_launch"

# Database
# Local SQLite development:
DATABASE_URL="file:./dev.db"

# Later production PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# M-PESA
# Use demo while testing locally. Use daraja only when real/sandbox credentials are ready.
MPESA_MODE="demo"
MPESA_ENV="sandbox"
MPESA_SHORTCODE="174379"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""

# Real Daraja callbacks need a public URL, not localhost.
MPESA_CALLBACK_URL="http://localhost:5173/api/payments/mpesa/callback"

# Uploads
UPLOAD_MODE="local"
# Later production examples:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

<script>
let orderList = [];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
function statusClass(status){
  const s = String(status || "").toUpperCase();
  if (s.includes("FAILED") || s.includes("CANCELLED")) return "pill bad";
  if (s.includes("PENDING") || s.includes("REFUND_REQUESTED")) return "pill warn";
  return "pill";
}
async function api(url, options={}){
  const response = await fetch(url, {
    credentials: "include",
    headers: {"Content-Type": "application/json", "x-admin-order-token": token(), ...(options.headers || {})},
    ...options
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.message || "Request failed.");
  return data;
}
function buildUrl(){
  const params = new URLSearchParams();
  const status = document.getElementById("statusFilter").value;
  const q = document.getElementById("searchBox").value.trim();
  if (status) params.set("status", status);
  if (q) params.set("q", q);
  return "/api/admin/orders/ops" + (params.toString() ? "?" + params.toString() : "");
}
async function loadOrders(){
  if (!token()) { msg('<div class="err">Admin order token is required.</div>'); return; }
  msg('<div class="note">Loading orders...</div>');
  try {
    const data = await api(buildUrl());
    orderList = data.orders || [];
    renderOrders();
    msg('<div class="ok">Orders loaded successfully.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not load orders.") + '</div>');
  }
}
function renderOrders(){
  const wrap = document.getElementById("orders");
  const summary = document.getElementById("summary");
  if (!orderList.length) {
    summary.textContent = "No orders found for this filter.";
    wrap.innerHTML = "";
    return;
  }
  const totalValue = orderList.reduce((sum, order) => sum + Number(order.totalAmount || 0), 0);
  summary.innerHTML = '<b>' + orderList.length + '</b> orders loaded. Total listed value: <b>' + money(totalValue) + '</b>.';

  wrap.innerHTML = orderList.map(order => {
    const items = (order.items || []).map(item => {
      const product = item.product || {};
      return '<tr><td>' + esc(product.name || ("Product #" + item.productId)) + '</td><td>' + esc(item.quantity) + '</td><td>' + money(item.price) + '</td><td>' + money(Number(item.price || 0) * Number(item.quantity || 0)) + '</td></tr>';
    }).join("");
    const tracking = (order.tracking || []).map(t => {
      const date = t.createdAt ? new Date(t.createdAt).toLocaleString() : "";
      return '<div class="muted">• ' + esc(t.status) + ' — ' + esc(t.note || "") + ' <small>(' + esc(date) + ')</small></div>';
    }).join("") || '<div class="muted">No tracking notes yet.</div>';
    const payment = order.payment || {};
    return '<article class="order">' +
      '<div class="orderTop"><div><div class="title">Order #' + order.id + ' · ' + esc(order.user?.email || "Customer") + '</div><div class="muted">Phone: ' + esc(order.phone || payment.phone || "-") + ' · Created: ' + esc(order.createdAt ? new Date(order.createdAt).toLocaleString() : "-") + '</div></div><div><span class="' + statusClass(order.orderStatus) + '">' + esc(order.orderStatus) + '</span><span class="' + statusClass(order.paymentStatus) + '">' + esc(order.paymentStatus) + '</span></div></div>' +
      '<div class="orderBody">' +
        '<div class="grid"><div><b>Total</b><br>' + money(order.totalAmount) + '</div><div><b>Delivery Fee</b><br>' + money(order.deliveryFee) + '</div><div><b>Payment</b><br>' + esc(payment.status || order.paymentStatus || "-") + '</div><div><b>M-PESA Receipt</b><br>' + esc(payment.mpesaReceipt || "-") + '</div></div>' +
        '<div><b>Delivery Address</b><br><span class="muted">' + esc(order.deliveryAddress || "-") + '</span></div>' +
        '<div><b>Checkout Request ID</b><br><span class="muted">' + esc(payment.checkoutRequestId || "-") + '</span></div>' +
        '<div><b>Items</b><table><thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>' + items + '</tbody></table></div>' +
        '<div><b>Tracking notes</b>' + tracking + '</div>' +
        '<div class="grid"><div><label>New order status</label><select id="status-' + order.id + '"><option value="PENDING_PAYMENT">Pending Payment</option><option value="PAID">Paid</option><option value="PROCESSING">Processing</option><option value="READY_FOR_DELIVERY">Ready for Delivery</option><option value="OUT_FOR_DELIVERY">Out for Delivery</option><option value="DELIVERED">Delivered</option><option value="FAILED_PAYMENT">Failed Payment</option><option value="CANCELLED">Cancelled</option><option value="REFUND_REQUESTED">Refund Requested</option><option value="REFUNDED">Refunded</option></select></div><div><label>Admin note</label><textarea id="note-' + order.id + '" placeholder="Example: Seller confirmed stock and delivery scheduled."></textarea></div></div>' +
        '<div class="actions"><button type="button" onclick="updateOrderStatus(' + order.id + ')">Update status</button></div>' +
      '</div>' +
    '</article>';
  }).join("");

  orderList.forEach(order => {
    const select = document.getElementById("status-" + order.id);
    if (select) select.value = order.orderStatus || "PENDING_PAYMENT";
  });
}
async function updateOrderStatus(orderId){
  const status = document.getElementById("status-" + orderId).value;
  const note = document.getElementById("note-" + orderId).value.trim();
  if (!status) { msg('<div class="err">Select an order status.</div>'); return; }
  try {
    msg('<div class="note">Updating order #' + orderId + '...</div>');
    await api("/api/admin/orders/" + orderId + "/status", { method: "POST", body: JSON.stringify({ orderStatus: status, note }) });
    msg('<div class="ok">Order #' + orderId + ' updated.</div>');
    await loadOrders();
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not update order.") + '</div>');
  }
}
document.getElementById("loadBtn").onclick = loadOrders;
document.getElementById("refreshBtn").onclick = loadOrders;
window.updateOrderStatus = updateOrderStatus;
</script>

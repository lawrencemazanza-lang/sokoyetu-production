/* SokoYetu Stage 37F: themed flash sale and shopping cart logo */
const SOKO37F_THEMES = [
  {key:"electronics", match:/phone|tablet|electronic|earbud|watch|gadget|charger|audio|smart/i, bg:"linear-gradient(135deg,#0f172a 0%,#2563eb 52%,#22d3ee 100%)"},
  {key:"computing", match:/laptop|computer|hp|dell|lenovo|macbook|keyboard|mouse|printer/i, bg:"linear-gradient(135deg,#111827 0%,#7c3aed 52%,#f97316 100%)"},
  {key:"fashion", match:/fashion|shoe|sneaker|bag|dress|shirt|clothing|wear|backpack/i, bg:"linear-gradient(135deg,#831843 0%,#ec4899 50%,#f97316 100%)"},
  {key:"home", match:/home|kitchen|blender|kettle|rack|furniture|storage|office|appliance/i, bg:"linear-gradient(135deg,#14532d 0%,#16a34a 48%,#facc15 100%)"},
  {key:"beauty", match:/beauty|care|skin|hair|makeup|cream|cosmetic/i, bg:"linear-gradient(135deg,#7e22ce 0%,#ec4899 50%,#fda4af 100%)"},
  {key:"groceries", match:/coffee|grocery|groceries|food|drink|supermarket|tea|honey/i, bg:"linear-gradient(135deg,#713f12 0%,#d97706 52%,#facc15 100%)"},
  {key:"gaming", match:/game|gaming|headset|console|pad/i, bg:"linear-gradient(135deg,#020617 0%,#7c3aed 52%,#ef4444 100%)"},
  {key:"default", match:/.*/, bg:"linear-gradient(135deg,#064e3b 0%,#16a34a 50%,#f68b1e 100%)"}
];

function getSoko37FTheme(product, index){
  const hay = String((product && (product.category + " " + product.name)) || "");
  const theme = SOKO37F_THEMES.find(t => t.match.test(hay)) || SOKO37F_THEMES[SOKO37F_THEMES.length - 1];
  const rotate = [
    theme.bg,
    "linear-gradient(135deg,#1e293b 0%,#0ea5e9 52%,#22c55e 100%)",
    "linear-gradient(135deg,#7c2d12 0%,#ea580c 50%,#facc15 100%)",
    "linear-gradient(135deg,#312e81 0%,#7c3aed 50%,#f97316 100%)"
  ];
  return rotate[index % rotate.length];
}

function miniProductCard(p, index){
  const bg = getSoko37FTheme(p, index || 0);
  return "<a class='soko37e-product-mini soko37f-theme-card' style='background:" + bg + "' href='/product-detail.html?id=" + esc(p.id) + "'><div class='soko37e-product-mini-img'>" + imageHtml(p) + "</div><div><b>" + esc(p.name) + "</b><strong>" + money(p.price) + "</strong><small>Flash Sale</small></div></a>";
}

function productCard(p, index){
  const d = discount(p);
  const old = d ? "<span class='soko37e-old'>" + money(p.oldPrice) + "</span>" : "";
  const disc = d ? "<span class='soko37e-disc'>-" + d + "%</span>" : "";
  return "<article class='soko37e-product'><a href='/product-detail.html?id=" + esc(p.id) + "'><div class='soko37e-img'>" + imageHtml(p) + "</div></a><div class='soko37e-prod-body'>" + disc + "<div class='soko37e-prod-name'>" + esc(p.name) + "</div><div><span class='soko37e-price'>" + money(p.price) + "</span> " + old + "</div><button class='soko37e-cart' onclick='addProductToCart(" + JSON.stringify(p.id) + ")'>Add to cart</button></div></article>";
}

function renderLiveProduct(products){
  let index = 0;
  const liveCard = document.getElementById("soko37eLiveProduct");
  const liveImage = document.getElementById("soko37eLiveImage");
  const liveName = document.getElementById("soko37eLiveName");
  const liveMeta = document.getElementById("soko37eLiveMeta");
  const livePrice = document.getElementById("soko37eLivePrice");
  const liveOld = document.getElementById("soko37eLiveOld");
  const liveCart = document.getElementById("soko37eLiveCart");
  const liveWhatsApp = document.getElementById("soko37eLiveWhatsApp");

  function show(){
    const p = products[index % products.length];
    liveCard.classList.add("soko37f-theme-live");
    liveCard.style.background = getSoko37FTheme(p, index);
    liveImage.innerHTML = imageHtml(p);
    liveName.textContent = p.name;
    liveMeta.textContent = (p.category || "Flash Sale") + " · " + (p.stock ? p.stock + " available" : "Limited stock");
    livePrice.textContent = money(p.price);
    liveOld.textContent = p.oldPrice && p.oldPrice > p.price ? money(p.oldPrice) : "";
    liveCart.onclick = function(){ addProductToCart(p.id); };
    liveWhatsApp.href = "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent("Hello SokoYetu, I am interested in " + p.name);
    index += 1;
  }
  show();
  setInterval(show, 3200);
}
`;


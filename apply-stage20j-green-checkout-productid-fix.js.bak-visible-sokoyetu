const fs = require("fs");
const path = require("path");

const root = process.cwd();
const appPath = path.join(root, "app.js");

if (!fs.existsSync(appPath)) {
  console.error("ERROR: app.js was not found. Run this inside your SokoYetu project folder.");
  process.exit(1);
}

let code = fs.readFileSync(appPath, "utf8");

if (code.includes("SokoYetu Stage 20J: Green Checkout and Robust Product ID Fix")) {
  console.log("No change needed. Stage 20J is already installed.");
  process.exit(0);
}

const backupPath = appPath + ".backup-stage20j-green-checkout-productid-" + Date.now();
fs.copyFileSync(appPath, backupPath);

const patch = `

// ================================
// SokoYetu Stage 20J: Green Checkout and Robust Product ID Fix
// Makes the customer M-PESA checkout panel green and fixes Add to Cart buttons that have no productId.
// ================================
(function initStage20JGreenCheckoutAndProductIdFix() {
  if (window.__sokoyetuStage20JInstalled) return;
  window.__sokoyetuStage20JInstalled = true;

  var productsCache = [];
  var loadingProducts = false;

  function normalizeText(value) {
    return String(value || "").toLowerCase().replace(/\\s+/g, " ").trim();
  }

  function money(value) {
    return "KES " + Number(value || 0).toLocaleString("en-KE");
  }

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  async function loadProducts() {
    if (loadingProducts) return productsCache;
    loadingProducts = true;

    try {
      var response = await fetch("/api/products", {
        credentials: "include",
        headers: { "Accept": "application/json" }
      });

      var data = await response.json().catch(function () { return {}; });
      var products = Array.isArray(data) ? data : data.products;

      if (Array.isArray(products)) {
        productsCache = products.filter(function (product) {
          return product && product.id && product.name;
        });
      }

      attachProductIdsToButtons();
      return productsCache;
    } catch (error) {
      console.warn("Stage 20J could not load products:", error);
      return productsCache;
    } finally {
      loadingProducts = false;
    }
  }

  function isAddToCartButton(element) {
    if (!element) return false;

    var text = normalizeText(element.textContent);
    var id = normalizeText(element.id);
    var className = normalizeText(element.className);
    var aria = normalizeText(element.getAttribute && element.getAttribute("aria-label"));
    var title = normalizeText(element.getAttribute && element.getAttribute("title"));

    return (
      text.includes("add to cart") ||
      text.includes("add cart") ||
      aria.includes("add to cart") ||
      title.includes("add to cart") ||
      id.includes("addtocart") ||
      id.includes("add-to-cart") ||
      className.includes("add-to-cart") ||
      className.includes("cart-btn")
    );
  }

  function readProductId(element) {
    if (!element) return null;

    var values = [
      element.dataset && element.dataset.productId,
      element.dataset && element.dataset.id,
      element.getAttribute && element.getAttribute("data-product-id"),
      element.getAttribute && element.getAttribute("data-id"),
      element.getAttribute && element.getAttribute("product-id"),
      element.getAttribute && element.getAttribute("productid")
    ];

    var closest = element.closest && element.closest("[data-product-id], [data-id], [product-id], [productid]");
    if (closest) {
      values.push(
        closest.dataset && closest.dataset.productId,
        closest.dataset && closest.dataset.id,
        closest.getAttribute("data-product-id"),
        closest.getAttribute("data-id"),
        closest.getAttribute("product-id"),
        closest.getAttribute("productid")
      );
    }

    for (var i = 0; i < values.length; i++) {
      var id = Number(values[i]);
      if (Number.isInteger(id) && id > 0) return id;
    }

    return null;
  }

  function findNearbyCard(element) {
    if (!element) return null;

    var card =
      (element.closest && element.closest(".product-card, .product, .card, article, li, [class*='product'], [class*='item']")) ||
      element.parentElement;

    if (card) return card;

    return null;
  }

  function findProductByCardText(element) {
    var card = findNearbyCard(element);
    if (!card || !productsCache.length) return null;

    var cardText = normalizeText(card.textContent);
    var best = null;

    productsCache.forEach(function (product) {
      var name = normalizeText(product.name);
      var price = String(Number(product.price || 0));
      var priceWithComma = Number(product.price || 0).toLocaleString("en-KE");

      var score = 0;

      if (name && cardText.includes(name)) score += 100;
      if (product.category && cardText.includes(normalizeText(product.category))) score += 10;
      if (price && cardText.includes(price)) score += 8;
      if (priceWithComma && cardText.includes(priceWithComma)) score += 8;

      // Partial name match for cards that split product title into spans.
      name.split(" ").forEach(function (part) {
        if (part.length >= 4 && cardText.includes(part)) score += 3;
      });

      if (!best || score > best.score) {
        best = { product: product, score: score };
      }
    });

    if (best && best.score >= 12) {
      card.dataset.productId = String(best.product.id);
      if (element.dataset) element.dataset.productId = String(best.product.id);
      return Number(best.product.id);
    }

    // If only one visible product card has an add button and only one product exists, use it.
    if (productsCache.length === 1) {
      if (element.dataset) element.dataset.productId = String(productsCache[0].id);
      return Number(productsCache[0].id);
    }

    return null;
  }

  function attachProductIdsToButtons() {
    if (!productsCache.length) return;

    var buttons = Array.from(document.querySelectorAll("button, a, [role='button']"))
      .filter(isAddToCartButton);

    buttons.forEach(function (button) {
      if (readProductId(button)) return;
      findProductByCardText(button);
    });
  }

  async function addToCart(productId) {
    var id = Number(productId);

    if (!Number.isInteger(id) || id <= 0) {
      throw new Error("Product ID is required.");
    }

    var response = await fetch("/api/cart", {
      method: "POST",
      credentials: "include",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ productId: id, quantity: 1 })
    });

    var data = await response.json().catch(function () { return {}; });

    if (!response.ok) {
      throw new Error(data.message || "Could not add product to cart.");
    }

    return data;
  }

  function showGreenMessage(message) {
    var existing = document.getElementById("syStage20JGreenMessage");

    if (!existing) {
      existing = document.createElement("div");
      existing.id = "syStage20JGreenMessage";
      existing.style.position = "fixed";
      existing.style.top = "12px";
      existing.style.left = "50%";
      existing.style.transform = "translateX(-50%)";
      existing.style.zIndex = "16000";
      existing.style.maxWidth = "min(560px, 94vw)";
      existing.style.border = "1px solid #86efac";
      existing.style.background = "#dcfce7";
      existing.style.color = "#166534";
      existing.style.padding = "12px 16px";
      existing.style.borderRadius = "16px";
      existing.style.fontWeight = "900";
      existing.style.boxShadow = "0 18px 45px rgba(15,23,42,.18)";
      document.body.appendChild(existing);
    }

    existing.textContent = message;
    existing.style.display = "block";

    setTimeout(function () {
      existing.style.display = "none";
    }, 3600);
  }

  function injectGreenCheckoutStyles() {
    if (document.getElementById("syStage20JGreenCheckoutStyles")) return;

    var style = document.createElement("style");
    style.id = "syStage20JGreenCheckoutStyles";
    style.textContent =
      ".sy-customer-cart-head{background:linear-gradient(135deg,#064e3b,#16a34a)!important;color:#fff!important}" +
      ".sy-cart-btn{background:#16a34a!important;color:#fff!important}" +
      ".sy-cart-btn.secondary{background:#064e3b!important;color:#fff!important}" +
      ".sy-checkout-form{background:#ecfdf5!important;border-color:#86efac!important}" +
      ".sy-checkout-form input,.sy-checkout-form textarea{border-color:#86efac!important}" +
      ".sy-cart-summary{background:#f0fdf4!important;border-color:#bbf7d0!important}" +
      ".sy-cart-row{background:#f0fdf4!important;border-color:#bbf7d0!important}" +
      ".sy-customer-cart-launcher{background:linear-gradient(135deg,#16a34a,#064e3b)!important}" +
      ".sy-cart-msg.ok{background:#dcfce7!important;color:#166534!important;border-color:#86efac!important}" +
      ".sy-cart-msg.err{background:#fef2f2!important;color:#b91c1c!important;border-color:#fecaca!important}";
    document.head.appendChild(style);
  }

  // Capture Add to Cart before older handlers show Product ID required.
  document.addEventListener("click", async function (event) {
    var clicked = event.target && event.target.closest ? event.target.closest("button, a, [role='button']") : null;
    if (!clicked || !isAddToCartButton(clicked)) return;

    await loadProducts();

    var productId = readProductId(clicked) || findProductByCardText(clicked);

    if (!productId) {
      // Let non-product cart buttons continue. Only block real add-to-cart buttons.
      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();
      showGreenMessage("Could not identify this product yet. Refresh once and try again.");
      return;
    }

    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    try {
      await addToCart(productId);
      showGreenMessage("Product added to cart.");
      if (typeof window.sokoyetuSyncCartQuietly === "function") {
        try { await window.sokoyetuSyncCartQuietly(); } catch (error) {}
      }
      if (typeof window.sokoyetuOpenCustomerCartCheckout === "function") {
        setTimeout(function () {
          window.sokoyetuOpenCustomerCartCheckout();
        }, 500);
      }
    } catch (error) {
      showGreenMessage(error.message || "Could not add product to cart.");
    }
  }, true);

  document.addEventListener("DOMContentLoaded", function () {
    injectGreenCheckoutStyles();
    loadProducts();
    setTimeout(attachProductIdsToButtons, 1200);
    setTimeout(attachProductIdsToButtons, 3000);
  });

  var observer = new MutationObserver(function () {
    injectGreenCheckoutStyles();
    attachProductIdsToButtons();
  });

  if (document.body) {
    observer.observe(document.body, { childList: true, subtree: true });
  }

  window.sokoyetuStage20JReloadProducts = loadProducts;
})();
`;

code += patch;

fs.writeFileSync(appPath, code, "utf8");

console.log("SUCCESS: Stage 20J green checkout and product ID fix installed.");
console.log("Backup created:", path.basename(backupPath));
console.log("");
console.log("Next:");
console.log("npm run dev");
console.log("Test locally: Add to Cart should not say product ID required; checkout panel should be green.");
console.log("");
console.log("If it works:");
console.log("git add app.js");
console.log("git commit -m \"Make checkout green and fix product id detection\"");
console.log("git push");

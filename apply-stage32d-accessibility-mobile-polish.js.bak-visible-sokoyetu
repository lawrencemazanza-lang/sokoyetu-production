function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function setMessage(html){ document.getElementById("message").innerHTML = html; }
function pill(kind, text){
  const cls = kind === "ok" ? "pill" : kind === "warn" ? "pill warn" : "pill bad";
  return '<span class="' + cls + '">' + esc(text) + '</span>';
}
async function auditPage(url){
  try {
    const response = await fetch(url, { cache:"no-store", credentials:"include" });
    const html = await response.text();
    const issues = [];
    const notes = [];

    if (!response.ok) issues.push("HTTP " + response.status);
    if (!html.includes('/public-a11y.css')) issues.push("Missing public-a11y.css");
    if (!html.includes('/public-a11y.js')) issues.push("Missing public-a11y.js");

    const parser = new DOMParser();
    const doc = parser.parseFromString(html, "text/html");

    if (!doc.querySelector("h1")) issues.push("Missing h1");
    if (!doc.querySelector("main")) issues.push("Missing main element");
    if (!doc.querySelector("title") || !doc.querySelector("title").textContent.trim()) issues.push("Missing title");

    const images = Array.from(doc.querySelectorAll("img"));
    const missingAlt = images.filter(img => !img.getAttribute("alt")).length;
    if (missingAlt) issues.push(missingAlt + " image(s) missing alt");

    const fields = Array.from(doc.querySelectorAll("input,select,textarea"));
    const unlabelled = fields.filter(field => {
      if (field.getAttribute("aria-label")) return false;
      if (field.closest("label")) return false;
      if (field.id && doc.querySelector('label[for="' + CSS.escape(field.id) + '"]')) return false;
      return true;
    }).length;
    if (unlabelled) issues.push(unlabelled + " form field(s) may lack labels");

    const emptyButtons = Array.from(doc.querySelectorAll("button")).filter(btn => !btn.textContent.trim() && !btn.getAttribute("aria-label")).length;
    if (emptyButtons) issues.push(emptyButtons + " empty button(s)");

    const emptyLinks = Array.from(doc.querySelectorAll("a")).filter(a => !a.textContent.trim() && !a.getAttribute("aria-label")).length;
    if (emptyLinks) issues.push(emptyLinks + " empty link(s)");

    notes.push(images.length + " image(s)");
    notes.push(fields.length + " form field(s)");
    notes.push(doc.querySelectorAll("a").length + " link(s)");

    return { url, ok: issues.length === 0, issues, notes };
  } catch (error) {
    return { url, ok:false, issues:[error.message || "Fetch failed"], notes:[] };
  }
}
async function runAudit(){
  setMessage('<div class="note">Running accessibility audit...</div>');
  document.getElementById("results").innerHTML = '<tr><td colspan="4">Checking...</td></tr>';

  const results = [];
  for (const page of pages) {
    const result = await auditPage(page);
    results.push(result);
    render(results);
  }

  const passed = results.filter(r => r.ok).length;
  const failed = results.length - passed;

  document.getElementById("summary").innerHTML =
    '<div class="metric">Pages checked<b>' + results.length + '</b></div>' +
    '<div class="metric">Passed<b>' + passed + '</b></div>' +
    '<div class="metric">Needs review<b>' + failed + '</b></div>';

  if (failed) {
    setMessage('<div class="warnBox"><b>Audit completed with items to review.</b><br>Fix rows with issues before wider launch testing.</div>');
  } else {
    setMessage('<div class="ok"><b>Audit passed.</b><br>Public pages include the shared accessibility assets and basic markup checks passed.</div>');
  }
}
function render(results){
  document.getElementById("results").innerHTML = results.map(r => {
    return '<tr>' +
      '<td><a href="' + esc(r.url) + '" target="_blank">' + esc(r.url) + '</a></td>' +
      '<td>' + (r.ok ? pill("ok","OK") : pill("warn","REVIEW")) + '</td>' +
      '<td>' + (r.issues.length ? esc(r.issues.join(" | ")) : "None") + '</td>' +
      '<td>' + esc(r.notes.join(" | ")) + '</td>' +
    '</tr>';
  }).join("");
}
document.getElementById("runBtn").onclick = runAudit;

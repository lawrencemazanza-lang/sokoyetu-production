function addA11yAssets(fileName) {
  const filePath = path.join(root, fileName);
  if (!fs.existsSync(filePath)) {
    console.log("Skipped missing page:", fileName);
    return false;
  }

  backup(filePath, fileName.replace(/[^a-z0-9]/gi, "-"));

  let html = fs.readFileSync(filePath, "utf8");
  const before = html;

  if (!html.includes('href="/public-a11y.css"')) {
    if (html.includes("</head>")) {
      html = html.replace("</head>", '  <link rel="stylesheet" href="/public-a11y.css">\n</head>');
    } else {
      html = '<link rel="stylesheet" href="/public-a11y.css">\n' + html;
    }
  }

  if (!html.includes('src="/public-a11y.js"')) {
    if (html.includes("</body>")) {
      html = html.replace("</body>", '  <script src="/public-a11y.js" defer></script>\n</body>');
    } else {
      html += '\n<script src="/public-a11y.js" defer></script>\n';
    }
  }

  if (html !== before) {
    fs.writeFileSync(filePath, html, "utf8");
    console.log("Accessibility assets added:", fileName);
    return true;
  }

  console.log("Accessibility assets already present:", fileName);
  return false;
}


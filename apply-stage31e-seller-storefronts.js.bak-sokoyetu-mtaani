fs.writeFileSync(path.join(root, "seller-stores.html"), `<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="description" content="Browse SokoYetu seller storefronts and discover products grouped by seller.">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Seller Stores</title>
  <style>${sharedCss}</style>
</head>
<body>
<header>
  <div class="wrap">
    <h1>SokoYetu Seller Stores</h1>
    <p>Explore sellers on SokoYetu and view the products currently listed under each seller.</p>
  </div>
</header>

<main>
  <div style="display:flex;gap:10px;flex-wrap:wrap">
    <a class="linkbtn" href="/">← Back to shop</a>
    <a class="linkbtn secondary" href="/categories.html">Browse categories</a>
    <a class="linkbtn secondary" href="/help-center.html">Help Center</a>
  </div>

  <section class="card">
    <div class="head">Find a seller</div>
    <div class="body">
      <input id="searchBox" placeholder="Search seller ID, category, product name">
      <div id="message" class="note">Loading seller stores...</div>
    </div>
  </section>

  <section class="card">
    <div class="head">Seller directory</div>
    <div class="body">
      <div id="sellerList" class="grid"></div>
    </div>
  </section>
</main>

<footer>SokoYetu · Seller stores · mysokoyetu@gmail.com</footer>

<script>
let products = [];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function sellerKey(product){ return String(product.sellerId || "unknown"); }
function sellerName(id){ return id === "unknown" ? "Marketplace seller" : "Seller #" + id; }

async function loadProducts(){
  const message = document.getElementById("message");
  try {
    const res = await fetch("/api/products", { credentials: "include" });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.message || "Could not load products.");
    const raw = Array.isArray(data) ? data : (data.products || data.data || []);
    products = raw.map(p => ({
      id: p.id,
      name: p.name || p.title || "Unnamed product",
      description: p.description || "",
      category: p.category || "Other",
      price: p.price || 0,
      stock: p.stock ?? null,
      imageUrl: p.imageUrl || p.image || p.photoUrl || "",
      sellerId: p.sellerId || "unknown"
    }));
    renderSellers();
    message.className = "note";
    message.textContent = products.length ? "Seller stores loaded successfully." : "No seller products are available yet.";
  } catch (error) {
    message.className = "err";
    message.textContent = error.message || "Could not load seller stores.";
  }
}

function groupedSellers(){
  const q = document.getElementById("searchBox").value.trim().toLowerCase();
  const map = new Map();

  for (const p of products) {
    const searchText = (p.sellerId + " " + p.name + " " + p.category + " " + p.description).toLowerCase();
    if (q && !searchText.includes(q)) continue;
    const key = sellerKey(p);
    if (!map.has(key)) map.set(key, []);
    map.get(key).push(p);
  }

  return Array.from(map.entries()).sort((a,b) => String(a[0]).localeCompare(String(b[0])));
}

function renderSellers(){
  const wrap = document.getElementById("sellerList");
  const sellers = groupedSellers();

  if (!sellers.length) {
    wrap.innerHTML = '<div class="note">No sellers match this search.</div>';
    return;
  }

  wrap.innerHTML = sellers.map(([sellerId, items]) => {
    const categories = Array.from(new Set(items.map(p => p.category || "Other"))).slice(0, 5).join(", ");
    const available = items.filter(p => p.stock === null || Number(p.stock) > 0).length;
    const totalValue = items.reduce((sum, p) => sum + Number(p.price || 0), 0);

    return '<a class="seller" href="/seller-store.html?sellerId=' + encodeURIComponent(sellerId) + '">' +
      '<b>' + esc(sellerName(sellerId)) + '</b>' +
      '<span>' + items.length + ' product(s), ' + available + ' available.</span>' +
      '<span>Categories: ' + esc(categories || "Other") + '</span>' +
      '<span>Listed value: ' + money(totalValue) + '</span>' +
      '<em class="pill">Open seller store</em>' +
    '</a>';
  }).join("");
}

document.getElementById("searchBox").addEventListener("input", renderSellers);
loadProducts();
</script>
</body>
</html>`, "utf8");


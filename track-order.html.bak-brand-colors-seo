<body>
<header>
  <div class="wrap">
    <h1>Track Your Order</h1>
    <p>Use your order number and M-PESA phone number to check the latest order status.</p>
  </div>
</header>

<main>
  <a class="linkbtn" href="/">← Back to shop</a>

  <section class="card">
    <div class="head">Order lookup</div>
    <div class="body">
      <div class="grid">
        <div>
          <label>Order ID</label>
          <input id="orderId" inputmode="numeric" placeholder="Example: 12">
        </div>
        <div>
          <label>M-PESA phone number used at checkout</label>
          <input id="phone" inputmode="tel" placeholder="Example: 254714565555 or 0714565555">
        </div>
      </div>
      <button id="trackBtn" type="button">Track order</button>
      <div class="note">For privacy, order details are shown only when the phone number matches the order or payment record.</div>
      <div id="message"></div>
    </div>
  </section>

  <section id="resultCard" class="card" style="display:none">
    <div class="head">Order status</div>
    <div class="body" id="result"></div>
  </section>
</main>

<script>
function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function msg(html){ document.getElementById("message").innerHTML = html; }
function pillClass(status){
  const s = String(status || "").toUpperCase();
  if (s.includes("FAILED") || s.includes("CANCELLED") || s.includes("REJECT")) return "pill bad";
  if (s.includes("PENDING") || s.includes("REFUND")) return "pill warn";
  return "pill";
}
async function trackOrder(){
  const orderId = document.getElementById("orderId").value.trim();
  const phone = document.getElementById("phone").value.trim();

  if (!orderId || !phone) {
    msg('<div class="err">Enter both order ID and phone number.</div>');
    return;
  }

  msg('<div class="note">Checking order...</div>');
  document.getElementById("resultCard").style.display = "none";

  try {
    const response = await fetch("/api/orders/track", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({ orderId, phone })
    });

    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.message || "Could not track order.");

    renderOrder(data.order);
    msg('<div class="ok">Order loaded successfully.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not track order.") + '</div>');
  }
}
function renderOrder(order){
  const result = document.getElementById("result");
  const items = (order.items || []).map(item => {
    return '<tr><td>' + esc(item.name) + '</td><td>' + esc(item.quantity) + '</td><td>' + money(item.price) + '</td><td>' + money(Number(item.price || 0) * Number(item.quantity || 0)) + '</td></tr>';
  }).join("");

  const tracking = (order.tracking || []).map(t => {
    const date = t.createdAt ? new Date(t.createdAt).toLocaleString() : "";
    return '<div class="event"><b>' + esc(t.status) + '</b><br><span>' + esc(t.note || "Status updated.") + '</span><br><span class="muted">' + esc(date) + '</span></div>';
  }).join("") || '<div class="event"><b>' + esc(order.orderStatus) + '</b><br><span>Your order has been created. Updates will appear here.</span></div>';

  result.innerHTML =
    '<div class="grid">' +
      '<div><b>Order</b><br>#' + esc(order.id) + '</div>' +
      '<div><b>Total</b><br>' + money(order.totalAmount) + '</div>' +
      '<div><b>Order status</b><br><span class="' + pillClass(order.orderStatus) + '">' + esc(order.orderStatus) + '</span></div>' +
      '<div><b>Payment status</b><br><span class="' + pillClass(order.paymentStatus) + '">' + esc(order.paymentStatus) + '</span></div>' +
    '</div>' +
    '<div><b>Delivery address</b><br><span class="muted">' + esc(order.deliveryAddress || "Not provided") + '</span></div>' +
    '<div><b>M-PESA receipt</b><br><span class="muted">' + esc(order.mpesaReceipt || "Not available yet") + '</span></div>' +
    '<div><b>Items</b><table><thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>' + items + '</tbody></table></div>' +
    '<div><b>Tracking timeline</b><div class="timeline">' + tracking + '</div></div>' +
    '<div class="note">Need help? Contact SokoYetu Mtaani@gmail.com with your order number.</div>';

  document.getElementById("resultCard").style.display = "block";
}
document.getElementById("trackBtn").onclick = trackOrder;
</script>

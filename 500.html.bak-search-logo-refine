<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex,nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Temporary Service Issue · SokoYetu Mtaani</title>
  <meta name="description" content="SokoYetu Mtaani is temporarily unable to complete this request. Please retry, return to the shop, or contact support.">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/public-nav.css">
  <link rel="stylesheet" href="/public-a11y.css">
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#064e3b,#16a34a);color:#fff;padding:32px}
    header .wrap,main{width:min(980px,94vw);margin:0 auto}
    h1{margin:0;font-size:34px}
    header p{margin:8px 0 0;color:#dcfce7;line-height:1.5}
    main{display:grid;gap:16px;padding:24px 0 42px}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:22px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .body{padding:18px;display:grid;gap:14px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
    .tile{border:1px solid #bbf7d0;background:#f0fdf4;border-radius:18px;padding:14px;display:grid;gap:8px;text-decoration:none;color:#111827}
    .tile b{color:#064e3b}
    .tile span{color:#475569;line-height:1.45}
    .linkbtn{border:none;border-radius:14px;background:#064e3b;color:#fff;padding:11px 14px;font-weight:900;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:fit-content}
    .secondary{background:#111827}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px;line-height:1.5}
    .code{font-size:72px;font-weight:900;color:#064e3b;line-height:1}
    footer{padding:20px;text-align:center;color:#64748b}
    @media(max-width:760px){.grid{grid-template-columns:1fr}h1{font-size:28px}.code{font-size:56px}}
</style>
  <link rel="stylesheet" href="/sokoyetu-final-brand.css">
</head>
<body>
<header>
  <div class="wrap">
    <div class="code">500</div>
    <h1>Temporary service issue</h1>
    <p>Something went wrong while processing this request. Please retry shortly or use the support links below.</p>
  </div>
</header>
<main id="main-content">
  <section class="card">
    <div class="body">
      <div class="note">If you were checking out or tracking an order, do not repeatedly submit the same action. Wait briefly, then confirm order or payment status.</div>
      <div class="grid">
        <a class="tile" href="/"><b>Return to shop</b><span>Go back to the homepage and continue browsing.</span></a>
        <a class="tile" href="/track-order.html"><b>Track order</b><span>Check whether your order was recorded.</span></a>
        <a class="tile" href="/support-request.html"><b>Submit support request</b><span>Report a payment, product, delivery or refund issue.</span></a>
        <a class="tile" href="/help-center.html"><b>Help Center</b><span>Find customer support and policy links.</span></a>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="linkbtn" href="/">Open shop</a>
        <a class="linkbtn secondary" href="/support-request.html">Get support</a>
      </div>
    </div>
  </section>
</main>
<footer>SokoYetu Mtaani · SokoYetu Mtaani@gmail.com</footer>
<script src="/public-nav.js" defer></script>
<script src="/public-a11y.js" defer></script>
  <script src="/sokoyetu-final-seo.js" defer></script>
</body>
</html>





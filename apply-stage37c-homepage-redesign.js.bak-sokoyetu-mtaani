<script>
const WHATSAPP_NUMBER = "${WHATSAPP_NUMBER}";

function money(value){
  return "KES " + Number(value || 0).toLocaleString("en-KE", { maximumFractionDigits: 0 });
}
function esc(value){
  return String(value ?? "").replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;","\\"":"&quot;","'":"&#39;"}[m]));
}
function normalizeProducts(data){
  const raw = Array.isArray(data) ? data : Array.isArray(data.products) ? data.products : Array.isArray(data.items) ? data.items : [];
  return raw.map((p, index) => ({
    id: p.id || p.productId || index + 1,
    name: p.name || p.title || p.productName || "SokoYetu Product",
    price: Number(p.price || p.amount || p.sellingPrice || 0),
    oldPrice: Number(p.oldPrice || p.compareAtPrice || p.priceBefore || 0),
    imageUrl: p.imageUrl || p.image || p.photoUrl || p.thumbnail || "",
    category: p.category || p.categoryName || "Deal",
    stock: p.stock ?? p.quantity ?? ""
  }));
}
function fallbackProducts(){
  return [
    {id:1,name:"HP Pavilion 15 Laptop",price:45000,oldPrice:52000,category:"Computers",imageUrl:"",stock:6},
    {id:2,name:"Samsung Galaxy Smartphone",price:18500,oldPrice:22000,category:"Phones",imageUrl:"",stock:12},
    {id:3,name:"Wireless Bluetooth Earbuds",price:1800,oldPrice:2500,category:"Electronics",imageUrl:"",stock:20},
    {id:4,name:"Kenyan Coffee Blend 500g",price:1200,oldPrice:1500,category:"Groceries",imageUrl:"",stock:50},
    {id:5,name:"Fashion Sneakers",price:3200,oldPrice:4000,category:"Fashion",imageUrl:"",stock:15},
    {id:6,name:"Kitchen Blender",price:4200,oldPrice:5200,category:"Home",imageUrl:"",stock:8},
    {id:7,name:"Smart Watch",price:3500,oldPrice:4500,category:"Electronics",imageUrl:"",stock:10},
    {id:8,name:"Home Storage Rack",price:2500,oldPrice:3200,category:"Home",imageUrl:"",stock:7}
  ];
}
function productCard(p){
  const old = p.oldPrice && p.oldPrice > p.price ? "<span class='soko-old-price'>" + money(p.oldPrice) + "</span>" : "";
  const img = p.imageUrl ? "<img src='" + esc(p.imageUrl) + "' alt='" + esc(p.name) + "'>" : "<span>🛍️</span>";
  return "<article class='soko-product'><a href='/product-detail.html?id=" + esc(p.id) + "'><div class='soko-product-img'>" + img + "</div></a><div class='soko-product-body'><span class='soko-badge'>" + esc(p.category) + "</span><div class='soko-product-name'>" + esc(p.name) + "</div><div><span class='soko-price'>" + money(p.price) + "</span> " + old + "</div><button onclick='addProductToCart(" + JSON.stringify(p.id) + ")'>Add to cart</button></div></article>";
}
async function addProductToCart(id){
  try{
    const response = await fetch("/api/cart", {method:"POST",credentials:"include",headers:{"Content-Type":"application/json"},body:JSON.stringify({productId:id,quantity:1})});
    if(!response.ok) throw new Error("Cart request failed");
    location.href = "/checkout.html";
  }catch(error){
    location.href = "/product-detail.html?id=" + encodeURIComponent(id);
  }
}
async function loadProducts(){
  let products = [];
  try{
    const response = await fetch("/api/products", {cache:"no-store", credentials:"include"});
    const data = await response.json();
    products = normalizeProducts(data);
  }catch(error){
    products = fallbackProducts();
  }
  if(!products.length) products = fallbackProducts();
  document.getElementById("flashGrid").innerHTML = products.slice(0,4).map(productCard).join("");
  document.getElementById("recommendedGrid").innerHTML = products.slice(4,12).concat(products.slice(0, Math.max(0, 8-products.slice(4,12).length))).slice(0,8).map(productCard).join("");
}
function initOffers(){
  const offers = [
    {pill:"Pickup",title:"Self-pickup available",text:"Choose pickup at checkout and pay KES 0 delivery fee.",link:"/checkout.html"},
    {pill:"Payment",title:"Manual M-PESA ready",text:"Use Buy Goods Till 6923522 when automatic prompt is unavailable.",link:"/checkout.html"},
    {pill:"Sellers",title:"Join SokoYetu",text:"Sellers can contact us on WhatsApp for onboarding.",link:"https://wa.me/" + WHATSAPP_NUMBER},
    {pill:"Deals",title:"Flash sale products",text:"Browse daily deals across electronics, fashion and home.",link:"/categories.html"}
  ];
  let index = 0;
  function render(){
    const offer = offers[index % offers.length];
    document.getElementById("offerPill").textContent = offer.pill;
    document.getElementById("offerTitle").textContent = offer.title;
    document.getElementById("offerText").textContent = offer.text;
    document.getElementById("offerLink").href = offer.link;
    index++;
  }
  render();
  setInterval(render, 4500);
}
document.getElementById("searchForm").addEventListener("submit", event => {
  event.preventDefault();
  const q = document.getElementById("searchInput").value.trim();
  location.href = "/categories.html" + (q ? "?q=" + encodeURIComponent(q) : "");
});
loadProducts();
initOffers();
</script>
</body>
</html>`;


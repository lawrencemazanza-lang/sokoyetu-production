<script>
let lastAudit = null;

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
function pill(kind, text){
  const cls = kind === "ok" ? "pill" : kind === "bad" ? "pill bad" : kind === "warn" ? "pill warn" : "pill info";
  return '<span class="' + cls + '">' + esc(text) + '</span>';
}
function boolPill(value){
  return value ? pill("ok", "OK") : pill("bad", "MISSING");
}
async function runAudit(){
  if (!token()) {
    msg('<div class="err">Admin order token is required.</div>');
    return;
  }

  msg('<div class="note">Running core production readiness audit...</div>');

  try {
    const response = await fetch("/api/admin/core-readiness/audit", {
      headers: { "x-admin-order-token": token() },
      credentials: "include",
      cache: "no-store"
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.message || "Could not run core readiness audit.");
    lastAudit = data;
    renderAudit(data);
    msg('<div class="ok">Core readiness audit completed.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not run core readiness audit.") + '</div>');
  }
}
function listBox(items, empty, bad){
  if (!items || !items.length) return '<div class="ok">' + esc(empty) + '</div>';
  return '<div class="' + (bad ? "badBox" : "warnBox") + '">' + items.map(x => "• " + esc(x)).join("<br>") + '</div>';
}
function renderAudit(data){
  const blockers = data.blockers || [];
  const warnings = data.warnings || [];
  const env = data.environment || {};
  const files = data.fileChecks || [];
  const routes = data.routeChecks || [];
  const db = data.databaseCounts || [];
  const order = data.routeOrder || {};
  const secrets = data.secretScan || [];
  const launchDecision = data.launchDecision || "UNKNOWN";

  document.getElementById("decisionBox").innerHTML =
    launchDecision === "HOLD"
      ? '<div class="badBox"><b>Launch decision: HOLD</b><br>Resolve critical blockers before production launch or live M-PESA use.</div>'
      : warnings.length
        ? '<div class="warnBox"><b>Launch decision: REVIEW</b><br>No hard blocker was returned, but warnings need review before wider launch.</div>'
        : '<div class="ok"><b>Launch decision: CAN PROCEED TO CONTROLLED TESTING</b><br>No blocker or warning was returned by this audit. Still run a controlled first transaction and monitor logs.</div>';

  document.getElementById("summary").innerHTML =
    '<div class="metric">Blockers<b>' + blockers.length + '</b></div>' +
    '<div class="metric">Warnings<b>' + warnings.length + '</b></div>' +
    '<div class="metric">Critical files checked<b>' + files.length + '</b></div>' +
    '<div class="metric">Route patterns checked<b>' + routes.length + '</b></div>' +
    '<div class="metric">Database models checked<b>' + db.length + '</b></div>' +
    '<div class="metric">Generated<b>' + esc(data.generatedAt ? new Date(data.generatedAt).toLocaleString() : "-") + '</b></div>';

  document.getElementById("blockers").innerHTML = '<b>Critical blockers</b>' + listBox(blockers, "No critical blockers returned.", true);
  document.getElementById("warnings").innerHTML = '<b>Warnings</b>' + listBox(warnings, "No warnings returned.", false);

  document.getElementById("details").innerHTML =
    '<h3>Environment</h3>' +
    table(["Item", "Status", "Value", "Note"], [
      ["DATABASE_URL", env.databaseUrlSet ? pill("ok","SET") : pill("bad","MISSING"), env.databaseUrl || "-", "Must point to production database on Render."],
      ["ADMIN_ORDER_TOKEN", env.adminOrderTokenSet ? pill("ok","SET") : pill("bad","MISSING"), env.adminOrderToken || "-", "Protects sensitive admin pages."],
      ["PUBLIC_SITE_URL", env.publicSiteUrlSet ? pill("ok","SET") : pill("warn","NOT SET"), env.publicSiteUrl || "-", "Useful for production callback and public URL consistency."],
      ["NODE_ENV", env.nodeEnv ? pill("info", env.nodeEnv) : pill("warn", "NOT SET"), env.nodeEnv || "-", "Should be production on Render."],
      ["ADMIN_REGISTRATION_ENABLED", env.adminRegistrationEnabled === "true" ? pill("bad", "TRUE") : pill("ok", String(env.adminRegistrationEnabled || "false")), env.adminRegistrationEnabled || "not set", "Should not be true in production."],
      ["M-PESA mode", env.mpesaMode ? pill("info", env.mpesaMode) : pill("warn", "NOT SET"), env.mpesaMode || "-", "Production/live requires confirmation guard."],
      ["M-PESA production confirmed", env.mpesaProductionConfirmed ? pill("ok","TRUE") : pill("warn","FALSE"), String(env.mpesaProductionConfirmed), "Only true after live credentials are confirmed."]
    ]) +
    '<h3>Critical files</h3>' +
    table(["File", "Status", "Why it matters"], files.map(f => [f.file, f.exists ? pill("ok","EXISTS") : pill(f.critical ? "bad" : "warn","MISSING"), f.note])) +
    '<h3>Critical route patterns</h3>' +
    table(["Pattern", "Status", "Note"], routes.map(r => [r.pattern, r.found ? pill("ok","FOUND") : pill(r.critical ? "bad" : "warn","MISSING"), r.note])) +
    '<h3>Database counts</h3>' +
    table(["Model", "Status", "Count", "Note"], db.map(d => [d.model, d.available ? pill("ok","AVAILABLE") : pill("warn","NOT FOUND"), d.count === null || d.count === undefined ? "-" : d.count, d.note || ""])) +
    '<h3>Route order and 404 fallback</h3>' +
    table(["Check", "Status", "Details"], [
      ["Final fallback marker", order.fallbackFound ? pill("ok","FOUND") : pill("warn","NOT FOUND"), order.fallbackFound ? "Stage 32E fallback detected." : "Could not detect Stage 32E fallback marker."],
      ["Routes after fallback", order.routesAfterFallback && order.routesAfterFallback.length ? pill("bad","FOUND") : pill("ok","NONE"), order.routesAfterFallback && order.routesAfterFallback.length ? order.routesAfterFallback.join(", ") : "No route declarations detected after final fallback."],
      ["Stage 35A endpoint order", order.stage35aBeforeFallback ? pill("ok","BEFORE FALLBACK") : pill("warn","CHECK"), order.stage35aBeforeFallback ? "Endpoint should be reachable." : "Confirm endpoint is not after final fallback."]
    ]) +
    '<h3>Secret exposure scan</h3>' +
    table(["File", "Status", "Matches"], secrets.map(s => [s.file, s.matches.length ? pill("bad","REVIEW") : pill("ok","CLEAR"), s.matches.join(", ") || "-"]));

  document.getElementById("summaryCard").style.display = "block";
  document.getElementById("blockerCard").style.display = "block";
  document.getElementById("detailCard").style.display = "block";
}
function table(headers, rows){
  return '<table><thead><tr>' + headers.map(h => '<th>' + esc(h) + '</th>').join("") + '</tr></thead><tbody>' +
    rows.map(row => '<tr>' + row.map(cell => '<td>' + cell + '</td>').join("") + '</tr>').join("") +
    '</tbody></table>';
}
function buildGapReport(){
  if (!lastAudit) return "";
  const blockers = lastAudit.blockers || [];
  const warnings = lastAudit.warnings || [];
  return [
    "SokoYetu Stage 35A Core Production Readiness Gap Report",
    "Generated: " + (lastAudit.generatedAt || new Date().toISOString()),
    "",
    "Launch decision: " + (lastAudit.launchDecision || "UNKNOWN"),
    "",
    "Critical blockers:",
    blockers.length ? blockers.map(x => "- " + x).join("\\n") : "- None returned",
    "",
    "Warnings:",
    warnings.length ? warnings.map(x => "- " + x).join("\\n") : "- None returned",
    "",
    "Next action:",
    blockers.length ? "Resolve blockers before launch or live payment testing." : warnings.length ? "Review warnings before wider launch." : "Proceed only to controlled testing and monitoring."
  ].join("\\n");
}
async function copyReport(){
  const text = buildGapReport();
  if (!text) {
    msg('<div class="err">Run the audit first.</div>');
    return;
  }
  try {
    await navigator.clipboard.writeText(text);
    msg('<div class="ok">Gap report copied.</div>');
  } catch {
    msg('<div class="warnBox">Could not copy automatically. Select the report manually from the audit output.</div>');
  }
}
document.getElementById("loadBtn").onclick = runAudit;
document.getElementById("copyReportBtn").onclick = copyReport;
</script>

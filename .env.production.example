# SokoYetu production environment template
# Do not commit real secrets. Add these inside the hosting dashboard.

NODE_ENV="production"
ADMIN_REGISTRATION_ENABLED="false"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_characters"

UPLOAD_MODE="cloudinary"
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

MPESA_MODE="daraja"
MPESA_ENV="sandbox"
MPESA_SHORTCODE="174379"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CONSUMER_KEY="your_daraja_consumer_key"
MPESA_CONSUMER_SECRET="your_daraja_consumer_secret"
MPESA_PASSKEY="your_daraja_passkey"
MPESA_CALLBACK_URL="https://YOUR-DEPLOYED-DOMAIN/api/payments/mpesa/callback"

LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

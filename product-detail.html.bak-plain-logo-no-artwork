<body>
<header>
  <div class="wrap">
    <h1>Product Details</h1>
    <p>Review product information, stock status and support links before buying on SokoYetu Mtaani.</p>
  </div>
</header>

<main>
  <div class="actions">
    <a class="linkbtn" href="/">← Back to shop</a>
    <a class="linkbtn secondary" href="/categories.html">Browse categories</a>
    <a class="linkbtn secondary" href="/help-center.html">Help Center</a>
  </div>

  <section class="card">
    <div class="body" id="result">
      <div class="note">Loading product details...</div>
    </div>
  </section>
</main>

<footer>
  SokoYetu Mtaani · Product details · SokoYetu Mtaani@gmail.com
</footer>

<script>
function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function productId(){
  return new URLSearchParams(location.search).get("id");
}
function setMeta(product){
  const title = (product.name || "Product") + " · SokoYetu Mtaani";
  document.title = title;
  let meta = document.querySelector('meta[name="description"]');
  if (!meta) {
    meta = document.createElement("meta");
    meta.setAttribute("name", "description");
    document.head.appendChild(meta);
  }
  meta.setAttribute("content", String(product.description || "View this SokoYetu Mtaani product.").slice(0, 155));
}
async function loadProduct(){
  const id = productId();
  const result = document.getElementById("result");

  if (!id) {
    result.innerHTML = '<div class="err">Product ID is missing. Open this page from a product or category listing.</div>';
    return;
  }

  try {
    const res = await fetch("/api/products", { credentials: "include" });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.message || "Could not load products.");

    const raw = Array.isArray(data) ? data : (data.products || data.data || []);
    const product = raw.find(p => String(p.id) === String(id));

    if (!product) {
      result.innerHTML = '<div class="err">Product was not found. It may have been removed or is not available.</div>';
      return;
    }

    renderProduct(product);
  } catch (error) {
    result.innerHTML = '<div class="err">' + esc(error.message || "Could not load product.") + '</div>';
  }
}
function renderProduct(product){
  setMeta(product);

  const result = document.getElementById("result");
  const image = product.imageUrl || product.image || product.photoUrl || "";
  const stock = product.stock ?? null;
  const inStock = stock === null || Number(stock) > 0;
  const stockText = stock === null ? "Stock not shown" : (inStock ? stock + " available" : "Out of stock");
  const stockClass = inStock ? "pill" : "pill bad";

  const imageHtml = image
    ? '<img src="' + esc(image) + '" alt="' + esc(product.name || "Product image") + '">'
    : '<div class="noimg">No product image available</div>';

  const shareUrl = location.href;

  result.innerHTML =
    '<div class="productLayout">' +
      '<div class="imageBox">' + imageHtml + '</div>' +
      '<div style="display:grid;gap:13px">' +
        '<div class="title">' + esc(product.name || "Unnamed product") + '</div>' +
        '<div><span class="pill">' + esc(product.category || "Other") + '</span><span class="' + stockClass + '">' + esc(stockText) + '</span></div>' +
        '<div><span class="price">' + money(product.price || 0) + '</span>' + (Number(product.oldPrice || 0) > Number(product.price || 0) ? ' <span class="old">' + money(product.oldPrice) + '</span>' : '') + '</div>' +
        '<div class="muted">' + esc(product.description || "No description has been provided for this product yet.") + '</div>' +
        '<div class="grid">' +
          '<div class="smallcard"><b>Product ID</b><br><span class="muted">#' + esc(product.id) + '</span></div>' +
          '<div class="smallcard"><b>Category</b><br><span class="muted">' + esc(product.category || "Other") + '</span></div>' +
          '<div class="smallcard"><b>Seller</b><br><a class="linkbtn" href="/seller-store.html?sellerId=' + encodeURIComponent(product.sellerId || "unknown") + '">View seller store</a></div>' +
        '</div>' +
        '<div class="actions">' +
          '<a class="linkbtn" href="/#products">Open shop</a>' +
          '<a class="linkbtn secondary" href="/checkout.html">Go to checkout</a>' +
          '<button type="button" onclick="copyShareLink()">Copy product link</button>' +
        '</div>' +
        '<div class="note">To buy this product, return to the shop, add it to your cart, then use Secure Checkout. For order help, use the Help Center.</div>' +
      '</div>' +
    '</div>';

  window.currentShareUrl = shareUrl;
}
async function copyShareLink(){
  try {
    await navigator.clipboard.writeText(window.currentShareUrl || location.href);
    alert("Product link copied.");
  } catch (error) {
    prompt("Copy this product link:", window.currentShareUrl || location.href);
  }
}
window.copyShareLink = copyShareLink;
loadProduct();
</script>

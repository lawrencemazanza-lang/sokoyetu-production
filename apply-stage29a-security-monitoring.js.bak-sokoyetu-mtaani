const fs = require("fs");
const path = require("path");

const root = process.cwd();
const serverPath = path.join(root, "server.js");
const packagePath = path.join(root, "package.json");

if (!fs.existsSync(serverPath) || !fs.existsSync(packagePath)) {
  console.error("ERROR: server.js or package.json was not found. Run this inside your SokoYetu project folder.");
  process.exit(1);
}

function backup(filePath, label) {
  const backupPath = `${filePath}.backup-stage29a-${label}-${Date.now()}`;
  fs.copyFileSync(filePath, backupPath);
  console.log("Backup created:", path.basename(backupPath));
}

backup(serverPath, "server");
backup(packagePath, "package");

const pkg = JSON.parse(fs.readFileSync(packagePath, "utf8"));
pkg.scripts = pkg.scripts || {};
pkg.scripts["stage29a:check"] = "node scripts/check-stage29a-security-monitoring.js";
fs.writeFileSync(packagePath, JSON.stringify(pkg, null, 2), "utf8");

const scriptsDir = path.join(root, "scripts");
if (!fs.existsSync(scriptsDir)) fs.mkdirSync(scriptsDir);

fs.writeFileSync(path.join(scriptsDir, "check-stage29a-security-monitoring.js"), `require("dotenv").config();

console.log("SokoYetu Stage 29A Security and Monitoring Check");
console.log("-----------------------------------------------");

let warnings = 0;

function check(key, opts = {}) {
  const value = process.env[key];
  if (!value) {
    console.log("WARN:", key, "is not set.");
    warnings += 1;
    return;
  }
  console.log("OK:", key, "=", opts.secret ? value.slice(0, 4) + "...hidden" : value);
}

check("PUBLIC_SITE_URL");
check("BUSINESS_NAME");
check("SUPPORT_EMAIL");
check("DATABASE_URL", { secret: true });
check("ADMIN_ORDER_TOKEN", { secret: true });
check("JWT_SECRET", { secret: true });
check("UPLOAD_MODE");
check("MPESA_MODE");
check("MPESA_ENV");
check("MPESA_CALLBACK_URL");

if (process.env.ADMIN_REGISTRATION_ENABLED === "true") {
  console.log("WARN: ADMIN_REGISTRATION_ENABLED should be false for launch.");

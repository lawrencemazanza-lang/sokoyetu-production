function addAssetTags(fileName) {
  const filePath = path.join(root, fileName);
  if (!fs.existsSync(filePath)) {
    console.log("Skipped missing public page:", fileName);
    return false;
  }

  backup(filePath, fileName.replace(/[^a-z0-9]/gi, "-"));

  let html = fs.readFileSync(filePath, "utf8");
  let before = html;

  if (!html.includes('href="/public-nav.css"')) {
    if (html.includes("</head>")) {
      html = html.replace("</head>", '  <link rel="stylesheet" href="/public-nav.css">\n</head>');
    } else {
      html = '<link rel="stylesheet" href="/public-nav.css">\n' + html;
    }
  }

  if (!html.includes('src="/public-nav.js"')) {
    if (html.includes("</body>")) {
      html = html.replace("</body>", '  <script src="/public-nav.js" defer></script>\n</body>');
    } else {
      html += '\n<script src="/public-nav.js" defer></script>\n';
    }
  }

  if (html !== before) {
    fs.writeFileSync(filePath, html, "utf8");
    console.log("Added public navigation assets:", fileName);
    return true;
  }

  console.log("Public navigation assets already present:", fileName);
  return false;
}

let changedPages = 0;
for (const page of publicPages) {
  if (addAssetTags(page)) changedPages += 1;
}


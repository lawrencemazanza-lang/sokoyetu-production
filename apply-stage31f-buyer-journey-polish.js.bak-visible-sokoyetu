  let index = fs.readFileSync(indexPath, "utf8");
  const before = index;

  const cleanupPatterns = [
    /<!-- SokoYetu Stage 30E: Public customer service shortcuts -->[\s\S]*?<!-- End SokoYetu Stage 30E -->/g,
    /<!-- SokoYetu Stage 31C: Public category directory link -->[\s\S]*?<!-- End SokoYetu Stage 31C -->/g,
    /<!-- SokoYetu Stage 31D: Product detail page note -->[\s\S]*?<!-- End SokoYetu Stage 31D -->/g,
    /<!-- SokoYetu Stage 31E: Seller stores link -->[\s\S]*?<!-- End SokoYetu Stage 31E -->/g
  ];

  for (const pattern of cleanupPatterns) {
    index = index.replace(pattern, "");
  }

  // Remove old inline helpbar CSS if only partly inserted.
  index = index.replace(/<style id="sy-stage30e-help-style">[\s\S]*?<\/style>/g, "");

  if (index !== before) {
    fs.writeFileSync(indexPath, index, "utf8");
    console.log("Cleaned repeated homepage customer-service blocks from index.html.");
  } else {
    console.log("No repeated Stage 30E/31C/31D/31E homepage blocks found.");
  }
}


const fs = require("fs");
const path = require("path");

const root = process.cwd();
const indexPath = path.join(root, "index.html");
let warnings = 0;

console.log("SokoYetu Stage 37E Flash Sale First Homepage Check");
console.log("--------------------------------------------------");

if (!fs.existsSync(indexPath)) {
  console.log("WARN: index.html missing.");
  process.exit(1);
}

const html = fs.readFileSync(indexPath, "utf8");

const required = [
  "soko37e-page",
  "soko37e-flash-hero",
  "soko37eLiveProduct",
  "soko37eFlashGrid",
  "soko37e-page-links",
  "soko37e-category-rail",
  "soko37e-side-ads",
  "soko37e-live-strip",
  "soko37e-sponsored",
  "soko37eWhatsApp",
  "Flash Sale",
  "Live product",
  "Categories",
  "Track Order",
  "Help Center",
  "Seller Center",
  "254714565555",
  "6923522",
  "/api/products"
];

for (const item of required) {
  if (!html.includes(item)) {
    console.log("WARN: index.html missing:", item);
    warnings++;
  } else {
    console.log("OK: index.html includes", item);
  }
}

const forbidden = [
  "Daraja",
  "not working",
  "fallback",
  "SokoYetu Stage",
  "launch-readiness draft",
  "M-PESA STK Push failed",
  "checkout page STK note"
];

for (const item of forbidden) {
  if (html.toLowerCase().includes(item.toLowerCase())) {
    console.log("WARN: customer-facing homepage contains unwanted wording:", item);
    warnings++;
  } else {
    console.log("OK: homepage does not contain", item);
  }
}

const flashIndex = html.indexOf("soko37e-flash-hero");
const liveIndex = html.indexOf("soko37e-live-strip");
const sponsoredIndex = html.indexOf("soko37e-sponsored");
if (flashIndex !== -1 && liveIndex !== -1 && flashIndex < liveIndex) console.log("OK: Flash Sale appears before Live Shopping.");
else { console.log("WARN: Flash Sale does not appear before Live Shopping."); warnings++; }

if (flashIndex !== -1 && sponsoredIndex !== -1 && flashIndex < sponsoredIndex) console.log("OK: Flash Sale appears before Sponsored Products.");
else { console.log("WARN: Flash Sale does not appear before Sponsored Products."); warnings++; }

console.log("");
console.log("Warnings:", warnings);
if (warnings === 0) console.log("Stage 37E flash-sale-first homepage check passed.");

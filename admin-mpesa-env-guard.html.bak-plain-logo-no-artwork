<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="googlebot" content="noindex,nofollow,noarchive">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Mtaani M-PESA Environment Guard</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#111827,#16a34a);color:#fff;padding:24px}
    header .wrap,main{width:min(1220px,94vw);margin:0 auto}
    h1{margin:0;font-size:28px}
    header p{margin:7px 0 0;color:#dcfce7;line-height:1.5}
    main{display:grid;gap:16px;padding:20px 0 36px}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:22px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:15px 18px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:16px;display:grid;gap:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
    label{font-weight:900;color:#064e3b}
    input{width:100%;border:1px solid #bbf7d0;border-radius:14px;padding:11px;font:inherit}
    button,.linkbtn{border:none;border-radius:14px;background:#16a34a;color:#fff;padding:11px 14px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:fit-content}
    .linkbtn{background:#064e3b}
    .secondary{background:#111827}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px;line-height:1.5}
    .err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    .ok{background:#ecfdf5;border:1px solid #86efac;color:#047857;border-radius:16px;padding:12px;line-height:1.5}
    .warnBox{background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:16px;padding:12px;line-height:1.5}
    .badBox{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    .metric{border:1px solid #e5e7eb;border-radius:18px;padding:14px;background:#f8fafc}
    .metric b{display:block;font-size:22px;color:#064e3b;margin-top:4px;word-break:break-word}
    .pill{display:inline-flex;border-radius:999px;padding:5px 9px;font-weight:900;font-size:12px;margin:2px;background:#dcfce7;color:#166534}
    .warn{background:#fef3c7;color:#92400e}
    .bad{background:#fee2e2;color:#991b1b}
    table{width:100%;border-collapse:collapse;font-size:14px}
    th,td{border-bottom:1px solid #e5e7eb;padding:9px;text-align:left;vertical-align:top}
    th{background:#f1f5f9}
    code{background:#f1f5f9;border-radius:8px;padding:2px 6px}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    @media(max-width:760px){table{display:block;overflow-x:auto;white-space:nowrap}.grid{grid-template-columns:1fr}}
  </style>
  <link rel="stylesheet" href="/sokoyetu-final-brand.css">
  <link rel="stylesheet" href="/sokoyetu-search-logo-refine.css">
</head>
<body>
<header>
  <div class="wrap">
    <h1>SokoYetu Mtaani M-PESA Environment Guard</h1>
    <p>Map exact M-PESA variables used by the code and check whether production/live mode is safely confirmed.</p>
  </div>
</header>

<main>
  <div class="actions">
    <a class="linkbtn" href="/admin-control.html">← Back to admin control</a>
    <a class="linkbtn secondary" href="/admin-mpesa-readiness.html">M-PESA readiness</a>
    <a class="linkbtn secondary" href="/admin-orders.html">Admin orders</a>
  </div>

  <section class="card">
    <div class="head">Access</div>
    <div class="body">
      <div class="grid">
        <div>
          <label>Admin order token</label>
          <input id="token" type="password" placeholder="Paste ADMIN_ORDER_TOKEN">
        </div>
      </div>
      <button id="loadBtn" type="button">Load environment guard</button>
      <div class="warnBox">This page does not switch M-PESA to production. It only maps variables and warns about unsafe production/live states.</div>
      <div id="message"></div>
    </div>
  </section>

  <section id="resultCard" class="card" style="display:none">
    <div class="head">Environment guard result</div>
    <div class="body" id="result"></div>
  </section>

  <section class="card">
    <div class="head">Manual switch rule</div>
    <div class="body">
      <div class="badBox">
        Do not set <code>MPESA_ENV=production</code> or <code>MPESA_MODE=production</code> unless live Daraja production credentials, live shortcode, live passkey and HTTPS callback URL are confirmed.
      </div>
      <div class="note">
        The extra confirmation flag should only be added after manual verification:
        <code>MPESA_PRODUCTION_CONFIRMED=true</code>
      </div>
    </div>
  </section>
</main>

<script>
function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
function pill(kind, text){
  const cls = kind === "ok" ? "pill" : kind === "bad" ? "pill bad" : "pill warn";
  return '<span class="' + cls + '">' + esc(text) + '</span>';
}
async function loadGuard(){
  if (!token()) {
    msg('<div class="err">Admin order token is required.</div>');
    return;
  }
  msg('<div class="note">Loading M-PESA environment guard...</div>');
  try {
    const response = await fetch("/api/admin/mpesa-env-guard", {
      headers: {"x-admin-order-token": token()},
      credentials: "include",
      cache: "no-store"
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.message || "Could not load environment guard.");
    render(data);
    msg('<div class="ok">M-PESA environment guard loaded.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not load environment guard.") + '</div>');
  }
}
function render(data){
  const result = document.getElementById("result");
  const blockers = data.blockers || [];
  const warnings = data.warnings || [];
  const groups = data.groups || [];
  const referenced = data.referencedMpesaKeys || [];

  const statusBox = blockers.length
    ? '<div class="badBox"><b>M-PESA production guard is blocking readiness.</b><br>' + blockers.map(b => "• " + esc(b)).join("<br>") + '</div>'
    : '<div class="ok"><b>No production guard blocker detected.</b><br>This still does not mean production should be switched without manual Safaricom approval.</div>';

  const warningBox = warnings.length
    ? '<div class="warnBox"><b>Warnings</b><br>' + warnings.map(w => "• " + esc(w)).join("<br>") + '</div>'
    : '<div class="ok"><b>No warnings returned by the environment guard.</b></div>';

  result.innerHTML =
    statusBox +
    warningBox +
    '<div class="grid">' +
      '<div class="metric">Referenced M-PESA keys<b>' + esc(referenced.length) + '</b></div>' +
      '<div class="metric">Production requested<b>' + esc(data.productionRequested ? "yes" : "no") + '</b></div>' +
      '<div class="metric">Production confirmed<b>' + esc(data.productionConfirmed ? "yes" : "no") + '</b></div>' +
      '<div class="metric">Guard status<b>' + esc(data.guardStatus || "-") + '</b></div>' +
    '</div>' +
    '<div><b>Referenced M-PESA/Daraja/Safaricom keys in server.js</b><table><thead><tr><th>Key</th><th>Configured?</th><th>Value</th></tr></thead><tbody>' +
      (referenced.length ? referenced.map(k => '<tr><td><code>' + esc(k.key) + '</code></td><td>' + pill(k.configured ? "ok" : "warn", k.configured ? "SET" : "NOT SET") + '</td><td>' + esc(k.value || "-") + '</td></tr>').join("") : '<tr><td colspan="3">No M-PESA-related keys were detected in server.js.</td></tr>') +
    '</tbody></table></div>' +
    '<div><b>Recommended production mapping groups</b><table><thead><tr><th>Group</th><th>Referenced in code</th><th>Configured in environment</th><th>Status</th></tr></thead><tbody>' +
      groups.map(g => '<tr><td>' + esc(g.group) + '</td><td>' + esc(g.referencedKeys.join(", ") || "-") + '</td><td>' + esc(g.configuredKeys.join(", ") || "-") + '</td><td>' + pill(g.ok ? "ok" : "bad", g.ok ? "OK" : "MISSING") + '</td></tr>').join("") +
    '</tbody></table></div>';
  document.getElementById("resultCard").style.display = "block";
}
document.getElementById("loadBtn").onclick = loadGuard;
</script>
  <script src="/sokoyetu-final-seo.js" defer></script>
  <script src="/sokoyetu-search-logo-refine.js" defer></script>
</body>
</html>





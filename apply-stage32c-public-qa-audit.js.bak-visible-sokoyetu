  { area:"Support Request", url:"/support-request.html", expect:"html" },
  { area:"Contact Support", url:"/contact-support.html", expect:"html" },
  { area:"Frequently Asked Questions", url:"/faq.html", expect:"html" },
  { area:"Returns Policy", url:"/returns-policy.html", expect:"html" },
  { area:"Privacy Policy", url:"/privacy-policy.html", expect:"html" },
  { area:"Terms of Service", url:"/terms-of-service.html", expect:"html" },
  { area:"Public Navigation CSS", url:"/public-nav.css", expect:"asset" },
  { area:"Public Navigation JS", url:"/public-nav.js", expect:"asset" },
  { area:"Favicon", url:"/favicon.svg", expect:"asset" },
  { area:"Web Manifest", url:"/site.webmanifest", expect:"json" },
  { area:"Sitemap", url:"/sitemap.xml", expect:"xml" },
  { area:"Robots", url:"/robots.txt", expect:"text" },
  { area:"Product API", url:"/api/products", expect:"json" }
];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function setMessage(html){ document.getElementById("message").innerHTML = html; }
function statusPill(kind, text){
  const cls = kind === "ok" ? "pill" : kind === "warn" ? "pill warn" : "pill bad";
  return '<span class="' + cls + '">' + esc(text) + '</span>';
}
async function runOne(check){
  const started = performance.now();
  try {
    const response = await fetch(check.url, { credentials:"include", cache:"no-store" });
    const duration = Math.round(performance.now() - started);
    const text = await response.text();

    let ok = response.ok;
    let note = "HTTP " + response.status + " · " + duration + " ms";

    if (check.expect === "html" && !text.toLowerCase().includes("<!doctype") && !text.toLowerCase().includes("<html")) {
      ok = false;
      note += " · Not clearly HTML";
    }

    if (check.expect === "json") {
      try { JSON.parse(text); }
      catch (error) { ok = false; note += " · Invalid JSON"; }
    }

    if (check.expect === "xml" && !text.includes("<urlset") && !text.includes("<?xml")) {
      ok = false;
      note += " · Not clearly XML";
    }

    if (check.expect === "asset" && text.length < 20) {
      ok = false;
      note += " · Asset content looks too small";
    }

    if (check.area === "Product API") {
      try {
        const data = JSON.parse(text);
        const products = Array.isArray(data) ? data : (data.products || data.data || []);
        note += " · " + products.length + " product(s)";
        if (!products.length) note += " · Add products before buyer testing";
      } catch {}
    }

    return { ...check, ok, warn:false, status:response.status, duration, note };
  } catch (error) {
    return { ...check, ok:false, warn:false, status:"ERROR", duration:null, note:error.message || "Fetch failed" };
  }
}
async function runAudit(){
  setMessage('<div class="note">Running public site audit...</div>');
  document.getElementById("results").innerHTML = '<tr><td colspan="4">Checking...</td></tr>';

  const results = [];
  for (const check of checks) {
    const result = await runOne(check);
    results.push(result);
    renderResults(results);
  }

  const passed = results.filter(r => r.ok).length;
  const failed = results.filter(r => !r.ok).length;
  const slow = results.filter(r => r.duration && r.duration > 1500).length;

  document.getElementById("summary").innerHTML =
    '<div class="metric">Checks run<b>' + results.length + '</b></div>' +
    '<div class="metric">Passed<b>' + passed + '</b></div>' +
    '<div class="metric">Failed<b>' + failed + '</b></div>' +
    '<div class="metric">Slow checks<b>' + slow + '</b></div>';

  if (failed) {
    setMessage('<div class="err"><b>Audit completed with issues.</b><br>Review failed rows before wider buyer testing.</div>');
  } else if (slow) {
    setMessage('<div class="warnBox"><b>Audit passed with slow responses.</b><br>Review slow rows and Render logs if needed.</div>');
  } else {
    setMessage('<div class="ok"><b>Audit passed.</b><br>Public pages and assets are reachable from this browser session.</div>');
  }
}
function renderResults(results){
  document.getElementById("results").innerHTML = results.map(r => {
    const kind = r.ok ? (r.duration && r.duration > 1500 ? "warn" : "ok") : "bad";
    const text = r.ok ? (r.duration && r.duration > 1500 ? "SLOW" : "OK") : "FAIL";
    return '<tr>' +
      '<td>' + esc(r.area) + '</td>' +
      '<td><a href="' + esc(r.url) + '" target="_blank">' + esc(r.url) + '</a></td>' +
      '<td>' + statusPill(kind, text) + '</td>' +
      '<td>' + esc(r.note) + '</td>' +
    '</tr>';
  }).join("");
}
document.getElementById("runBtn").onclick = runAudit;
</script>

const fs = require("fs");
const path = require("path");

const root = process.cwd();
const packagePath = path.join(root, "package.json");
const scriptsDir = path.join(root, "scripts");

if (!fs.existsSync(packagePath)) {
  console.error("ERROR: package.json not found. Run this inside your SokoYetu Mtaani project folder.");
  process.exit(1);
}

if (!fs.existsSync(scriptsDir)) {
  fs.mkdirSync(scriptsDir);
}

const pkg = JSON.parse(fs.readFileSync(packagePath, "utf8"));
pkg.scripts = pkg.scripts || {};
pkg.scripts["seed:production"] = "node scripts/seed-production-data.js";
pkg.scripts["products:count"] = "node scripts/count-products.js";
fs.writeFileSync(packagePath, JSON.stringify(pkg, null, 2), "utf8");


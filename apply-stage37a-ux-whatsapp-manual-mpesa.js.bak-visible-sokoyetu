const fs = require("fs");
const path = require("path");

const root = process.cwd();
const packagePath = path.join(root, "package.json");
const appPath = path.join(root, "app.js");
const checkoutPath = path.join(root, "checkout.html");

const WHATSAPP_NUMBER = "254714565555";
const MPESA_TILL = "6923522";

if (!fs.existsSync(packagePath) || !fs.existsSync(appPath) || !fs.existsSync(checkoutPath)) {
  console.error("ERROR: package.json, app.js, or checkout.html was not found.");
  process.exit(1);
}

function backup(filePath, label) {
  const backupPath = filePath + ".backup-stage37a-" + label + "-" + Date.now();
  fs.copyFileSync(filePath, backupPath);
  console.log("Backup created:", path.basename(backupPath));
}

backup(packagePath, "package");
backup(appPath, "app");
backup(checkoutPath, "checkout");

const pkg = JSON.parse(fs.readFileSync(packagePath, "utf8"));
pkg.scripts = pkg.scripts || {};
pkg.scripts["stage37a:check"] = "node scripts/check-stage37a-ux-whatsapp-manual-mpesa.js";
fs.writeFileSync(packagePath, JSON.stringify(pkg, null, 2), "utf8");

const scriptsDir = path.join(root, "scripts");
if (!fs.existsSync(scriptsDir)) fs.mkdirSync(scriptsDir);

fs.writeFileSync(path.join(scriptsDir, "check-stage37a-ux-whatsapp-manual-mpesa.js"), `const fs = require("fs");
const path = require("path");
const root = process.cwd();
let warnings = 0;
console.log("SokoYetu Stage 37A UX WhatsApp Manual M-PESA Check");
console.log("--------------------------------------------------");
function checkFile(file, items) {
  const p = path.join(root, file);
  if (!fs.existsSync(p)) {
    console.log("WARN:", file, "missing");
    warnings++;
    return;
  }
  const s = fs.readFileSync(p, "utf8");
  for (const item of items) {
    if (!s.includes(item)) {
      console.log("WARN:", file, "missing:", item);
      warnings++;
    } else {
      console.log("OK:", file, "includes", item);
    }
  }
}
checkFile("app.js", ["SokoYetu Stage 37A", "sokoyetu-offer-rail", "wa.me", "254714565555"]);
checkFile("checkout.html", ["Manual M-PESA", "Buy Goods and Services", "6923522", "Self-pickup", "Home delivery", "/api/payments/mpesa/stk-push"]);
const bad = ["SokoYetu Stage 36B: checkout page STK note", "M-PESA STK Push failed."];
const c = fs.existsSync(path.join(root, "checkout.html")) ? fs.readFileSync(path.join(root, "checkout.html"), "utf8") : "";
for (const item of bad) {
  if (c.includes(item)) { console.log("WARN: checkout.html still contains public technical text:", item); warnings++; }
}
console.log("");
console.log("Warnings:", warnings);
if (warnings === 0) console.log("Stage 37A check passed.");
`, "utf8");


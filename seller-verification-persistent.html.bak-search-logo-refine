<!doctype html>
<html lang="en">
<head>
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="googlebot" content="noindex,nofollow,noarchive">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Mtaani Persistent Seller Verification</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#111827,#16a34a);color:white;padding:24px}
    header .wrap,main{width:min(1220px,94vw);margin:0 auto}
    h1{margin:0;font-size:28px}
    header p{margin:7px 0 0;color:#dcfce7}
    main{display:grid;gap:16px;padding:20px 0 36px}
    .card{background:white;border:1px solid #e5e7eb;border-radius:22px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:15px 18px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:16px;display:grid;gap:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
    label{font-weight:900;color:#064e3b}
    input,select,textarea{width:100%;border:1px solid #bbf7d0;border-radius:14px;padding:11px;font:inherit}
    textarea{min-height:80px;resize:vertical}
    button,.linkbtn{border:none;border-radius:14px;background:#16a34a;color:white;padding:11px 14px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:fit-content}
    button.secondary{background:#111827}
    .linkbtn{background:#064e3b}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px;line-height:1.5}
    .err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    .ok{background:#ecfdf5;border:1px solid #86efac;color:#047857;border-radius:16px;padding:12px;line-height:1.5}
    .sellers{display:grid;gap:14px}
    .seller{border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;background:#fff}
    .sellerTop{display:grid;grid-template-columns:1fr auto;gap:12px;padding:14px;background:#f8fafc;border-bottom:1px solid #e5e7eb}
    .sellerBody{padding:14px;display:grid;gap:12px}
    .title{font-weight:900}
    .muted{color:#64748b;font-size:13px}
    .pill{display:inline-flex;border-radius:999px;padding:5px 9px;font-weight:900;font-size:12px;margin:2px;background:#dcfce7;color:#166534}
    .warn{background:#fef3c7;color:#92400e}
    .bad{background:#fee2e2;color:#991b1b}
    table{width:100%;border-collapse:collapse;font-size:13px}
    th,td{border-bottom:1px solid #e5e7eb;padding:8px;text-align:left;vertical-align:top}
    th{background:#f1f5f9}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    @media(max-width:800px){.sellerTop{grid-template-columns:1fr}table{font-size:12px}}
  </style>
  <link rel="stylesheet" href="/sokoyetu-final-brand.css">
</head>
<body>
<header>
  <div class="wrap">
    <h1>SokoYetu Mtaani Persistent Seller Verification</h1>
    <p>Approve, hold, reject or suspend sellers with records saved in the database.</p>
  </div>
</header>

<main>
  <a class="linkbtn" href="/">← Back to shop</a>

  <section class="card">
    <div class="head">Admin access and filters</div>
    <div class="body">
      <div class="grid">
        <div>
          <label>Seller verification token</label>
          <input id="token" type="password" placeholder="Paste SELLER_VERIFICATION_TOKEN">
        </div>
        <div>
          <label>Verification status</label>
          <select id="statusFilter">
            <option value="">All statuses</option>
            <option value="UNDER_REVIEW">Under Review</option>
            <option value="APPROVED">Approved</option>
            <option value="MORE_INFO">More Information Needed</option>
            <option value="HOLD">Hold</option>
            <option value="SUSPENDED">Suspended</option>
            <option value="REJECTED">Rejected</option>
          </select>
        </div>
        <div>
          <label>Search</label>
          <input id="searchBox" placeholder="Name, email, phone">
        </div>
      </div>
      <div class="actions">
        <button id="loadBtn" type="button">Load sellers</button>
        <button id="refreshBtn" class="secondary" type="button">Refresh</button>
      </div>
      <div class="note">This version stores verification records in the database through the SellerVerification model.</div>
      <div id="message"></div>
    </div>
  </section>

  <section class="card">
    <div class="head">Seller verification records</div>
    <div class="body">
      <div id="summary" class="note">No sellers loaded yet.</div>
      <div id="sellers" class="sellers"></div>
    </div>
  </section>
</main>

<script>
let sellerList = [];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
function pillClass(value){
  const v = String(value || "").toUpperCase();
  if (v.includes("REJECT") || v.includes("SUSPEND") || v === "HIGH") return "pill bad";
  if (v.includes("HOLD") || v.includes("MORE") || v.includes("REVIEW") || v === "MEDIUM") return "pill warn";
  return "pill";
}
async function api(url, options={}){
  const response = await fetch(url, {
    credentials: "include",
    headers: {"Content-Type":"application/json","x-seller-verification-token":token(),...(options.headers||{})},
    ...options
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.message || "Request failed.");
  return data;
}
function buildUrl(){
  const params = new URLSearchParams();
  const status = document.getElementById("statusFilter").value;
  const q = document.getElementById("searchBox").value.trim();
  if (status) params.set("status", status);
  if (q) params.set("q", q);
  return "/api/admin/sellers/persistent-verification" + (params.toString() ? "?" + params.toString() : "");
}
async function loadSellers(){
  if (!token()) { msg('<div class="err">Seller verification token is required.</div>'); return; }
  msg('<div class="note">Loading sellers...</div>');
  try {
    const data = await api(buildUrl());
    sellerList = data.sellers || [];
    renderSellers();
    msg('<div class="ok">Sellers loaded successfully.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not load sellers.") + '</div>');
  }
}
function renderSellers(){
  const wrap = document.getElementById("sellers");
  const summary = document.getElementById("summary");
  if (!sellerList.length) {
    summary.textContent = "No sellers found.";
    wrap.innerHTML = "";
    return;
  }
  const approved = sellerList.filter(s => s.verification?.status === "APPROVED").length;
  summary.innerHTML = '<b>' + sellerList.length + '</b> sellers loaded. <b>' + approved + '</b> approved.';

  wrap.innerHTML = sellerList.map(s => {
    const verification = s.verification || {};
    const issues = (s.issues || []).map(i => '<span class="pill warn">' + esc(i) + '</span>').join("") || '<span class="pill">No immediate risk flags</span>';
    const products = (s.products || []).map(p => '<tr><td>' + esc(p.name) + '</td><td>' + esc(p.category || "-") + '</td><td>KES ' + Number(p.price || 0).toLocaleString("en-KE") + '</td><td>' + esc(p.stock ?? "-") + '</td><td>' + (p.imageUrl ? "Yes" : "No") + '</td></tr>').join("") || '<tr><td colspan="5">No products found.</td></tr>';
    return '<article class="seller">' +
      '<div class="sellerTop"><div><div class="title">' + esc(s.name || "Unnamed seller") + ' · Seller #' + s.id + '</div><div class="muted">' + esc(s.email || "-") + ' · ' + esc(s.phone || "-") + '</div></div><div><span class="' + pillClass(verification.status) + '">' + esc(verification.status || "UNDER_REVIEW") + '</span><span class="' + pillClass(s.riskLevel) + '">' + esc(s.riskLevel) + ' RISK</span></div></div>' +
      '<div class="sellerBody">' +
        '<div><b>Risk flags</b><br>' + issues + '</div>' +
        '<div><b>Current verification notes</b><br><span class="muted">' + esc(verification.notes || "-") + '</span></div>' +
        '<div><b>Products</b><table><thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Image</th></tr></thead><tbody>' + products + '</tbody></table></div>' +
        '<div class="grid">' +
          '<div><label>Status</label><select id="status-' + s.id + '"><option value="UNDER_REVIEW">Under Review</option><option value="APPROVED">Approved</option><option value="MORE_INFO">More Information Needed</option><option value="HOLD">Hold</option><option value="SUSPENDED">Suspended</option><option value="REJECTED">Rejected</option></select></div>' +
          '<div><label>Decision</label><select id="decision-' + s.id + '"><option value="APPROVE">Approve</option><option value="REQUEST_MORE_INFO">Request More Information</option><option value="HOLD">Hold</option><option value="SUSPEND">Suspend</option><option value="REJECT">Reject</option></select></div>' +
          '<div><label>Reviewed by</label><input id="reviewed-' + s.id + '" placeholder="Admin name or email"></div>' +
          '<div><label>Risk level</label><select id="risk-' + s.id + '"><option value="LOW">Low</option><option value="MEDIUM">Medium</option><option value="HIGH">High</option></select></div>' +
        '</div>' +
        '<div><label>Admin notes</label><textarea id="notes-' + s.id + '" placeholder="Record verification details, seller requirements and next action.">' + esc(verification.notes || "") + '</textarea></div>' +
        '<div class="actions"><button type="button" onclick="saveVerification(' + s.id + ')">Save verification</button></div>' +
      '</div>' +
    '</article>';
  }).join("");

  sellerList.forEach(s => {
    const v = s.verification || {};
    const statusEl = document.getElementById("status-" + s.id);
    const decisionEl = document.getElementById("decision-" + s.id);
    const riskEl = document.getElementById("risk-" + s.id);
    const reviewedEl = document.getElementById("reviewed-" + s.id);
    if (statusEl) statusEl.value = v.status || "UNDER_REVIEW";
    if (decisionEl) decisionEl.value = v.decision || "REQUEST_MORE_INFO";
    if (riskEl) riskEl.value = v.riskLevel || s.riskLevel || "LOW";
    if (reviewedEl) reviewedEl.value = v.reviewedBy || "";
  });
}
async function saveVerification(sellerId){
  const body = {
    status: document.getElementById("status-" + sellerId).value,
    decision: document.getElementById("decision-" + sellerId).value,
    riskLevel: document.getElementById("risk-" + sellerId).value,
    reviewedBy: document.getElementById("reviewed-" + sellerId).value.trim(),
    notes: document.getElementById("notes-" + sellerId).value.trim()
  };
  try {
    msg('<div class="note">Saving seller verification...</div>');
    await api("/api/admin/sellers/" + sellerId + "/persistent-verification", { method:"POST", body: JSON.stringify(body) });
    msg('<div class="ok">Seller verification saved.</div>');
    await loadSellers();
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not save verification.") + '</div>');
  }
}
document.getElementById("loadBtn").onclick = loadSellers;
document.getElementById("refreshBtn").onclick = loadSellers;
window.saveVerification = saveVerification;
</script>

<!-- SokoYetu Mtaani internal operations page: noindex/nofollow enabled in Stage 30C -->
  <script src="/sokoyetu-final-seo.js" defer></script>
</body>
</html>




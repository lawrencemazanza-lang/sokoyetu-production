const fs = require("fs");
const path = require("path");

const root = process.cwd();
const packagePath = path.join(root, "package.json");
const serverPath = path.join(root, "server.js");
const checkoutPath = path.join(root, "checkout.html");

if (!fs.existsSync(packagePath) || !fs.existsSync(serverPath) || !fs.existsSync(checkoutPath)) {
  console.error("ERROR: package.json, server.js, or checkout.html was not found. Run this inside your SokoYetu project folder.");
  process.exit(1);
}

function backup(filePath, label) {
  const backupPath = `${filePath}.backup-stage36a-${label}-${Date.now()}`;
  fs.copyFileSync(filePath, backupPath);
  console.log("Backup created:", path.basename(backupPath));
}

backup(packagePath, "package");
backup(serverPath, "server");
backup(checkoutPath, "checkout");

const pkg = JSON.parse(fs.readFileSync(packagePath, "utf8"));
pkg.scripts = pkg.scripts || {};
pkg.scripts["stage36a:check"] = "node scripts/check-stage36a-self-pickup.js";
fs.writeFileSync(packagePath, JSON.stringify(pkg, null, 2), "utf8");

const scriptsDir = path.join(root, "scripts");
if (!fs.existsSync(scriptsDir)) fs.mkdirSync(scriptsDir);

fs.writeFileSync(path.join(scriptsDir, "check-stage36a-self-pickup.js"), `const fs = require("fs");
const path = require("path");
const root = process.cwd();
console.log("SokoYetu Stage 36A Self-Pickup Checkout Check");
console.log("---------------------------------------------");
let warnings = 0;
function checkFile(file, items) {
  const fp = path.join(root, file);
  if (!fs.existsSync(fp)) { console.log("WARN:", file, "is missing."); warnings++; return; }
  const text = fs.readFileSync(fp, "utf8");
  for (const item of items) {
    if (!text.includes(item)) { console.log("WARN:", file, "missing:", item); warnings++; }
    else console.log("OK:", file, "includes", item);
  }
}
checkFile("checkout.html", ["Self-pickup", "deliveryMethod", "SELF_PICKUP", "Pickup is free", "calculateDeliveryFee"]);
checkFile("server.js", ["SokoYetu Stage 36A: Self-pickup checkout support", "isSelfPickup", "finalDeliveryAddress", "SELF PICKUP", "deliveryFee = isSelfPickup ? 0"]);
console.log("");
console.log("Warnings:", warnings);
if (warnings === 0) console.log("Stage 36A self-pickup checkout check passed.");
`, "utf8");

const checkoutHtml = `<!doctype html>

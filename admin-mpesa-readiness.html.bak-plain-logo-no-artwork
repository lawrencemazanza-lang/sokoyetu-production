<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="googlebot" content="noindex,nofollow,noarchive">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Mtaani Production M-PESA Readiness</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#111827,#16a34a);color:#fff;padding:24px}
    header .wrap,main{width:min(1220px,94vw);margin:0 auto}
    h1{margin:0;font-size:28px}
    header p{margin:7px 0 0;color:#dcfce7;line-height:1.5}
    main{display:grid;gap:16px;padding:20px 0 36px}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:22px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:15px 18px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:16px;display:grid;gap:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
    label{font-weight:900;color:#064e3b}
    input{width:100%;border:1px solid #bbf7d0;border-radius:14px;padding:11px;font:inherit}
    button,.linkbtn{border:none;border-radius:14px;background:#16a34a;color:#fff;padding:11px 14px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:fit-content}
    .linkbtn{background:#064e3b}
    .secondary{background:#111827}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px;line-height:1.5}
    .err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    .ok{background:#ecfdf5;border:1px solid #86efac;color:#047857;border-radius:16px;padding:12px;line-height:1.5}
    .warnBox{background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:16px;padding:12px;line-height:1.5}
    .badBox{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    .metric{border:1px solid #e5e7eb;border-radius:18px;padding:14px;background:#f8fafc}
    .metric b{display:block;font-size:22px;color:#064e3b;margin-top:4px;word-break:break-word}
    .pill{display:inline-flex;border-radius:999px;padding:5px 9px;font-weight:900;font-size:12px;margin:2px;background:#dcfce7;color:#166534}
    .warn{background:#fef3c7;color:#92400e}
    .bad{background:#fee2e2;color:#991b1b}
    table{width:100%;border-collapse:collapse;font-size:14px}
    th,td{border-bottom:1px solid #e5e7eb;padding:9px;text-align:left;vertical-align:top}
    th{background:#f1f5f9}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    @media(max-width:760px){table{display:block;overflow-x:auto;white-space:nowrap}.grid{grid-template-columns:1fr}}
  </style>
  <link rel="stylesheet" href="/sokoyetu-final-brand.css">
  <link rel="stylesheet" href="/sokoyetu-search-logo-refine.css">
</head>
<body>
<header>
  <div class="wrap">
    <h1>SokoYetu Mtaani Production M-PESA Readiness</h1>
    <p>Read-only readiness checklist for Safaricom Daraja production credentials, callback configuration and safe production switch planning.</p>
  </div>
</header>

<main>
  <div class="actions">
    <a class="linkbtn" href="/admin-control.html">← Back to admin control</a>
    <a class="linkbtn secondary" href="/admin-launch.html">Launch readiness</a>
    <a class="linkbtn secondary" href="/admin-system-health.html">System health</a>
  </div>

  <section class="card">
    <div class="head">Access</div>
    <div class="body">
      <div class="grid">
        <div>
          <label>Admin order token</label>
          <input id="token" type="password" placeholder="Paste ADMIN_ORDER_TOKEN">
        </div>
      </div>
      <button id="loadBtn" type="button">Load M-PESA readiness</button>
      <div class="warnBox">This page does not switch M-PESA to production. It only checks readiness and shows the safe switch plan.</div>
      <div id="message"></div>
    </div>
  </section>

  <section id="resultCard" class="card" style="display:none">
    <div class="head">Readiness summary</div>
    <div class="body" id="result"></div>
  </section>

  <section class="card">
    <div class="head">Production switch plan</div>
    <div class="body">
      <table>
        <thead><tr><th>Step</th><th>Action</th><th>Do not proceed unless</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Keep current sandbox/live-test checkout unchanged.</td><td>Production Daraja credentials are not yet issued.</td></tr>
          <tr><td>2</td><td>Confirm Safaricom production app approval.</td><td>You can see the production app/credentials in Daraja.</td></tr>
          <tr><td>3</td><td>Confirm live PayBill/Till/shortcode and passkey.</td><td>The shortcode belongs to the SokoYetu Mtaani business/payment account.</td></tr>
          <tr><td>4</td><td>Confirm callback URL on Render.</td><td>The URL is HTTPS and points to www.SokoYetu Mtaani.co.ke.</td></tr>
          <tr><td>5</td><td>Add production variables in Render, not in public code.</td><td>Secrets are not committed to GitHub.</td></tr>
          <tr><td>6</td><td>Deploy and run one very small real test payment.</td><td>Admin can verify the M-PESA receipt and order status.</td></tr>
          <tr><td>7</td><td>Monitor orders, support queue and Render logs.</td><td>No payment callback/order update errors appear.</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</main>

<script>
function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
function pill(kind, text){
  const cls = kind === "ok" ? "pill" : kind === "bad" ? "pill bad" : "pill warn";
  return '<span class="' + cls + '">' + esc(text) + '</span>';
}
async function loadReadiness(){
  if (!token()) {
    msg('<div class="err">Admin order token is required.</div>');
    return;
  }
  msg('<div class="note">Loading M-PESA readiness...</div>');
  try {
    const response = await fetch("/api/admin/mpesa-production-readiness", {
      headers: {"x-admin-order-token": token()},
      credentials: "include",
      cache: "no-store"
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.message || "Could not load readiness data.");
    render(data);
    msg('<div class="ok">M-PESA readiness loaded.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not load readiness data.") + '</div>');
  }
}
function render(data){
  const result = document.getElementById("result");
  const blockers = data.blockers || [];
  const warnings = data.warnings || [];
  const checks = data.checks || [];
  const env = data.environment || {};
  const recent = data.recentPayments || [];

  const statusBox = blockers.length
    ? '<div class="badBox"><b>Not ready for production switch.</b><br>' + blockers.map(b => "• " + esc(b)).join("<br>") + '</div>'
    : '<div class="ok"><b>Readiness checks have no blocking item.</b><br>Proceed only after manual Safaricom production approval and a controlled small real payment test.</div>';

  const warningBox = warnings.length
    ? '<div class="warnBox"><b>Warnings</b><br>' + warnings.map(w => "• " + esc(w)).join("<br>") + '</div>'
    : '<div class="ok"><b>No warnings returned by readiness endpoint.</b></div>';

  result.innerHTML =
    statusBox +
    warningBox +
    '<div class="grid">' +
      '<div class="metric">M-PESA Environment<b>' + esc(env.mpesaEnv || "-") + '</b></div>' +
      '<div class="metric">M-PESA Mode<b>' + esc(env.mpesaMode || "-") + '</b></div>' +
      '<div class="metric">Callback URL<b>' + esc(env.callbackUrl || "not set") + '</b></div>' +
      '<div class="metric">Recent payments checked<b>' + esc(recent.length) + '</b></div>' +
    '</div>' +
    '<div><b>Configuration checks</b><table><thead><tr><th>Item</th><th>Status</th><th>Value</th><th>Note</th></tr></thead><tbody>' +
      checks.map(c => '<tr><td>' + esc(c.label) + '</td><td>' + pill(c.ok ? "ok" : "bad", c.ok ? "OK" : "MISSING") + '</td><td>' + esc(c.value || "-") + '</td><td>' + esc(c.note || "") + '</td></tr>').join("") +
    '</tbody></table></div>' +
    '<div><b>Recent payment records</b><table><thead><tr><th>ID</th><th>Order</th><th>Amount</th><th>Status</th><th>Receipt</th><th>Created</th></tr></thead><tbody>' +
      (recent.length ? recent.map(p => '<tr><td>' + esc(p.id) + '</td><td>' + esc(p.orderId || "-") + '</td><td>KES ' + Number(p.amount || 0).toLocaleString("en-KE") + '</td><td>' + esc(p.status || "-") + '</td><td>' + esc(p.mpesaReceipt || "-") + '</td><td>' + esc(p.createdAt ? new Date(p.createdAt).toLocaleString() : "-") + '</td></tr>').join("") : '<tr><td colspan="6">No recent payments found.</td></tr>') +
    '</tbody></table></div>';
  document.getElementById("resultCard").style.display = "block";
}
document.getElementById("loadBtn").onclick = loadReadiness;
</script>
  <script src="/sokoyetu-final-seo.js" defer></script>
  <script src="/sokoyetu-search-logo-refine.js" defer></script>
</body>
</html>






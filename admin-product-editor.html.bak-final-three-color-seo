<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="googlebot" content="noindex,nofollow,noarchive">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Mtaani Admin Product Editor</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8fafc;color:#111827}
    header{background:linear-gradient(135deg,#111827,#16a34a);color:#fff;padding:24px}
    header .wrap,main{width:min(1240px,94vw);margin:0 auto}
    h1{margin:0;font-size:28px}
    header p{margin:7px 0 0;color:#dcfce7;line-height:1.5}
    main{display:grid;gap:16px;padding:20px 0 36px}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:22px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:15px 18px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:16px;display:grid;gap:12px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
    label{font-weight:900;color:#064e3b}
    input,select,textarea{width:100%;border:1px solid #bbf7d0;border-radius:14px;padding:11px;font:inherit}
    textarea{min-height:92px;resize:vertical}
    button,.linkbtn{border:none;border-radius:14px;background:#16a34a;color:#fff;padding:11px 14px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;width:fit-content}
    button.secondary{background:#111827}
    .linkbtn{background:#064e3b}
    .note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:16px;padding:12px;line-height:1.5}
    .err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:16px;padding:12px;line-height:1.5}
    .ok{background:#ecfdf5;border:1px solid #86efac;color:#047857;border-radius:16px;padding:12px;line-height:1.5}
    .warnBox{background:#fffbeb;border:1px solid #fde68a;color:#92400e;border-radius:16px;padding:12px;line-height:1.5}
    .products{display:grid;gap:14px}
    .product{border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;background:#fff}
    .productTop{display:grid;grid-template-columns:82px 1fr auto;gap:12px;padding:14px;background:#f8fafc;border-bottom:1px solid #e5e7eb;align-items:center}
    .thumb{width:82px;height:82px;border-radius:16px;background:#e5e7eb;object-fit:cover;border:1px solid #d1d5db}
    .productBody{padding:14px;display:grid;gap:12px}
    .title{font-weight:900}
    .muted{color:#64748b;font-size:13px}
    .pill{display:inline-flex;border-radius:999px;padding:5px 9px;font-weight:900;font-size:12px;margin:2px;background:#dcfce7;color:#166534}
    .warn{background:#fef3c7;color:#92400e}
    .bad{background:#fee2e2;color:#991b1b}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    @media(max-width:800px){.productTop{grid-template-columns:1fr}.thumb{width:100%;height:180px}.grid{grid-template-columns:1fr}}
  </style>
  <link rel="stylesheet" href="/sokoyetu-clean-brand.css">
</head>
<body>
<header>
  <div class="wrap">
    <h1>SokoYetu Mtaani Admin Product Editor</h1>
    <p>Correct product names, descriptions, categories, prices, stock and image URLs after catalogue audit.</p>
  </div>
</header>

<main>
  <a class="linkbtn" href="/admin-control.html">← Back to admin control</a>

  <section class="card">
    <div class="head">Access and product search</div>
    <div class="body">
      <div class="grid">
        <div>
          <label>Admin order token</label>
          <input id="token" type="password" placeholder="Paste ADMIN_ORDER_TOKEN">
        </div>
        <div>
          <label>Search</label>
          <input id="searchBox" placeholder="Product ID, name, category, seller ID">
        </div>
        <div>
          <label>Filter</label>
          <select id="filter">
            <option value="">All products</option>
            <option value="missing-image">Missing image</option>
            <option value="out-of-stock">Out of stock</option>
            <option value="weak-description">Weak description</option>
            <option value="missing-category">Missing category</option>
          </select>
        </div>
      </div>
      <div class="actions">
        <button id="loadBtn" type="button">Load products</button>
        <a class="linkbtn" href="/admin-catalog-audit.html">Open catalogue audit</a>
      </div>
      <div class="warnBox">Only edit listings after checking the seller/product source. Do not use copied images or descriptions unless you have permission to use them.</div>
      <div id="message"></div>
    </div>
  </section>

  <section class="card">
    <div class="head">Editable products</div>
    <div class="body">
      <div id="summary" class="note">No products loaded yet.</div>
      <div id="products" class="products"></div>
    </div>
  </section>
</main>

<script>
let productList = [];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function msg(html){ document.getElementById("message").innerHTML = html; }
function token(){ return document.getElementById("token").value.trim(); }
async function api(url, options={}){
  const response = await fetch(url, {
    credentials: "include",
    headers: {"Content-Type":"application/json", "x-admin-order-token": token(), ...(options.headers || {})},
    ...options
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.message || "Request failed.");
  return data;
}
function buildUrl(){
  const params = new URLSearchParams();
  const q = document.getElementById("searchBox").value.trim();
  const filter = document.getElementById("filter").value;
  if (q) params.set("q", q);
  if (filter) params.set("filter", filter);
  return "/api/admin/products/manage" + (params.toString() ? "?" + params.toString() : "");
}
async function loadProducts(){
  if (!token()) {
    msg('<div class="err">Admin order token is required.</div>');
    return;
  }
  msg('<div class="note">Loading products...</div>');
  try {
    const data = await api(buildUrl());
    productList = data.products || [];
    renderProducts();
    msg('<div class="ok">Products loaded.</div>');
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not load products.") + '</div>');
  }
}
function renderProducts(){
  const wrap = document.getElementById("products");
  document.getElementById("summary").innerHTML = '<b>' + productList.length + '</b> product(s) loaded.';
  if (!productList.length) {
    wrap.innerHTML = '<div class="note">No products found.</div>';
    return;
  }

  wrap.innerHTML = productList.map(p => {
    const img = p.imageUrl
      ? '<img class="thumb" src="' + esc(p.imageUrl) + '" alt="' + esc(p.name || "Product") + '">'
      : '<div class="thumb" style="display:grid;place-items:center;color:#64748b;font-weight:900">No image</div>';

    return '<article class="product">' +
      '<div class="productTop">' +
        img +
        '<div><div class="title">' + esc(p.name || "Unnamed product") + ' · Product #' + esc(p.id) + '</div><div class="muted">' + esc(p.category || "No category") + ' · Seller #' + esc(p.sellerId || "-") + ' · ' + money(p.price) + '</div></div>' +
        '<div><span class="pill">' + esc(p.stock ?? 0) + ' stock</span></div>' +
      '</div>' +
      '<div class="productBody">' +
        '<div class="grid">' +
          '<div><label>Name</label><input id="name-' + p.id + '" value="' + esc(p.name || "") + '"></div>' +
          '<div><label>Category</label><input id="category-' + p.id + '" value="' + esc(p.category || "") + '"></div>' +
          '<div><label>Price</label><input id="price-' + p.id + '" type="number" min="0" value="' + esc(p.price || 0) + '"></div>' +
          '<div><label>Old price</label><input id="oldPrice-' + p.id + '" type="number" min="0" value="' + esc(p.oldPrice || 0) + '"></div>' +
          '<div><label>Stock</label><input id="stock-' + p.id + '" type="number" min="0" value="' + esc(p.stock || 0) + '"></div>' +
          '<div><label>Image URL</label><input id="imageUrl-' + p.id + '" value="' + esc(p.imageUrl || "") + '" placeholder="https://..."></div>' +
        '</div>' +
        '<div><label>Description</label><textarea id="description-' + p.id + '">' + esc(p.description || "") + '</textarea></div>' +
        '<div class="actions"><button type="button" onclick="saveProduct(' + p.id + ')">Save product changes</button></div>' +
      '</div>' +
    '</article>';
  }).join("");
}
async function saveProduct(productId){
  const body = {
    name: document.getElementById("name-" + productId).value.trim(),
    description: document.getElementById("description-" + productId).value.trim(),
    category: document.getElementById("category-" + productId).value.trim(),
    price: document.getElementById("price-" + productId).value,
    oldPrice: document.getElementById("oldPrice-" + productId).value,
    stock: document.getElementById("stock-" + productId).value,
    imageUrl: document.getElementById("imageUrl-" + productId).value.trim()
  };

  try {
    msg('<div class="note">Saving product #' + productId + '...</div>');
    await api("/api/admin/products/" + productId + "/update", {
      method: "POST",
      body: JSON.stringify(body)
    });
    msg('<div class="ok">Product #' + productId + ' updated.</div>');
    await loadProducts();
  } catch (error) {
    msg('<div class="err">' + esc(error.message || "Could not update product.") + '</div>');
  }
}
document.getElementById("loadBtn").onclick = loadProducts;
window.saveProduct = saveProduct;
</script>
  <script src="/sokoyetu-clean-seo.js" defer></script>
</body>
</html>



<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SokoYetu Mtaani Checkout</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f5f7fb;color:#111827}
    header{background:linear-gradient(135deg,#052e16,#16a34a);color:#fff;padding:22px 18px}
    header .wrap,main{width:min(1120px,94vw);margin:0 auto}
    h1{margin:0;font-size:30px} header p{margin:7px 0 0;color:#dcfce7;line-height:1.45}
    main{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);gap:18px;padding:22px 0 46px}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:24px;box-shadow:0 18px 42px rgba(15,23,42,.08);overflow:hidden}
    .head{background:#ecfdf5;color:#064e3b;padding:15px 17px;font-weight:900;border-bottom:1px solid #bbf7d0}
    .body{padding:17px;display:grid;gap:14px}
    label{font-weight:900;color:#064e3b}
    input,textarea{width:100%;border:1px solid #bbf7d0;border-radius:15px;padding:12px;font:inherit;background:#fff}
    textarea{min-height:88px;resize:vertical}
    button,.linkbtn{border:0;border-radius:15px;background:#16a34a;color:#fff;padding:13px 16px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-flex;justify-content:center;align-items:center;gap:7px}
    button:disabled{opacity:.55}.secondary{background:#111827}.whatsapp{background:#128c7e}.outline{background:#fff;color:#064e3b;border:1px solid #bbf7d0}
    .actions{display:flex;gap:10px;flex-wrap:wrap}
    .row{display:grid;grid-template-columns:76px 1fr auto;gap:12px;align-items:center;border:1px solid #e5e7eb;border-radius:18px;padding:11px;background:#f8fafc}
    .row img{width:76px;height:76px;object-fit:cover;border-radius:15px;background:#e5e7eb}
    .title{font-weight:900;color:#064e3b}.meta{font-size:13px;color:#64748b;margin-top:4px}.price{font-weight:900}
    .summary{display:grid;gap:9px;border-top:1px solid #e5e7eb;margin-top:10px;padding-top:12px}
    .line{display:flex;justify-content:space-between;gap:12px}.line.total{font-size:20px;font-weight:900;color:#064e3b;border-top:1px solid #e5e7eb;padding-top:11px}
    .msg,.note,.warn,.err,.ok{border-radius:16px;padding:13px;line-height:1.5}.ok{background:#ecfdf5;border:1px solid #86efac;color:#047857}.err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.note{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534}.warn{background:#fffbeb;border:1px solid #fde68a;color:#92400e}
    .empty{padding:17px;border-radius:17px;background:#f8fafc;border:1px solid #e5e7eb;color:#64748b}
    .method-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .method{border:1px solid #bbf7d0;background:#f8fafc;border-radius:18px;padding:13px;cursor:pointer}
    .method input{width:auto}.method b{color:#064e3b;display:block;margin:6px 0}.method span{font-size:13px;color:#64748b}
    .method.active{background:#ecfdf5;border-color:#16a34a;box-shadow:0 0 0 3px rgba(22,163,74,.1)}
    .manual-box{border:1px solid #bbf7d0;background:linear-gradient(135deg,#ecfdf5,#fff);border-radius:20px;padding:15px;display:grid;gap:9px}
    .manual-box h3{margin:0;color:#064e3b}.big{font-size:24px;font-weight:900;color:#064e3b;letter-spacing:.04em}
    .steps{display:grid;gap:7px;color:#374151}.steps div{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:9px}
    @media(max-width:900px){main{grid-template-columns:1fr}.method-grid{grid-template-columns:1fr}.row{grid-template-columns:64px 1fr}.price{grid-column:2}h1{font-size:26px}}
  </style>
  <link rel="stylesheet" href="/sokoyetu-final-brand.css">
</head>
<body>
<header><div class="wrap"><h1>SokoYetu Mtaani Checkout</h1><p>Choose home delivery or self-pickup, then pay with M-PESA. If the automatic prompt is unavailable, manual M-PESA instructions will appear.</p></div></header>
<main>
  <section class="card">
    <div class="head">Checkout details</div>
    <div class="body">
      <form id="checkoutForm">
        <label for="phone">M-PESA phone number</label>
        <input id="phone" placeholder="0714565555 or 254714565555" autocomplete="tel">
        <label>Receiving option</label>
        <div class="method-grid">
          <label class="method active" id="methodDeliveryBox"><input type="radio" name="deliveryMethod" value="DELIVERY" checked><b>Home delivery</b><span>Delivery fee applies unless the order qualifies for free delivery.</span></label>
          <label class="method" id="methodPickupBox"><input type="radio" name="deliveryMethod" value="SELF_PICKUP"><b>Self-pickup</b><span>You collect the product yourself. Delivery fee is KES 0.</span></label>
        </div>
        <div id="deliveryAddressWrap"><label for="deliveryAddress">Delivery address</label><textarea id="deliveryAddress" placeholder="Example: Nairobi CBD, Moi Avenue, building name"></textarea></div>
        <div id="pickupNote" class="note" style="display:none">Self-pickup selected. Delivery fee is KES 0. SokoYetu Mtaani will confirm pickup details before product release.</div>
        <button id="payBtn" type="submit">Create order and continue to payment</button>
      </form>
      <div id="message"></div>
      <div id="manualPaymentBox"></div>
      <div class="actions">
        <a class="linkbtn outline" href="/">Continue shopping</a>
        <a class="linkbtn secondary" href="/track-order.html">Track order</a>
        <a class="linkbtn whatsapp" id="checkoutWhatsApp" target="_blank" rel="noopener">WhatsApp SokoYetu Mtaani</a>
      </div>
    </div>
  </section>
  <aside class="card"><div class="head">Cart summary</div><div class="body" id="cartBody"><div class="empty">Loading cart...</div></div></aside>
</main>
<script>
const WHATSAPP_NUMBER = "254714565555";
const MPESA_TILL = "6923522";
const cartBody = document.getElementById("cartBody");
const form = document.getElementById("checkoutForm");
const message = document.getElementById("message");
const manualPaymentBox = document.getElementById("manualPaymentBox");
const payBtn = document.getElementById("payBtn");
const deliveryAddressEl = document.getElementById("deliveryAddress");
const deliveryAddressWrap = document.getElementById("deliveryAddressWrap");
const pickupNote = document.getElementById("pickupNote");
const checkoutWhatsApp = document.getElementById("checkoutWhatsApp");
let latestCart = [];
let lastOrder = null;

function esc(value){return String(value ?? "").replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[m]));}
function money(value){return "KES " + Number(value || 0).toLocaleString("en-KE", {maximumFractionDigits:0});}
async function fetchJson(url, options = {}) {
  const response = await fetch(url, {credentials:"include", headers:{"Content-Type":"application/json", ...(options.headers || {})}, ...options});
  const text = await response.text();
  let data = {};
  try { data = text ? JSON.parse(text) : {}; } catch { throw new Error("Server returned an unexpected response. Please contact SokoYetu Mtaani on WhatsApp."); }
  if (!response.ok) throw new Error(data.message || "Request failed.");
  return data;
}
function normalizeCart(data){
  const raw = Array.isArray(data) ? data : Array.isArray(data.items) ? data.items : Array.isArray(data.cart) ? data.cart : Array.isArray(data.cartItems) ? data.cartItems : [];
  return raw.map(item => ({productId:item.productId || item.id || item.product?.id || "", name:item.name || item.title || item.product?.name || item.product?.title || "Product", imageUrl:item.imageUrl || item.image || item.product?.imageUrl || "", price:Number(item.price || item.product?.price || 0), quantity:Number(item.quantity || item.qty || 1)}));
}
function selectedMethod(){return document.querySelector("input[name='deliveryMethod']:checked")?.value || "DELIVERY";}
function isSelfPickup(){return selectedMethod() === "SELF_PICKUP";}
function subtotal(){return latestCart.reduce((sum, item) => sum + Number(item.price || 0) * Number(item.quantity || 1), 0);}
function deliveryFee(){const sub = subtotal(); return isSelfPickup() ? 0 : (sub >= 10000 || sub === 0 ? 0 : 300);}
function orderTotal(){return subtotal() + deliveryFee();}
function waUrl(text){return "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(text);}
function updateWhatsApp(order){checkoutWhatsApp.href = waUrl(order ? "Hello SokoYetu Mtaani, I need help with order #" + order.id + "." : "Hello SokoYetu Mtaani, I need help with my order.");}
function updateMethodUI(){
  document.getElementById("methodDeliveryBox").classList.toggle("active", !isSelfPickup());
  document.getElementById("methodPickupBox").classList.toggle("active", isSelfPickup());
  deliveryAddressWrap.style.display = isSelfPickup() ? "none" : "block";
  pickupNote.style.display = isSelfPickup() ? "block" : "none";
  renderCart();
}
function renderCart(){
  if (!latestCart.length) { cartBody.innerHTML = "<div class='empty'>Your cart is empty. Go back to the shop and add a product first.</div>"; payBtn.disabled = true; return; }
  payBtn.disabled = false;
  const rows = latestCart.map(item => "<article class='row'>" + (item.imageUrl ? "<img src='" + esc(item.imageUrl) + "' alt=''>" : "<img alt=''>") + "<div><div class='title'>" + esc(item.name) + "</div><div class='meta'>Quantity: " + esc(item.quantity) + " · Product ID: " + esc(item.productId) + "</div></div><div class='price'>" + money(item.price * item.quantity) + "</div></article>").join("");
  const fee = deliveryFee();
  const deliveryText = isSelfPickup() ? "Self-pickup - free" : fee === 0 ? "Free" : money(fee);
  cartBody.innerHTML = rows + "<div class='summary'><div class='line'><span>Subtotal</span><b>" + money(subtotal()) + "</b></div><div class='line'><span>Delivery</span><b>" + deliveryText + "</b></div><div class='line total'><span>Total</span><b>" + money(orderTotal()) + "</b></div></div><div class='note'>" + (isSelfPickup() ? "Self-pickup selected. You will not pay delivery fee." : "Free delivery applies above KES 10,000.") + "</div>";
}
async function loadCart(){
  try { latestCart = normalizeCart(await fetchJson("/api/cart")); renderCart(); }
  catch(error){ cartBody.innerHTML = "<div class='msg err'>" + esc(error.message) + "</div>"; payBtn.disabled = true; }
}
function manualPaymentHtml(order){
  const amount = Number(order?.totalAmount || orderTotal() || 0);
  const orderId = order?.id || "";
  const text = "Hello SokoYetu Mtaani, I have paid manually via M-PESA. Order #" + orderId + ", Amount " + money(amount) + ". My receipt code is: ";
  return "<div class='manual-box'><h3>Manual M-PESA payment</h3><div class='warn'>Automatic M-PESA prompt is not available right now. Use manual payment and send receipt for confirmation.</div><div class='steps'><div><b>1.</b> Go to M-PESA.</div><div><b>2.</b> Choose <b>Lipa na M-PESA</b>.</div><div><b>3.</b> Choose <b>Buy Goods and Services</b>.</div><div><b>4.</b> Enter Till Number:</div></div><div class='big'>" + MPESA_TILL + "</div><div class='steps'><div><b>5.</b> Enter amount: <b>" + money(amount) + "</b></div><div><b>6.</b> Use Order ID as reference: <b>#" + esc(orderId) + "</b></div><div><b>7.</b> Send receipt to SokoYetu Mtaani on WhatsApp.</div></div><div class='actions'><a class='linkbtn whatsapp' target='_blank' rel='noopener' href='" + waUrl(text) + "'>Send receipt on WhatsApp</a><a class='linkbtn secondary' href='/track-order.html'>Track order</a></div></div>";
}
function showManualPayment(order){ lastOrder = order; updateWhatsApp(order); manualPaymentBox.innerHTML = manualPaymentHtml(order); }
document.querySelectorAll("input[name='deliveryMethod']").forEach(input => input.addEventListener("change", updateMethodUI));
form.addEventListener("submit", async event => {
  event.preventDefault();
  const phone = document.getElementById("phone").value.trim();
  const deliveryMethod = selectedMethod();
  const deliveryAddress = deliveryAddressEl.value.trim();
  manualPaymentBox.innerHTML = "";
  if (!phone) { message.innerHTML = "<div class='msg err'>M-PESA phone number is required.</div>"; return; }
  if (deliveryMethod !== "SELF_PICKUP" && !deliveryAddress) { message.innerHTML = "<div class='msg err'>Delivery address is required for home delivery.</div>"; return; }
  try {
    payBtn.disabled = true;
    message.innerHTML = "<div class='msg ok'>Creating your order...</div>";
    const orderData = await fetchJson("/api/orders", {method:"POST", body:JSON.stringify({phone, deliveryMethod, fulfillmentMethod:deliveryMethod, deliveryAddress: deliveryMethod === "SELF_PICKUP" ? "SELF PICKUP" : deliveryAddress})});
    const order = orderData.order || orderData;
    if (!order.id) throw new Error("Order was created but no order ID was returned.");
    lastOrder = order; updateWhatsApp(order);
    message.innerHTML = "<div class='msg ok'><b>Order created.</b><br>Order ID: #" + esc(order.id) + "<br>Trying to send the M-PESA prompt now...</div>";
    try {
      const stkData = await fetchJson("/api/payments/mpesa/stk-push", {method:"POST", body:JSON.stringify({orderId: order.id, phone})});
      message.innerHTML = "<div class='msg ok'><b>M-PESA prompt sent.</b><br>Order ID: #" + esc(order.id) + "<br>Check the customer phone and enter the M-PESA PIN." + (stkData.checkoutRequestId ? "<br><small>Checkout Request ID: " + esc(stkData.checkoutRequestId) + "</small>" : "") + "</div>";
    } catch (stkError) {
      console.warn("Automatic M-PESA prompt unavailable:", stkError);
      message.innerHTML = "<div class='msg err'><b>Automatic M-PESA prompt is not available right now.</b><br>Your order was created. Use the manual M-PESA instructions below, then send the receipt on WhatsApp for confirmation.</div>";
      showManualPayment(order);
    }
  } catch (error) {
    console.error("Checkout error:", error);
    message.innerHTML = "<div class='msg err'><b>Order could not be completed.</b><br>Please check your cart and phone number, or contact SokoYetu Mtaani on WhatsApp.</div>";
  } finally { payBtn.disabled = false; }
});
updateWhatsApp(null); updateMethodUI(); loadCart();
</script>

<script>
// SokoYetu Mtaani Stage 37B checkout fallback: Manual M-PESA and WhatsApp support while Daraja is pending.
(function(){
  const WHATSAPP="254714565555";
  const TILL="6923522";
  function money(v){return "KES "+Number(v||0).toLocaleString("en-KE",{maximumFractionDigits:0})}
  function wa(text){return "https://wa.me/"+WHATSAPP+"?text="+encodeURIComponent(text)}
  function ensureManualBox(){
    let box=document.getElementById("soko37bManualMpesa");
    if(box)return box;
    box=document.createElement("div");
    box.id="soko37bManualMpesa";
    box.style.cssText="display:none;margin-top:12px;border:1px solid #bbf7d0;background:#ecfdf5;border-radius:18px;padding:14px;color:#064e3b;line-height:1.5";
    const host=document.getElementById("message")||document.body;
    host.insertAdjacentElement("afterend",box);
    return box;
  }
  function showManual(){
    const box=ensureManualBox();
    let totalText="the order amount shown above";
    const bodyText=document.body.innerText||"";
    const match=bodyText.match(/KES\s?[0-9,]+/);
    if(match) totalText=match[0];
    const msg="Hello SokoYetu Mtaani, I have paid manually via M-PESA. My receipt code is: ";
    box.innerHTML='<b>Manual M-PESA payment</b><br>Automatic M-PESA prompt is not available right now. Pay manually and send the receipt on WhatsApp for confirmation.<br><br><b>Steps:</b><br>1. Go to M-PESA.<br>2. Choose <b>Lipa na M-PESA</b>.<br>3. Choose <b>Buy Goods and Services</b>.<br>4. Enter Till Number: <b style="font-size:22px">'+TILL+'</b><br>5. Enter amount: <b>'+totalText+'</b><br>6. Send the receipt to SokoYetu Mtaani.<br><br><a style="display:inline-flex;background:#128c7e;color:white;text-decoration:none;border-radius:12px;padding:10px 12px;font-weight:900" target="_blank" rel="noopener" href="'+wa(msg)+'">Send receipt on WhatsApp</a>';
    box.style.display="block";
  }
  function scan(){
    const text=(document.getElementById("message")?.innerText||"").toLowerCase();
    if(text.includes("automatic m-pesa prompt")||text.includes("checkout could not continue")||text.includes("m-pesa stk push")||text.includes("daraja"))showManual();
  }
  const msg=document.getElementById("message");
  if(msg)new MutationObserver(scan).observe(msg,{childList:true,subtree:true,characterData:true});
  setInterval(scan,1500);
})();
</script>
  <script src="/sokoyetu-final-seo.js" defer></script>
</body>
</html>




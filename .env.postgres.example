# SokoYetu PostgreSQL environment example

PORT=5173
JWT_SECRET="change_this_to_a_long_random_secret_before_launch"

# Local PostgreSQL example:
# Replace YOUR_POSTGRES_PASSWORD with your real PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/sokoyetu?schema=public"

# M-PESA demo mode remains safe for local testing.
MPESA_MODE="demo"
MPESA_ENV="sandbox"
MPESA_SHORTCODE="174379"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:5173/api/payments/mpesa/callback"

UPLOAD_MODE="local"

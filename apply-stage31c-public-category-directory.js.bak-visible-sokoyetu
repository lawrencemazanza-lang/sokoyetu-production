const fs = require("fs");
const path = require("path");

const root = process.cwd();
const packagePath = path.join(root, "package.json");
const indexPath = path.join(root, "index.html");
const sitemapPath = path.join(root, "sitemap.xml");

if (!fs.existsSync(packagePath)) {
  console.error("ERROR: package.json was not found. Run this inside your SokoYetu project folder.");
  process.exit(1);
}

function backup(filePath, label) {
  if (!fs.existsSync(filePath)) return;
  const backupPath = `${filePath}.backup-stage31c-${label}-${Date.now()}`;
  fs.copyFileSync(filePath, backupPath);
  console.log("Backup created:", path.basename(backupPath));
}

backup(packagePath, "package");
backup(indexPath, "index");
backup(sitemapPath, "sitemap");

const pkg = JSON.parse(fs.readFileSync(packagePath, "utf8"));
pkg.scripts = pkg.scripts || {};
pkg.scripts["stage31c:check"] = "node scripts/check-stage31c-categories.js";
fs.writeFileSync(packagePath, JSON.stringify(pkg, null, 2), "utf8");

const scriptsDir = path.join(root, "scripts");
if (!fs.existsSync(scriptsDir)) fs.mkdirSync(scriptsDir);


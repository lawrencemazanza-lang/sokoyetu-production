<script>
let allProducts = [];

function esc(value){
  return String(value ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function money(value){ return "KES " + Number(value || 0).toLocaleString("en-KE"); }
function norm(value){ return String(value || "").trim() || "Other"; }

async function loadProducts(){
  const message = document.getElementById("message");
  try {
    const res = await fetch("/api/products", { credentials: "include" });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.message || "Could not load products.");

    const raw = Array.isArray(data) ? data : (data.products || data.data || []);
    allProducts = raw.map(p => ({
      id: p.id,
      name: p.name || p.title || "Unnamed product",
      description: p.description || "",
      category: norm(p.category),
      price: p.price || 0,
      oldPrice: p.oldPrice || 0,
      stock: p.stock ?? null,
      imageUrl: p.imageUrl || p.image || p.photoUrl || ""
    }));

    populateCategoryFilter();
    renderCategories();
    renderProducts();
    message.className = "note";
    message.textContent = allProducts.length ? "Products loaded successfully." : "No products are available yet.";
  } catch (error) {
    message.className = "err";
    message.textContent = error.message || "Could not load products.";
  }
}

function grouped(){
  const map = new Map();
  for (const p of allProducts) {
    const key = norm(p.category);
    if (!map.has(key)) map.set(key, []);
    map.get(key).push(p);
  }
  return Array.from(map.entries()).sort((a,b) => a[0].localeCompare(b[0]));
}

function populateCategoryFilter(){
  const select = document.getElementById("categoryFilter");
  const current = select.value;
  const options = grouped().map(([cat, items]) => '<option value="' + esc(cat) + '">' + esc(cat) + ' (' + items.length + ')</option>').join("");
  select.innerHTML = '<option value="">All categories</option>' + options;
  select.value = current;
}

function renderCategories(){
  const wrap = document.getElementById("categories");
  const groups = grouped();

  if (!groups.length) {
    wrap.innerHTML = '<div class="note">No categories found yet.</div>';
    return;
  }

  wrap.innerHTML = groups.map(([cat, items]) => {
    const available = items.filter(p => p.stock === null || Number(p.stock) > 0).length;
    return '<div class="category" onclick="selectCategory(\\'' + esc(cat).replace(/'/g,"&#39;") + '\\')">' +
      '<b>' + esc(cat) + '</b>' +
      '<span>' + items.length + ' product(s), ' + available + ' available.</span>' +
      '<em class="pill">Browse category</em>' +
    '</div>';
  }).join("");
}

function currentFilteredProducts(){
  const q = document.getElementById("searchBox").value.trim().toLowerCase();
  const cat = document.getElementById("categoryFilter").value;
  return allProducts.filter(p => {
    const matchesQ = !q || (p.name + " " + p.category + " " + p.description).toLowerCase().includes(q);
    const matchesCat = !cat || p.category === cat;
    return matchesQ && matchesCat;
  });
}

function renderProducts(){
  const wrap = document.getElementById("products");
  const list = currentFilteredProducts();

  if (!list.length) {
    wrap.innerHTML = '<div class="note">No products match this filter.</div>';
    return;
  }

  wrap.innerHTML = list.map(p => {
    const img = p.imageUrl
      ? '<img src="' + esc(p.imageUrl) + '" alt="' + esc(p.name) + '">'
      : '<div class="noimg">No image</div>';

    const stockText = p.stock === null ? "Stock not shown" : (Number(p.stock) > 0 ? p.stock + " in stock" : "Out of stock");
    const stockClass = p.stock !== null && Number(p.stock) <= 0 ? "pill warn" : "pill";

    return '<article class="product">' +
      img +
      '<div class="pbody">' +
        '<b>' + esc(p.name) + '</b>' +
        '<span class="muted">' + esc(p.category) + '</span>' +
        '<span class="price">' + money(p.price) + '</span>' +
        '<span class="' + stockClass + '">' + esc(stockText) + '</span>' +
        '<span class="muted">' + esc((p.description || "").slice(0, 100)) + (p.description && p.description.length > 100 ? "..." : "") + '</span>' +
        '<a class="linkbtn" href="/#products">View in shop</a>' +
      '</div>' +
    '</article>';
  }).join("");
}

function selectCategory(cat){
  document.getElementById("categoryFilter").value = cat;
  renderProducts();
  document.getElementById("products").scrollIntoView({ behavior: "smooth", block: "start" });
}

document.getElementById("applyBtn").onclick = renderProducts;
document.getElementById("searchBox").addEventListener("input", renderProducts);
document.getElementById("categoryFilter").addEventListener("change", renderProducts);
window.selectCategory = selectCategory;

loadProducts();
</script>
</body>
</html>`, "utf8");

fs.writeFileSync(path.join(scriptsDir, "check-stage31c-categories.js"), `const fs = require("fs");
const path = require("path");

const root = process.cwd();

console.log("SokoYetu Stage 31C Public Category Directory Check");
console.log("-------------------------------------------------");

let warnings = 0;

const categoriesPath = path.join(root, "categories.html");
if (!fs.existsSync(categoriesPath)) {
  console.log("WARN: categories.html is missing.");
  warnings += 1;
} else {
  const html = fs.readFileSync(categoriesPath, "utf8");
  const required = ["/api/products", "categoryFilter", "searchBox", "Browse SokoYetu Categories"];
  for (const item of required) {
    if (!html.includes(item)) {
      console.log("WARN: categories.html missing:", item);
      warnings += 1;
    } else {
      console.log("OK: categories.html includes", item);
    }
  }
}

const sitemapPath = path.join(root, "sitemap.xml");
if (fs.existsSync(sitemapPath)) {
  const sitemap = fs.readFileSync(sitemapPath, "utf8");
  if (!sitemap.includes("/categories.html")) {
    console.log("WARN: sitemap.xml does not include categories.html.");
    warnings += 1;
  } else {
    console.log("OK: sitemap.xml includes categories.html.");
  }
} else {
  console.log("WARN: sitemap.xml is missing.");
  warnings += 1;
}

console.log("");
console.log("Warnings:", warnings);
if (warnings === 0) console.log("Stage 31C category directory check passed.");
`, "utf8");

// Update sitemap.
let sitemap = fs.existsSync(sitemapPath)
  ? fs.readFileSync(sitemapPath, "utf8")
  : `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n  <url>\n    <loc>https://www.mysokoyetu.co.ke/</loc>\n  </url>\n</urlset>\n`;

if (!sitemap.includes("/categories.html")) {
  const block = `\n  <url>\n    <loc>https://www.mysokoyetu.co.ke/categories.html</loc>\n  </url>\n`;
  if (sitemap.includes("</urlset>")) sitemap = sitemap.replace("</urlset>", block + "</urlset>");
  else sitemap += block;
  fs.writeFileSync(sitemapPath, sitemap, "utf8");
  console.log("Added categories.html to sitemap.xml.");
} else {
  console.log("sitemap.xml already includes categories.html.");
}

// Add homepage link safely as floating/section block if index exists.
if (fs.existsSync(indexPath)) {

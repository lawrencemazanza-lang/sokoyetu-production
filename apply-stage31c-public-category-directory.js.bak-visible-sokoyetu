<!-- End SokoYetu Stage 31C -->
`;
    if (index.includes("</body>")) index = index.replace("</body>", block + "\n</body>");
    else index += block;
    fs.writeFileSync(indexPath, index, "utf8");
    console.log("Added categories link to index.html.");

if (!server.includes("SokoYetu Stage 22: Bulk Product Import API")) {
  const endpoint = `

// ================================
// SokoYetu Stage 22: Bulk Product Import API
// Protected by BULK_IMPORT_TOKEN. Admin must verify listings before import.
// ================================
app.post("/api/admin/products/bulk-import", async (req, res) => {
  try {
    const configuredToken = process.env.BULK_IMPORT_TOKEN;
    const providedToken = req.headers["x-import-token"];

    if (!configuredToken) {
      return res.status(500).json({ message: "BULK_IMPORT_TOKEN is not configured on the server." });
    }

    if (!providedToken || providedToken !== configuredToken) {
      return res.status(403).json({ message: "Invalid bulk import token." });
    }

    const products = Array.isArray(req.body?.products) ? req.body.products : [];

    if (!products.length) {
      return res.status(400).json({ message: "No products were provided for import." });
    }

    let created = 0;
    let updated = 0;
    let skipped = 0;
    const results = [];

    for (const raw of products) {
      const name = String(raw.name || "").trim();
      const description = String(raw.description || "").trim();
      const category = String(raw.category || "General").trim();
      const price = Number(raw.price || 0);
      const oldPrice = raw.oldPrice === "" || raw.oldPrice === null || raw.oldPrice === undefined ? null : Number(raw.oldPrice);
      const stock = Number(raw.stock || 0);
      const imageUrl = String(raw.imageUrl || "").trim();

      if (!name || !category || !price || price <= 0 || stock < 0) {
        skipped += 1;
        results.push({ name, status: "skipped", reason: "Missing required product fields." });
        continue;
      }

      const data = {
        name,
        description: description || \`\${name} listed under \${category}. Product details should be verified by admin before public promotion.\`,
        category,
        price,
        oldPrice,
        stock,
        imageUrl,
        importedByAdmin: true,
      };

      const existing = await prisma.product.findFirst({ where: { name } });

      if (existing) {
        await prisma.product.update({ where: { id: existing.id }, data });
        updated += 1;
        results.push({ name, status: "updated", id: existing.id });
      } else {
        const product = await prisma.product.create({ data });
        created += 1;
        results.push({ name, status: "created", id: product.id });
      }
    }

    return res.json({ message: "Bulk product import completed.", created, updated, skipped, results });
  } catch (error) {
    console.error("Bulk product import error:", error);
    return res.status(500).json({ message: "Bulk product import failed.", details: error.message });
  }
});
`;
  const insertIndex = Math.max(server.lastIndexOf("app.listen"), server.lastIndexOf("server.listen"));
  if (insertIndex !== -1) server = server.slice(0, insertIndex) + endpoint + "\n" + server.slice(insertIndex);
  else server += endpoint;
